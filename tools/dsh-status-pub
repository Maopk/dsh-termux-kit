#!/data/data/com.termux/files/usr/bin/python3
"""dsh-status-pub —— publish the current status as a file for an external App (the future console APK) to read.

Why: the console APK and Termux are **different UIDs**, so it cannot read the logs in ~/.smoke or any private file.
So the status is written into **shared storage** (Download/dsh/状态/) and the APK reads that file to show its status lamps.

Output:
  Download/dsh/状态/status.json   machine-readable (used by the APK)
  Download/dsh/状态/status.txt    human-readable (for you, via a file manager or editor)

Contents: DSH(port+HTTP code) / bridge(port+version+answering) / adb(connected devices) / last run result and time per component /
      whether boot and credential locks are left over / generation time.

Usage: 
  dsh-status-pub            # publish once (whole run has a hard 6s budget; anything that misses it is marked partial)
  dsh-status-pub --quiet    # print nothing (for components calling it at the end)
  dsh-status-pub --print    # print only, write no file
  dsh-status-pub --budget 3 # set the whole-run budget in seconds; the console waits 25s, so the default 6s is plenty
"""
import json
import os
import re
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser('~')
OUTDIR = os.path.join(HOME, 'storage', 'shared', 'Download', 'dsh', '状态')
JSON_PATH = os.path.join(OUTDIR, 'status.json')
TXT_PATH = os.path.join(OUTDIR, 'status.txt')
TASK_DIR = os.path.join(HOME, '.shortcuts', 'tasks')
LOG_DIR = os.path.join(HOME, '.smoke')
DANGEROUS = {'2_shutdown-dsh', '4_soft-restart-dsh', '6_hard-restart-dsh', '0_emergency-stop'}

# ── 桥的状态：**只在这里判定一次**（2026-09-27）──
# 为什么：这个文件同时喂三个消费者（控制台 App / 页面面板 / 小组件）。以前灯色由这里按
# port+ok 算，而"桥：运行中/刚断/未响应/未安装"那行文字由 App 自己拿 bridge.state 算 ——
# 可这里从来不写 state，于是 App 永远显示"桥：未知"，而灯是绿的。屏幕上就成了
# 「绿灯 + 桥：未知」（用户 2026-09-27 实测抓到）。现在：state 在这里算一次，
# lamps.bridge 由 state 推出来，谁都不许再自己算第二遍。
BRIDGE_NOTE = os.path.join(HOME, '.dsh-bridge-state')   # dsh-bridge 写的状态记录：soft/full/running + 时间戳
LAMP_OF_STATE = {
    'running': 'green',    # 在听且真应答
    'frozen':  'yellow',   # 端口在听却不应答（多半被系统冻住）
    'soft':    'grey',     # 软停：进程还在，一条广播就能拉回
    'silent':  'grey',     # 真停
    'never':   'grey',     # 这台机器上从没见过它是活的
}


def bridge_note():
    """dsh-bridge 的状态记录（只是记录，不是真相）：'soft' / 'full' / 'running' / 'none'。"""
    try:
        with open(BRIDGE_NOTE, encoding='utf-8') as f:
            return (f.read().split() or ['none'])[0]
    except Exception:
        return 'none'


def bridge_state(port, ok, note):
    """桥的五态，唯一判定处（不看计时器，只看一次 ping + 状态记录）。"""
    if port:
        return 'running' if ok else 'frozen'
    if note in (None, '', 'none'):
        return 'never'
    return 'soft' if note in ('soft', 'running') else 'silent'


# ── global time budget (added 2026-09-27)──
# Why: the console APK refresh-status waits only 25 seconds, while every step here carries its own timeout
# (bridge ping 14s + adb 12s + curl 8s…), which in the worst case adds up past 30s → the App times out first,
# which shows on the phone as "refresh does nothing". Now the whole run has a hard budget (6s by default) and each step may only use what is left.
DEADLINE = None
BUDGET_S = 6.0


def budget(default):
    if DEADLINE is None:
        return default
    return max(0.3, min(float(default), DEADLINE - time.time()))


def out_of_time():
    return DEADLINE is not None and time.time() >= DEADLINE


def sh(args, timeout=12):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ''


def port_open(p, timeout=1.2):
    s = socket.socket()
    s.settimeout(timeout)
    try:
        s.connect(('127.0.0.1', int(p)))
        return True
    except Exception:
        return False
    finally:
        try:
            s.close()
        except Exception:
            pass


def tasks_state():
    out = {}
    try:
        # Only canonical task names (e.g. 5_cleanup-dsh). The Chinese-named forwarder scripts that
        # keep old home-screen shortcuts alive are NOT tasks, and used to double every list to 21 entries.
        _CANON = re.compile(r'^[0-9]{1,2}_[a-z0-9-]+$')
        names = sorted(n[:-3] for n in os.listdir(TASK_DIR)
                       if n.endswith('.sh') and _CANON.match(n[:-3]))
    except Exception:
        names = []
    brief = '--brief' in sys.argv     # for the console APK: skip the per-task tail (those 12 lines are most of the payload)
    for n in names:
        p = os.path.join(LOG_DIR, 'widget-%s.log' % n)
        item = {'label': n.split('_', 1)[-1].replace('DSH', ' DSH').strip(),
                'danger': n in DANGEROUS, 'last': None, 'at': None, 'tail': ''}
        if os.path.exists(p):
            try:
                with open(p, 'rb') as f:
                    f.seek(max(0, os.path.getsize(p) - 4000))
                    tail = f.read().decode('utf-8', 'replace')
                res = _TERM = re.compile(r'(?:\[(?P<n1>[^\]]{1,60})\]\s*(?P<s1>done|failed|skipped|not executed)\b|【(?P<n2>[^】]{1,60})】\s*(?P<s2>完成|失败|未执行))')
                _NORM = {'完成': 'done', '失败': 'failed', '未执行': 'skipped', 'not executed': 'skipped'}
                res = [_NORM.get(m.group('s2') or m.group('s1'), m.group('s1')) for m in _TERM.finditer(tail)]
                stamps = re.findall(r'^===== ([\d\-]+ [\d:]+)', tail, re.M)
                item['last'] = res[-1] if res else None
                item['at'] = stamps[-1] if stamps else None
                if not brief:
                    item['tail'] = '\n'.join(tail.strip().splitlines()[-12:])
            except Exception:
                pass
        out[n] = item
    return out


# Where is DSH? Never guess the port: ~/.dsh-url records it (see tools/dsh_common.py for why
# hard-coding 8080 made both detectors report "not running" while DSH ran on 8099).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import dsh_common  # noqa: E402


def collect():
    global DEADLINE
    DEADLINE = time.time() + BUDGET_S
    st = {'ts': time.strftime('%F %T'), 'epoch': int(time.time()), 'budget_s': BUDGET_S}
    # DSH Web
    _dsh_port = dsh_common.dsh_port()
    dsh = {'port': port_open(_dsh_port)}
    mt = int(max(1, budget(4)))
    code = sh(['curl', '-s', '-o', '/dev/null', '-w', '%{http_code}', '--max-time', str(mt),
               'http://127.0.0.1:%d/' % _dsh_port], timeout=budget(6))
    dsh['http'] = code or '?'
    dsh['ok'] = dsh['port'] and code not in ('', '000', '404')
    st['dsh'] = dsh
    # bridge
    br = {'port': port_open(8788), 'ok': False, 'ver': None, 'paused': None}
    if br['port']:
        # --fast: a single connection that returns at once on failure or freeze, skipping the "broadcast + raise UI" wake ladder (which takes up to 14s)
        pong = sh([os.path.join(HOME, '.local/bin/droid-sock'), 'ping', '--fast'], timeout=budget(4))
        br['ok'] = '"pong": true' in pong
        m = re.search(r'"ver":\s*"([^"]+)"', pong)
        br['ver'] = m.group(1) if m else None
        m2 = re.search(r'"paused":\s*(true|false)', pong)
        br['paused'] = (m2.group(1) == 'true') if m2 else None
    br['note'] = bridge_note()
    br['state'] = bridge_state(br['port'], br['ok'], br['note'])
    st['bridge'] = br
    # adb
    devs = []
    out = sh(['adb', 'devices'], timeout=budget(3))
    for line in out.splitlines()[1:]:
        if '\tdevice' in line:
            devs.append(line.split('\t')[0])
    st['adb'] = {'devices': devs, 'ok': bool(devs)}
    # leftovers
    st['locks'] = {
        'boot': os.path.exists(dsh_common.boot_lock()),
        'credentials': os.path.exists(os.path.join(HOME, '.dsh', '.credentials.yaml.lock')),
    }
    # lamps (three-colour summary the UI can use directly)
    # DSH / adb 的灯由各自的事实推；桥的灯**必须**由上面那个 state 推 —— 灯和文字同源，
    # 这是「绿灯 + 桥：未知」那次矛盾的根治办法。
    st['lamps'] = {
        'dsh': 'green' if st['dsh']['ok'] else ('yellow' if st['dsh']['port'] else 'red'),
        'bridge': LAMP_OF_STATE[st['bridge']['state']],
        'adb': 'green' if st['adb']['ok'] else 'red',
    }
    st['tasks'] = tasks_state()
    st['partial'] = out_of_time()   # true = the budget was hit; some items are "not asked in time" rather than "really red"
    return st


def text_of(st):
    L = []
    L.append('DSH status  %s' % st['ts'])
    L.append('─' * 34)
    L.append('DSH Web : %s  (port %s, HTTP %s)' % ('up' if st['dsh']['ok'] else 'down',
                                                   'open' if st['dsh']['port'] else 'closed', st['dsh']['http']))
    L.append('DSH brg : %s  %s' % (st['bridge']['state'],
                                   ('v' + st['bridge']['ver']) if st['bridge']['ver'] else ''))
    L.append('adb     : %s' % (st['adb']['devices'][0] if st['adb']['devices'] else 'not connected'))
    if st['locks']['boot'] or st['locks']['credentials']:
        L.append('⚠ locks left over: %s' % ', '.join(k for k, v in st['locks'].items() if v))
    L.append('')
    L.append('components (last result)')
    for name, t in st['tasks'].items():
        L.append('  %-16s %-6s %s' % (name, t['last'] or '—', t['at'] or ''))
    return '\n'.join(L) + '\n'


def main():
    global BUDGET_S
    for i, a in enumerate(sys.argv):
        if a == '--budget' and i + 1 < len(sys.argv):
            try:
                BUDGET_S = float(sys.argv[i + 1])
            except Exception:
                pass
        elif a.startswith('--budget='):
            try:
                BUDGET_S = float(a.split('=', 1)[1])
            except Exception:
                pass
    quiet = '--quiet' in sys.argv
    only_print = '--print' in sys.argv
    as_json = '--json' in sys.argv      # print JSON to stdout only (for the console APK)
    st = collect()
    if as_json:
        print(json.dumps(st, ensure_ascii=False))
        return 0
    txt = text_of(st)
    if not only_print:
        try:
            os.makedirs(OUTDIR, exist_ok=True)
            with open(JSON_PATH, 'w', encoding='utf-8') as f:
                json.dump(st, f, ensure_ascii=False, indent=1)
            with open(TXT_PATH, 'w', encoding='utf-8') as f:
                f.write(txt)
        except Exception as e:
            print('✘ failed to write the status file: %s' % e, file=sys.stderr)
            return 1
    if not quiet:
        print(txt, end='')
        if not only_print:
            print('\nwrote: %s' % JSON_PATH)
    return 0


if __name__ == '__main__':
    sys.exit(main())
