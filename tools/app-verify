#!/data/data/com.termux/files/usr/bin/python3
# install: runtime   （打开 APK 核对文案/主题；装机前跑一次）
r"""app-verify —— 出包后/装机后自检：这个 APK 里到底有没有"已经修好的那份文案和主题"。

WHY（这条是用户 2026-09-27 那次投诉的直接产物）
------------------------------------------------
上一轮的修复**只改了源码**：`tools/ui-controls` 的 groupEn 修了、i18n/zh.json 加了 key，但
生成的 UiControls.java / Lang.java 是 15:48 才重写的，而 APK 是 15:38 编的 —— 于是手机上
跑的还是旧表，"上一轮的要求根本没做到"。光看源码永远发现不了这件事，必须**打开包看**。

本工具做三件事：
  ① 从 APK 里读 AndroidManifest：版本号 + android:theme 必须等于 ui/theme.json 里那一个
     （桥正是因为没写主题才成了浅色 App）；
  ② 从 APK 里抽出 classes.dex，把该 App 的 Lang.java 里**每一条中文**拿去 dex 里找 ——
     少一条就说明这个包里的翻译表不是当前的（"改了源码没重新出包"当场现形）；
  ③ 打印 dex / APK 的 md5 指纹，用来和手机上装的那一份对拍。

用法
----
  tools/app-verify console [apk]    默认 ~/dsh-console/build/dsh-console.apk
  tools/app-verify bridge  [apk]    默认 ~/droid-bridge/build/dsh-bridge.apk
"""
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import zipfile

HOME = os.path.expanduser('~')
ROOT = os.path.expanduser(os.environ.get('DSH_KIT_REPO') or os.path.join(HOME, 'dsh-termux-kit'))
THEME = os.path.join(ROOT, 'ui', 'theme.json')
APPS = {
    'console': dict(apk=os.path.join(HOME, 'dsh-console', 'build', 'dsh-console.apk'),
                    lang=os.path.join(HOME, 'dsh-console', 'src', 'io', 'dsh', 'console', 'Lang.java'),
                    manifest=os.path.join(HOME, 'dsh-console', 'AndroidManifest.xml')),
    'bridge': dict(apk=os.path.join(HOME, 'droid-bridge', 'build', 'dsh-bridge.apk'),
                   lang=os.path.join(HOME, 'droid-bridge', 'src', 'io', 'dsh', 'bridge', 'Lang.java'),
                   manifest=os.path.join(HOME, 'droid-bridge', 'AndroidManifest.xml')),
}
bad = 0


def line(mark, msg):
    global bad
    if mark == '✘':
        bad += 1
    print('   %s %s' % (mark, msg))


def android_manifest(path):
    """把 APK 里的二进制 AndroidManifest.xml 还原成可读字符串（不反编译：只要属性值）。"""
    with zipfile.ZipFile(path) as z:
        raw = z.read('AndroidManifest.xml')
    # 字符串池里的 UTF-16 文本
    text = raw.decode('utf-16-le', 'ignore')
    return text


def android_theme(apk):
    """APK 里 <application> 的 android:theme。

    二进制 manifest 里主题是**资源引用**（@0x7f060001 这种），不是字符串，所以直接扫字符串池会
    误判成"没声明主题"（第一版就踩了）。用 aapt2 dump xmltree 读真实的属性。
    """
    try:
        out = subprocess.run(['aapt2', 'dump', 'xmltree', apk, '--file', 'AndroidManifest.xml'],
                             capture_output=True, text=True, timeout=60).stdout
    except Exception:
        return None
    m = re.search(r':theme\(0x01010000\)=@(0x[0-9a-fA-F]+)', out)
    return m.group(1) if m else None


def theme_style(apk, name='DshTheme'):
    """从资源表里取 <style name>：返回 (资源 id, parent, [item 行...])。

    为什么要按**名字**取而不是比 id：主题现在是 App 自己的资源，两个 App 的资源表不同，
    同一个样式在两边的 id 不一样（0x7f060001 / 0x7f030001）—— 比 id 会得出"两边不一致"的假结论。
    要比的是：manifest 指向的就是这个样式、两边的 parent 与 item 完全相同。
    """
    try:
        out = subprocess.run(['aapt2', 'dump', 'resources', apk],
                             capture_output=True, text=True, timeout=90).stdout
    except Exception:
        return None
    m = re.search(r'resource (0x[0-9a-fA-F]+) style/%s\n((?:.*\n)*?)(?=resource |type |$)' % re.escape(name), out)
    if not m:
        return None
    body = m.group(2)
    parent = re.search(r'parent=(0x[0-9a-fA-F]+)', body)
    items = re.findall(r'\n\s+(0x[0-9a-fA-F]+=@?[^\s]+)', body)
    return m.group(1), (parent.group(1) if parent else None), items


def color_value(apk, name='dsh_bg'):
    """取 <color name> 的实际值（用来证明窗口底色 = 页底色，而不是"信源码"）。"""
    try:
        out = subprocess.run(['aapt2', 'dump', 'resources', apk],
                             capture_output=True, text=True, timeout=90).stdout
    except Exception:
        return None
    m = re.search(r'resource 0x[0-9a-fA-F]+ color/%s\n\s+\(\) (#[0-9a-fA-F]+)' % re.escape(name), out)
    return m.group(1).lower() if m else None


def main():
    app = sys.argv[1] if len(sys.argv) > 1 else 'console'
    if app not in APPS:
        print('用法: app-verify console|bridge [apk]'); return 2
    spec = APPS[app]
    apk = sys.argv[2] if len(sys.argv) > 2 else spec['apk']
    theme = json.load(io.open(THEME, encoding='utf-8'))
    print('审计 %s：%s' % (app, apk))

    # ① manifest：版本 + 主题
    mtext = android_manifest(apk)
    ver = re.search(r'(\d+\.\d+)\x00', mtext)
    line('✔', '包内版本号：%s' % (ver.group(1) if ver else '?'))
    tid = android_theme(apk)
    if tid is None:
        line('✘', '包里没有声明 android:theme —— 会退回系统默认主题（浅色窗口 + 浅色 ActionBar，标题重复）')
    else:
        st = theme_style(apk, 'DshTheme')
        if st is None:
            line('✘', '包里没有 style/DshTheme（窗口底色没人管 → 内容短或滚到底会露出平台主题的灰）')
        else:
            sid, parent, items = st
            if sid != tid:
                line('✘', 'manifest 指向的主题 %s 不是 DshTheme(%s) —— 改的不是同一个样式' % (tid, sid))
            else:
                line('✔', 'manifest 的 android:theme 就是 style/DshTheme(%s)，parent=%s' % (sid, parent))
            bg = color_value(apk, 'dsh_bg')
            line('✔' if bg else '✘', '窗口底色 color/dsh_bg = %s（页底色由 Palette.BG 刷，两边同一个值）' % bg)
            # 两个 App 必须**逐项相同**（id 会不一样，所以比 item 文本，不比 id）
            other = 'bridge' if app == 'console' else 'console'
            ost = theme_style(APPS[other]['apk'], 'DshTheme') if os.path.exists(APPS[other]['apk']) else None
            if ost is None:
                line('✘', '另一个 App（%s）还没有 DshTheme' % other)
            elif ost[1] != parent or ost[2] != items:
                line('✘', '两个 App 的主题不一致：本包 parent=%s items=%s / %s parent=%s items=%s'
                     % (parent, items, other, ost[1], ost[2]))
            else:
                line('✔', '另一个 App（%s）的主题逐项相同（parent=%s，%d 项：窗口底色/状态栏/导航栏/辉光/对话框）'
                     % (other, parent, len(items)))

    # ② dex：当前翻译表的每条中文都必须真的在包里
    with zipfile.ZipFile(apk) as z:
        dex = z.read('classes.dex')
    dexmd5 = hashlib.md5(dex).hexdigest()
    src = io.open(spec['lang'], encoding='utf-8').read()
    pairs = re.findall(r'ZH\.put\("((?:[^"\\]|\\.)*)",\s*"((?:[^"\\]|\\.)*)"\)', src)
    zh = [v for _, v in pairs if v.strip()]
    missing = []
    for z_ in zh:
        needle = z_.replace('\\n', '\n').replace('\\t', '\t').encode('utf-8')
        if needle not in dex:
            missing.append(z_)
    if missing:
        line('✘', '有 %d 条中文不在包里（说明这个 APK 不是用当前翻译表编的 —— 就是上一轮"改了没出包"那种情况）：'
             % len(missing))
        for z_ in missing[:8]:
            print('        · %s' % z_)
    else:
        line('✔', 'Lang.java 里 %d 条中文**全部**在这个 APK 的 dex 里（翻译表是当前这一份）' % len(zh))

    # ③ 一个版本号只能对应一份内容（用户 2026-09-27 的批评："这几个版本都没有更新版本号"）——
    #    改了东西却没顶版本号，dist/ 里就会出现两份同版本、不同字节的包，谁都不知道手机装的是哪一份。
    ver_now = ver.group(1) if ver else '?'
    dist = os.path.join(ROOT, 'dist')
    clash = []
    if os.path.isdir(dist):
        for fn in sorted(os.listdir(dist)):
            if not fn.endswith('.apk') or app not in fn:
                continue
            m = re.search(r'v?(\d+\.\d+)\.apk$', fn)
            if not m or m.group(1) != ver_now:
                continue
            d = os.path.join(dist, fn)
            if hashlib.md5(io.open(d, 'rb').read()).hexdigest() != hashlib.md5(io.open(apk, 'rb').read()).hexdigest():
                clash.append(fn)
    if clash:
        line('✘', '版本号没变但内容变了：dist/%s 与这个包同为 v%s 却是两份不同的东西 —— '
                  '顶一个版本号再出包（一次交付一个版本号）' % (', '.join(clash), ver_now))
    else:
        line('✔', '版本号 v%s 在 dist/ 里没有第二份不同内容的包' % ver_now)

    # ④ 指纹：和手机上的对拍用
    apkmd5 = hashlib.md5(io.open(apk, 'rb').read()).hexdigest()
    line('✔', '指纹 apk md5 %s · classes.dex md5 %s' % (apkmd5[:16], dexmd5[:16]))

    print('\n%s' % ('✅ 这个包里的文案与主题就是当前源码那一份' if bad == 0
                    else '❌ %d 项不对 —— 别装它，先重新出包' % bad))
    return 0 if bad == 0 else 1


if __name__ == '__main__':
    sys.exit(main())
