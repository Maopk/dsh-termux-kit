#!/data/data/com.termux/files/usr/bin/bash
# dsh-auth-pass —— manages whether the AI may use your lockscreen password (part of the self-rescue channel)
#
# Semantics (corrected by the user on 2026-09-26): those 6 digits are **not install-only**, they are a **general system-auth credential** —
#   installing an APK needs 「安全验证」, lifting an app "restriction", sensitive confirms in developer options ... all of them ask for it.
#   This file means: **the AI is allowed to use this password when passing authentication for you**.
#   Revoking it (deleting this file) = the AI loses the right at once, and every action that needs it to pass auth stops.
# It lives in its own small chmod 600 file, so **revoke = delete this file**:
#   One step, no screen, no buttons to tap, and no cooperation from the AI needed.
#
#   status          show whether authorization exists (file / mode / write time / digit count) — **never echoes the password itself**
#   revoke | off    revoke authorization: overwrite, then delete, then verify that it is "really gone"
#   set             read 6 digits from stdin and write them (600); anything else is refused
#   digits          print the 6 digits to stdout (no newline) — only for automation that "taps the keypad digit by digit"
#   path            print the file path
#
# Sandbox: DSH_AUTH_PASS_FILE=/some/tmp/path swaps the file (the self-test suite uses it to test revoke without deleting the real one)
set -u
PASS_FILE="${DSH_AUTH_PASS_FILE:-${DSH_INSTALL_PASS_FILE:-$HOME/.dsh-auth-pass}}"
OLD_PASS="$HOME/.dsh-install-pass"
# Migration: if the old .dsh-install-pass is still there and the new file is not, it is moved over (name changed, meaning unchanged)
if [ ! -f "$PASS_FILE" ] && [ -f "$OLD_PASS" ] && [ -z "${DSH_INSTALL_PASS_FILE:-}" ] && [ -z "${DSH_AUTH_PASS_FILE:-}" ]; then
  mv -f "$OLD_PASS" "$PASS_FILE" 2>/dev/null && chmod 600 "$PASS_FILE" 2>/dev/null
fi
cmd="${1:-status}"

case "$cmd" in
  path)
    printf '%s\n' "$PASS_FILE" ;;

  status)
    if [ -f "$PASS_FILE" ]; then
      mode=$(stat -c '%a' "$PASS_FILE" 2>/dev/null || echo '?')
      when=$(stat -c '%y' "$PASS_FILE" 2>/dev/null | cut -d. -f1)
      len=$(tr -d '\n\r \t' < "$PASS_FILE" | wc -c | tr -d ' ')
      printf 'Authorized: %s (mode %s, written %s, length %s digits)\n' "$PASS_FILE" "$mode" "$when" "$len"
      [ "$mode" = "600" ] || printf '⚠ mode is not 600 (currently %s) — chmod 600 %s now\n' "$mode" "$PASS_FILE"
      [ "$len" = "6" ] || printf '⚠ length is not 6 digits; install automation may not be able to read it\n'
    else
      printf 'Not authorized: %s does not exist → the AI cannot pass any authentication with your lockscreen password (installs included); you must do it yourself\n' "$PASS_FILE"
      exit 1
    fi ;;

  set)
    d=$(cat | tr -d '\n\r \t')
    case "$d" in
      [0-9][0-9][0-9][0-9][0-9][0-9]) ;;
      *) printf 'refused: only 6 digits are accepted (got %s characters)\n' "${#d}" >&2; exit 2 ;;
    esac
    umask 077
    printf '%s' "$d" > "$PASS_FILE" || { printf 'write failed: %s\n' "$PASS_FILE" >&2; exit 1; }
    chmod 600 "$PASS_FILE"
    printf '✔ Authorized: wrote %s (mode %s, %s digits)\n' "$PASS_FILE" "$(stat -c '%a' "$PASS_FILE")" "${#d}"
    printf '  To revoke: the 『密码使用权』 switch under 「维护」 in the Console App / widget 9 / or just rm %s\n' "$PASS_FILE" ;;

  revoke|off)
    if [ ! -f "$PASS_FILE" ]; then printf 'there was no authorization to begin with (%s does not exist)\n' "$PASS_FILE"; exit 0; fi
    n=$(tr -d '\n\r \t' < "$PASS_FILE" | wc -c | tr -d ' ')
    # Overwrite first, then delete: not a secure erase, but it leaves less behind than a plain rm
    if [ "$n" -gt 0 ] 2>/dev/null; then
      printf '0%.0s' $(seq 1 "$n") > "$PASS_FILE" 2>/dev/null || true
      sync 2>/dev/null || true
    fi
    rm -f "$PASS_FILE"
    if [ -e "$PASS_FILE" ]; then printf '✘ revoke failed: %s is still there\n' "$PASS_FILE" >&2; exit 1; fi
    printf '✔ Revoked: %s deleted\n' "$PASS_FILE"
    printf '  Meaning: the AI no longer has the right to use this password — installs, lifting restrictions and anything else that needs it will stop,\n'
    printf '        and you must use your fingerprint or password yourself, or re-authorize (dsh-auth-pass set).\n'
    printf '  Restore: give the 6 digits again (printf password | dsh-auth-pass set).\n' ;;

  digits)
    [ -f "$PASS_FILE" ] || { printf 'not authorized (%s does not exist)\n' "$PASS_FILE" >&2; exit 1; }
    d=$(tr -d '\n\r \t' < "$PASS_FILE")
    case "$d" in
      [0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' "$d" ;;
      *) printf 'file contents are not 6 digits; refusing to print\n' >&2; exit 2 ;;
    esac ;;

  *)
    printf 'Usage: dsh-auth-pass status|set|revoke|digits|path\n' >&2; exit 2 ;;
esac
