#!/data/data/com.termux/files/usr/bin/bash
# droid-hub —— fallback channel with no Wi-Fi and no root: talk to an AutoX.js bridge script through a shared directory
#   Termux writes /sdcard/dsh-droid/cmd.json → AutoX.js runs it → writes /sdcard/dsh-droid/res.json
# Needs AutoX.js installed, accessibility on, and /sdcard/dsh-droid/bridge.js running
# Same usage as droid: droid-hub tap X Y | swipe x1 y1 x2 y2 [ms] | text 'text' | key back|home|enter
#                    droid-hub shot [path] | ui [keyword] | find 'text' [--tap] | start <package> | cur | ping
set -u
DIR="$HOME/storage/shared/dsh-droid"
CMD="$DIR/cmd.json"
RES="$DIR/res.json"
TIMEOUT="${TIMEOUT:-25}"
mkdir -p "$DIR"

send() {
  python3 - "$@" <<'PY'
import json, sys, time, os
a = sys.argv[1:]
home = os.environ['HOME']
d = home + '/storage/shared/dsh-droid'
cmd = {"id": str(int(time.time() * 1000))}
kind = a[0] if a else 'ping'
if kind == 'tap':      cmd.update(action='tap', x=int(a[1]), y=int(a[2]))
elif kind == 'longpress': cmd.update(action='longpress', x=int(a[1]), y=int(a[2]), ms=int(a[3]) if len(a) > 3 else 800)
elif kind == 'swipe':  cmd.update(action='swipe', x1=int(a[1]), y1=int(a[2]), x2=int(a[3]), y2=int(a[4]), ms=int(a[5]) if len(a) > 5 else 300)
elif kind == 'text':   cmd.update(action='text', value=a[1] if len(a) > 1 else '')
elif kind == 'key':    cmd.update(action='key', value=a[1] if len(a) > 1 else 'back')
elif kind == 'shot':
    path = a[1] if len(a) > 1 else ('/sdcard/dsh-droid/shot-%d.png' % int(time.time()))
    cmd.update(action='shot', path=path)
elif kind == 'ui':     cmd.update(action='ui', keyword=a[1] if len(a) > 1 else '', limit=int(a[2]) if len(a) > 2 else 30)
elif kind == 'start':  cmd.update(action='start', value=a[1])
elif kind == 'cur':    cmd.update(action='cur')
elif kind == 'ping':   cmd.update(action='ping')
else:
    print(json.dumps({'ok': False, 'error': 'unknown usage: ' + kind})); sys.exit(2)
open(d + '/cmd.json', 'w').write(json.dumps(cmd, ensure_ascii=False))
print(json.dumps(cmd, ensure_ascii=False))
PY
}

JSON="$(send "$@")" || exit 2
ID="$(printf '%s' "$JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
BEFORE="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
DEADLINE=$(( $(date +%s) + TIMEOUT ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  sleep 1
  AFTER="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
  [ -n "$AFTER" ] && [ "$AFTER" != "$BEFORE" ] || continue
  GOT="$(python3 -c '
import json,sys
try: print(json.load(open(sys.argv[1], encoding="utf-8")).get("id",""))
except Exception: print("")
' "$RES")"
  [ "$GOT" = "$ID" ] || continue
  python3 - "$RES" <<'PY'
import json, sys
d = json.load(open(sys.argv[1], encoding='utf-8'))
print('result:', '✅' if d.get('ok') else '❌', d.get('error') or '')
data = d.get('data')
if isinstance(data, dict):
    if 'nodes' in data:
        for n in data['nodes']:
            c = n.get('center')
            print(f"  [{c[0]},{c[1]}] {n.get('cls',''):<16} text={n.get('text','')[:40]!r} desc={n.get('desc','')[:26]!r} id={n.get('id','')[-26:]}")
        print(f"  {data.get('count')} nodes")
    else:
        print('  ', json.dumps(data, ensure_ascii=False)[:600])
PY
  if [ "$(printf '%s' "$JSON" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["action"])')" = "shot" ]; then
    P="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1],encoding="utf-8"))
print((d.get("data") or {}).get("path",""))
' "$RES")"
    [ -n "$P" ] && echo "  screenshot at: $P  (Termux path: $HOME/storage/shared${P#/sdcard})"
  fi
  exit 0
done
echo "⏱ Timeout: the bridge script does not seem to be running. Open /sdcard/dsh-droid/bridge.js in AutoX.js and tap run." >&2
echo "Self-check: ls -l $DIR ; cat $DIR/bridge.log | tail -5" >&2
exit 1
