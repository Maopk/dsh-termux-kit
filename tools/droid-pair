#!/data/data/com.termux/files/usr/bin/bash
# droid-pair —— pair and connect wireless debugging in one shot (just give the 6-digit code; ports are found automatically)
# Usage: droid-pair <6-digit pairing code>          (the pairing dialog must be open)
#       droid-pair                      just reconnect (use when already paired)
set -u
CODE="${1:-}"

find_port() {   # $1 = pairing | connect
  python3 - "$1" <<'PY'
import socket, sys, time
from zeroconf import Zeroconf, ServiceBrowser, ServiceListener
want = 'pairing' if sys.argv[1] == 'pairing' else 'connect'
found = []
class L(ServiceListener):
    def add_service(self, zc, type_, name):
        info = zc.get_service_info(type_, name, timeout=2500)
        if info and want in type_:
            for a in info.addresses:
                found.append((socket.inet_ntoa(a), info.port))
    def update_service(self, *a): pass
    def remove_service(self, *a): pass
zc = Zeroconf()
ServiceBrowser(zc, ['_adb-tls-pairing._tcp.local.', '_adb-tls-connect._tcp.local.'], L())
deadline = time.time() + 22
while time.time() < deadline and not found:
    time.sleep(0.5)
zc.close()
if found:
    ip, port = found[0]
    print('%s:%d' % (ip, port))
PY
}

MANUAL_PORT="${2:-}"
if [ -n "$CODE" ]; then
  if [ -n "$MANUAL_PORT" ]; then
    PAIR="127.0.0.1:$MANUAL_PORT"
    echo "① using the pairing port you gave: $PAIR"
  else
  echo "① looking for the pairing port (mDNS, up to 22s)…"
  PAIR="$(find_port pairing)"
  if [ -z "$PAIR" ]; then
    echo "❌ no pairing service found. You can pass the ports by hand: droid-pair <code> <pairing port>"
    exit 1
  fi
  fi
  echo "   pairing service: $PAIR"
  echo "② pairing (code $CODE)"
  adb pair "${PAIR%:*}:${PAIR##*:}" "$CODE" 2>&1 | tail -3
else
  echo "① skipping pairing, reconnecting directly"
fi

echo "③ looking for the connect port …"
CONN="$(find_port connect)"
CONN="${CONN:-192.168.1.100:43321}"
echo "   connect target: $CONN"
adb connect "$CONN" 2>&1 | tail -2
sleep 1

echo "④ device state"
adb devices -l | tail -n +2
if adb devices | awk 'NR>1 && $2=="device"' | grep -q .; then
  echo "⑤ verify shell"
  adb shell echo "adb-ok: \$(getprop ro.product.model)" 2>&1 | tail -1
  echo
  echo "✅ wireless debugging channel is up. Optional next step: fix the port (works with Wi-Fi off, until reboot)"
  echo "   Run: adb tcpip 5555 && adb connect 127.0.0.1:5555"
else
  echo "⚠️ not connected yet. If it says unauthorized, tap 『允许调试』 on the phone screen; if it says offline, toggle wireless debugging off and on and retry."
fi
