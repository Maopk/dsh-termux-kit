#!/data/data/com.termux/files/usr/bin/python3
r"""i18n-table — the kit's single translation source and its two code generators.

WHY
---
The same English string is displayed by three different runtimes:

    widgets/*.sh        bash    dsh_msg()          → table inside widgets/i18n.sh
    DSH Bridge (app)    Java    Lang.t()           → table inside …/bridge/Lang.java
    DSH Console (app)   Java    Lang.t()           → table inside …/console/Lang.java

Hand-maintaining three tables is what produced every translation bug so far: a string added
to one table and forgotten in another, and — worse — the **opposite escaping rules** of the
two runtimes silently killing whole blocks.

    bash  consumes dsh_msg output through `printf "$(...)"`, and the table is `declare -A`
          with single-quoted values: a line break MUST be stored as the two characters \ and n.
    Java  compares runtime strings and assigns them straight to setText(): a line break MUST
          be the one-character escape \n in the source, i.e. a real newline at runtime.

So: ONE source file, `i18n/zh.json`, and two generators that apply each runtime's own rules.
Nothing else may edit the generated blocks.

SOURCE FORMAT  i18n/zh.json
    {
      "English source string": "中文",
      "with a line break\n": "带一个换行\n"
    }
    · keys are the exact English strings the code passes in (a real newline is \n in JSON)
    · an empty value means "deliberately untranslated" (ids, command paths, wire protocol)

USAGE
    i18n-table check                 verify both generated blocks match the source
    i18n-table gen                   rewrite both generated blocks from the source
    i18n-table add patch.json        merge {en: zh} pairs into the source, then gen
    i18n-table missing               list source keys with no translation yet
    i18n-table audit <dir>           find user-visible literals in Java sources with no entry
"""
import json
import os
import re
import sys

HOME = os.path.expanduser('~')
ROOT = os.path.join(HOME, 'dsh-termux-kit')
SOURCE = os.path.join(ROOT, 'i18n', 'zh.json')
BASH_TARGET = os.path.join(ROOT, 'widgets', 'i18n.sh')
JAVA_TARGETS = [
    os.path.join(HOME, 'droid-bridge', 'src', 'io', 'dsh', 'bridge', 'Lang.java'),
    os.path.join(HOME, 'dsh-console', 'src', 'io', 'dsh', 'console', 'Lang.java'),
]

BASH_BEGIN = '# >>> generated by tools/i18n-table — do not edit by hand >>>'
BASH_END = '# <<< generated by tools/i18n-table <<<'
JAVA_BEGIN = '        // >>> generated by tools/i18n-table — do not edit by hand >>>'
JAVA_END = '        // <<< generated by tools/i18n-table <<<'


# ---------------------------------------------------------------- source

def canon(s: str) -> str:
    r"""One string, one key.

    A shell call site spells a line break as the two characters \ and n (it is inside single
    quotes), while the same line decoded from a Java source or written by hand is a real
    newline. Both mean the same user-visible string, and both generators normalise to their
    own runtime form anyway — so the *source file* must pick one representation, or the table
    ends up with two rows for one string and a future edit updates only one of them.
    Canonical form: a REAL newline (which json.dump writes as the \n escape).
    """
    return s.replace('\\n', '\n').replace('\\t', '\t')


def load_source():
    with open(SOURCE, encoding='utf-8') as fh:
        data = json.load(fh)
    return {canon(k): v for k, v in data.items()}


def save_source(tbl):
    os.makedirs(os.path.dirname(SOURCE), exist_ok=True)
    with open(SOURCE, 'w', encoding='utf-8') as fh:
        json.dump(dict(sorted(tbl.items())), fh, ensure_ascii=False, indent=1)
        fh.write('\n')


# ---------------------------------------------------------------- escaping

def bash_quote(s: str) -> str:
    r"""Single-quote a bash string: a line break becomes the TWO characters \ and n.

    printf "$(dsh_msg …)" turns them into a newline at print time, and `declare -A` stays
    one-line-per-entry. A single quote is the only character bash cannot carry inside '…'.
    """
    s = s.replace('\n', '\\n').replace('\t', '\\t').replace("'", "'\\''")
    return "'" + s + "'"


def java_escape(v: str) -> str:
    r"""Runtime value → Java source body. A newline becomes the escape \n (one char at runtime)."""
    out = []
    for ch in v:
        out.append({'\n': '\\n', '\t': '\\t', '\r': '\\r', '"': '\\"', '\\': '\\\\'}.get(ch, ch))
    return ''.join(out)


# ---------------------------------------------------------------- generators

def render_bash(tbl) -> str:
    lines = [BASH_BEGIN]
    for en in sorted(tbl):
        zh = tbl[en]
        lines.append(f'  [{bash_quote(en)}]={bash_quote(zh)}')
    lines.append(BASH_END)
    return '\n'.join(lines)


def render_java(tbl, present) -> str:
    """Emit only the entries this app can actually look up.

    `present` is the set of string literals found in that app's own sources. A Java lookup is
    always Lang.t(<something>) where <something> is either a literal in the app or a value
    built from literals in the app (Tasks.CATS, Tasks.ALL, panic reasons, stopListening
    reasons…). So "the literal exists in this app's sources" is the precise, self-maintaining
    test: add a new Lang.t("…") and the next gen picks the translation up automatically.
    Emitting the whole shared table instead would push every bash-only string into a 33 KB
    APK — measured at +23 KB per app before this filter existed.
    """
    lines = [JAVA_BEGIN]
    for en in sorted(tbl):
        zh = tbl[en]
        if not zh:
            continue                      # deliberately untranslated → no Java lookup needed
        if en not in present:
            continue                      # this app never looks this string up
        lines.append(f'        ZH.put("{java_escape(en)}", "{java_escape(zh)}");')
    lines.append(JAVA_END)
    return '\n'.join(lines)


def replace_block(text, begin, end, block, path):
    if begin in text and end in text:
        pre = text[:text.index(begin)]
        post = text[text.index(end) + len(end):]
        return pre + block + post, 'replaced'
    raise SystemExit(f'❌ {path}: generated block markers not found — cannot rewrite safely')


def gen(check_only=False):
    tbl = load_source()
    problems = []
    cur = open(BASH_TARGET, encoding='utf-8').read()
    new, _ = replace_block(cur, BASH_BEGIN, BASH_END, render_bash(tbl), BASH_TARGET)
    if new != cur:
        problems.append(BASH_TARGET)
        if not check_only:
            open(BASH_TARGET, 'w', encoding='utf-8').write(new)
    total_java = 0
    for path in JAVA_TARGETS:
        # Scan the app's own sources, but NOT Lang.java itself — counting the table's own
        # strings as "present" would make the filter self-fulfilling and never shrink.
        d = os.path.dirname(path)
        present = set()
        for f in sorted(os.listdir(d)):
            if f.endswith('.java') and f != os.path.basename(path):
                present |= {canon(lit) for lit, _ in literals(os.path.join(d, f))}
        block = render_java(tbl, present)
        total_java += block.count('ZH.put(')
        cur = open(path, encoding='utf-8').read()
        new, _ = replace_block(cur, JAVA_BEGIN, JAVA_END, block, path)
        if new != cur:
            problems.append(path)
            if not check_only:
                open(path, 'w', encoding='utf-8').write(new)
    if check_only:
        if problems:
            print('❌ out of date:')
            for p in problems:
                print('   ' + p)
            return 1
        print(f'✅ generated blocks match i18n/zh.json '
              f'(source {len(tbl)} entries, {total_java} placed into the two apps)')
        return 0
    print(f'✅ regenerated from i18n/zh.json ({len(tbl)} source entries)')
    for p in problems:
        print('   wrote ' + p)
    return 0


# ---------------------------------------------------------------- bootstrap

def bootstrap():
    """One-off: pull the three hand-written tables into the single source.

    bash  : keys/values are single-quoted with the 2-char \n  → turn it into a real newline
    Java  : keys/values are double-quoted with the real \n escape → decode to the runtime value
    """
    tbl = {}
    bash = open(BASH_TARGET, encoding='utf-8').read()
    for m in re.finditer(r"^\s*\['((?:[^']|'\\'')*)'\]='((?:[^']|'\\'')*)'\s*$", bash, re.M):
        k = m.group(1).replace("'\\''", "'").replace('\\n', '\n').replace('\\t', '\t')
        v = m.group(2).replace("'\\''", "'").replace('\\n', '\n').replace('\\t', '\t')
        tbl[k] = v
    print(f'  bash table: {len(tbl)}')
    for path in JAVA_TARGETS:
        src = open(path, encoding='utf-8').read()
        n = 0
        for m in re.finditer(r'ZH\.put\(\s*"((?:[^"\\]|\\.)*)"\s*,\s*"((?:[^"\\]|\\.)*)"\s*\)', src):
            def dec(s):
                out, i = [], 0
                while i < len(s):
                    if s[i] == '\\' and i + 1 < len(s):
                        out.append({'n': '\n', 't': '\t', 'r': '\r', '"': '"', '\\': '\\'}.get(s[i+1], s[i+1]))
                        i += 2
                        continue
                    out.append(s[i]); i += 1
                return ''.join(out)
            k, v = dec(m.group(1)), dec(m.group(2))
            if k in tbl and tbl[k] != v:
                print(f'  ⚠ conflict for {k!r}: bash={tbl[k]!r} java={v!r} → keeping java')
            tbl[k] = v
            n += 1
        print(f'  {os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(path))))}: {n}')
    save_source(tbl)
    print(f'✅ bootstrapped {len(tbl)} entries into {SOURCE}')
    return 0


# ---------------------------------------------------------------- audit

JAVA_UI_SKIP = [
    re.compile(r'^[a-z_]+(\.[a-z_]+)+$'),        # dotted keys / intents
    re.compile(r'^[A-Za-z0-9_]+$'),               # bare identifier
    re.compile(r'^[-\w/]+\.(sh|log|json|txt|apk|jks|xml)$'),
    re.compile(r'^\d+(\.\d+)?$'),
    re.compile(r'^%[sd]$'),
    re.compile(r'^https?://'),
    re.compile(r'^[\s\\nrt]*$'),
    re.compile(r'^(io|com|android|org)\.'),
    re.compile(r'^\.[A-Za-z]'),                   # /.local/bin/... fragments
    re.compile(r'^[A-Za-z0-9_/.$"\'“” -]{0,3}$'),  # too short to be copy
]


def literals(path):
    src = open(path, encoding='utf-8').read()
    out, i, n, line = [], 0, len(src), 1
    while i < n:
        c = src[i]
        if c == '\n':
            line += 1; i += 1; continue
        if c == '/' and i + 1 < n and src[i+1] == '/':
            while i < n and src[i] != '\n': i += 1
            continue
        if c == '/' and i + 1 < n and src[i+1] == '*':
            i += 2
            while i + 1 < n and not (src[i] == '*' and src[i+1] == '/'):
                if src[i] == '\n': line += 1
                i += 1
            i += 2; continue
        if c == '"':
            start = line; i += 1; buf = []
            while i < n and src[i] != '"':
                if src[i] == '\\' and i + 1 < n:
                    buf.append({'n': '\n', 't': '\t', 'r': '\r'}.get(src[i+1], src[i+1]))
                    i += 2; continue
                buf.append(src[i]); i += 1
            i += 1
            out.append((''.join(buf), start)); continue
        if c == "'":
            i += 1
            while i < n and src[i] != "'":
                if src[i] == '\\': i += 1
                i += 1
            i += 1; continue
        i += 1
    return out


def audit(d):
    tbl = load_source()
    hits = {}
    for root, _, files in os.walk(d):
        for f in sorted(files):
            if not f.endswith('.java'):
                continue
            for lit, line in literals(os.path.join(root, f)):
                lit = canon(lit)          # same string, one key
                if not lit.strip() or lit in tbl:
                    continue
                if any(r.match(lit) for r in JAVA_UI_SKIP):
                    continue
                if not re.search(r'[A-Za-z]{2}', lit):
                    continue
                if re.search(r'[\u4e00-\u9fff]', lit):
                    continue
                if ' ' not in lit.strip():
                    continue
                hits.setdefault(lit, []).append(f'{f}:{line}')
    for lit, locs in sorted(hits.items(), key=lambda kv: kv[1][0]):
        print(f'  [{locs[0]}] {lit!r}')
    print(f'  → {len(hits)} user-visible literals with no entry')
    return 0


def unused():
    """Entries no call site ever looks up — the mirror image of `audit`.

    `audit` finds strings that reach the screen but never reach the table. This finds the
    opposite, and it is how the Bridge's persistent notification was missed: the table carried
    'DSH Bridge is running' -> 'DSH 桥正在运行' while the notification builder used the raw
    English literal, so the shade stayed English and every check said the string was translated.
    An entry that nothing references is either a call site that forgot to wrap, or dead weight.
    """
    tbl = load_source()
    sources = {}
    # ⚠ Skip the generated tables themselves. The first version of this check scanned
    # widgets/*.sh, which includes the generated i18n.sh — so every key trivially "appeared in
    # the source" and the check could never fail. Same for each app's Lang.java. Only real call
    # sites count.
    skip = {os.path.basename(BASH_TARGET)} | {os.path.basename(t) for t in JAVA_TARGETS}
    pats = ['widgets/*.sh', 'tools/*', 'tests/*.sh', 'plugins/*/*.js', 'plugins/*/*/*.js']
    files = []
    for pat in pats:
        files += sorted(__import__('glob').glob(os.path.join(ROOT, pat)))
    for p in files:
        if os.path.isdir(p) or os.path.basename(p) in skip:
            continue
        try:
            sources[p] = open(p, encoding='utf-8').read()
        except Exception:
            pass
    for app_dir in JAVA_TARGETS:
        d = os.path.dirname(app_dir)
        for f in sorted(os.listdir(d)):
            if f.endswith('.java') and f not in skip:
                sources[os.path.join(d, f)] = open(os.path.join(d, f), encoding='utf-8').read()
    dead = []
    for k in tbl:
        if not k.strip():
            continue
        # the runtime value must appear somewhere; shell templates spell \n as two chars, so
        # search the key as-is and with its line breaks flattened
        # the same string is written three ways: real newlines (JSON), the two characters
        # \\n (shell templates and Java source), or joined with no break at all
        variants = {k, k.replace('\n', '\\n'), k.replace('\n', ''),
                    k.replace('"', '\\"'),                      # 双引号在源码里常写成 \"
                    k.replace('"', "'")}                          # 或改用单引号避免拆串
        if not any(any(v and v in src for v in variants) for src in sources.values()):
            dead.append(k)
    for k in dead:
        print(f'  {k!r}')
    print(f'  → {len(dead)} entries that no call site looks up (of {len(tbl)})')
    return 0


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    cmd = sys.argv[1]
    if cmd == 'check':
        return gen(check_only=True)
    if cmd == 'gen':
        return gen()
    if cmd == 'bootstrap':
        return bootstrap()
    if cmd == 'missing':
        tbl = load_source()
        gaps = [k for k, v in tbl.items() if not v]
        for k in gaps:
            print(f'  {k!r}')
        print(f'  → {len(gaps)} untranslated of {len(tbl)}')
        return 0
    if cmd == 'add':
        patch = json.load(open(sys.argv[2], encoding='utf-8'))
        tbl = load_source()
        added = changed = 0
        for k, v in patch.items():
            k = canon(k)
            if k not in tbl:
                added += 1
            elif tbl[k] != v:
                changed += 1
                print(f'   ~ 改译 {k[:60]!r}\n      旧 {tbl[k]!r}\n      新 {v!r}')
            tbl[k] = v
        save_source(tbl)
        print(f'✅ +{added} new, ~{changed} changed → {len(tbl)} entries')
        return gen()
    if cmd == 'audit':
        return audit(sys.argv[2])
    if cmd == 'unused':
        return unused()
    raise SystemExit(f'unknown command {cmd!r}')


if __name__ == '__main__':
    sys.exit(main())
