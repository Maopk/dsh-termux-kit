#!/data/data/com.termux/files/usr/bin/bash
# dsh-find-blue —— find blue tappable text on the current screen and print "x,y"
#
# Why: that line in the vivo installer, 「…您可授权本次安装」, is **not in the accessibility tree**
# (the tree holds one node for the whole paragraph), and the system wording and layout change (measured: two layouts on the same phone:
# paragraph at y≈1135 or y≈1255, link at its end). So blue text can only be located by **color**.
# Usage: dsh-find-blue [y-from] [y-to]      default 600..2200 (skips the app info at top and the buttons at bottom)
set -u
Y1="${1:-600}"; Y2="${2:-2200}"
SOCK="$HOME/.local/bin/droid-sock"
SHOT=$(timeout 30 "$SOCK" shot 2>/dev/null | grep -oE '/data[^ ]+\.png' | head -1)
[ -n "$SHOT" ] && [ -f "$SHOT" ] || { printf 'screenshot failed\n' >&2; exit 1; }
H=$(( Y2 - Y1 ))
magick "$SHOT" -crop "1440x${H}+0+${Y1}" +repage \
  -fuzz 22% -fill white -opaque "#2785FE" -fill black +opaque white \
  -define connected-components:verbose=true -connected-components 8 null: 2>/dev/null \
| awk -v y1="$Y1" '
  /^ *[0-9]+:/ {
    if (match($0, /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/)) {
      split(substr($0,RSTART,RLENGTH), a, /x|\+/)
      w=a[1]+0; h=a[2]+0
      # keep only blocks the size of a "glyph": too flat is an underline or border, too tall is a color patch
      if (h >= 18 && h <= 90 && w >= 10) {
        if (match($0, /[0-9]+\.[0-9]+,[0-9]+\.[0-9]+/)) {
          split(substr($0,RSTART,RLENGTH), p, ",")
          cx=p[1]+0; cy=p[2]+0
          area = w*h
          if (area > best) { best=area; bx=cx; by=cy+y1 }
        }
      }
    }
  }
  END { if (best > 150) printf "%d,%d\n", bx, by; else exit 1 }'
