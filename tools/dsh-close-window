#!/data/data/com.termux/files/usr/bin/bash
# dsh-close-window —— close the DSH browser / PWA (WebAPK) window
#
# Why a separate tool:
#   the am bundled with Termux is termux-am 0.8.1, which **has no force-stop subcommand**
#   (`am force-stop X` → Error: unknown command). So the line in "close DSH" that called
#   `close_pkg com.android.chrome` was **fake** without adb — it printed "closed" while the window stayed open.
#   Only two routes can really close another App window:
#     ① adb (shell identity): adb shell am force-stop …
#     ② the accessibility bridge: bring the window to the front, then press system Back until it is no longer in front
#   (the "foreground package" of a PWA/TWA window is com.android.chrome — Chrome renders for the WebAPK,
#     so "is the window still there" is judged by com.android.chrome.)
#
# ⚠ Ordering: closing the window through the bridge must happen before stopping the bridge (2_shutdown-dsh.sh is ordered that way).
#
# Usage: 
#   dsh-close-window            really close it (adb first, then the bridge)
#   dsh-close-window --probe    report state only, touch nothing (for self-tests)
#   dsh-close-window --dry-run  print the plan only
#   dsh-close-window --keep-chrome   close only the PWA shell, do not force-stop Chrome (when adb is available)
set -u
HOME_DIR=/data/data/com.termux/files/home
SOCK="$HOME_DIR/.local/bin/droid-sock"
PWAFILE="$HOME_DIR/.dsh-pwa"
URLFILE="$HOME_DIR/.dsh-url"
DRY=0; PROBE=0; KEEP_CHROME=0
for a in "$@"; do case "$a" in
  --dry-run) DRY=1 ;;
  --probe) PROBE=1 ;;
  --keep-chrome) KEEP_CHROME=1 ;;
esac; done
say() { printf '%s\n' "$*"; }

# foreground package (fast, no wake)
fg_pkg() {
  timeout 8 "$SOCK" cur 2>/dev/null | grep -o '"pkg":[[:space:]]*"[^"]*"' | cut -d'"' -f4
}
# PWA package: prefer the cache (written by dsh-browser-open), otherwise ask adb
pwa_pkg() {
  local p=""
  [ -f "$PWAFILE" ] && p=$(head -1 "$PWAFILE" | tr -d '[:space:]')
  if [ -z "$p" ] && adb devices 2>/dev/null | awk 'NR>1 && $2=="device"' | grep -q .; then
    p=$(timeout 20 adb shell pm list packages 2>/dev/null | sed 's/package://' | grep -E '^org\.chromium\.webapk\.' | head -1)
    [ -n "$p" ] && printf '%s\n' "$p" > "$PWAFILE"
  fi
  printf '%s' "$p"
}
dsh_url() {
  local u=""
  [ -f "$URLFILE" ] && u=$(head -1 "$URLFILE" | tr -d '[:space:]')
  printf '%s' "${u:-http://127.0.0.1:8080/}"
}
adb_ready() { adb devices 2>/dev/null | awk 'NR>1 && $2=="device"' | grep -q .; }

PWA=$(pwa_pkg); FG=$(fg_pkg)
sayf "PWA pkg    : %s" "${PWA:-not found, dsh-browser-open has not written a cache yet}"
sayf "foreground : %s" "${FG:-bridge did not answer}"
sayf "adb        : %s" "$(adb_ready && echo connected || echo not connected)"
if [ "$PROBE" = 1 ]; then
  if [ "$FG" = "com.android.chrome" ]; then say "verdict     : the DSH window **is** in front (hosted by Chrome)"
  else say "verdict     : the foreground is not Chrome → the DSH window is not in front right now"; fi
  exit 0
fi

close_via_adb() {
  local ok=0
  if [ "$KEEP_CHROME" = 0 ]; then
    timeout 20 adb shell am force-stop com.android.chrome >/dev/null 2>&1 && ok=1 || ok=0
  fi
  [ -n "$PWA" ] && timeout 20 adb shell am force-stop "$PWA" >/dev/null 2>&1
  sleep 1
  [ "$(fg_pkg)" != "com.android.chrome" ] && return 0
  return 1
}

close_via_bridge() {
  local i prev
  if ! timeout 8 "$SOCK" ping --fast >/dev/null 2>&1; then
    say "   ✘ the bridge did not answer (--fast); cannot press keys through it"
    return 1
  fi
  # remember "which App you were using before closing": to borrow the Back key we must first pull the DSH window to the front,
  # and if we do not put it back you end up on the home screen (hit this on the real device). So we restore it afterwards (except Termux or the home screen).
  prev=$(fg_pkg)
  if [ "$prev" = "com.android.chrome" ]; then prev=""; fi
  # the window must be in front to receive the Back key
  if [ "$(fg_pkg)" != "com.android.chrome" ]; then
    say "   · bringing the DSH window to the front (so Back can be sent to it)"
    timeout 15 am start -a android.intent.action.VIEW -d "$(dsh_url)" ${PWA:+-p "$PWA"} >/dev/null 2>&1
    sleep 2
  fi
  # restore the previous App to the front
  restore_prev() {
    [ -z "$prev" ] && return 0
    case "$prev" in com.termux|com.bbk.launcher*|*launcher*) return 0 ;; esac
    timeout 12 am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p "$prev" >/dev/null 2>&1 \
      && sayf "   · brought %s back to the front" "$prev"
  }
  for i in 1 2 3 4 5 6; do
    if [ "$(fg_pkg)" != "com.android.chrome" ]; then
      sayf "   ✔ window closed (pressed Back %s times)" "$((i-1))"
      restore_prev
      return 0
    fi
    timeout 8 "$SOCK" key back >/dev/null 2>&1
    sleep 0.8
  done
  [ "$(fg_pkg)" != "com.android.chrome" ] && { say "   ✔ window closed (pressed Back 6 times)"; restore_prev; return 0; }
  say "   ✘ the window is still there after 6 Back presses — the page may be swallowing Back; with adb available adb closes it more cleanly"
  return 1
}

if [ "$DRY" = 1 ]; then
  sayf "· [dry] %s" "$(adb_ready && echo 'adb shell am force-stop com.android.chrome' || echo 'via bridge: bring to front + press Back repeatedly')"
  exit 0
fi

if adb_ready; then
  say "→ closing via adb"
  close_via_adb && { say "✔ closed (adb): the browser/PWA window is gone"; exit 0; }
  say "   adb closed it but Chrome is still in front → trying the bridge"
fi
say "→ closing via the bridge (accessibility)"
if close_via_bridge; then exit 0; fi
say "✘ could not close it. Alternatives: ① swipe it away from recents by hand; ② turn on wireless debugging once so I can close it with adb"
exit 1
