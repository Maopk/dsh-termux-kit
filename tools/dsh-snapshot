#!/data/data/com.termux/files/usr/bin/bash
# dsh-snapshot —— the practical everything-in-one-file tool (full snapshot / migrating to a new phone)
#
# Difference from dsh-backup:
#   dsh-backup   stores only **state** (sessions/settings/plugin list/notes), about 11-14MB, runs automatically on every DSH shutdown;
#   dsh-snapshot stores the **whole environment** (Termux prefix 2.6G + DSH runtime 495M + ~/.dsh + the ops layer I wrote),
#                about 1~1.5GB compressed — one command restores it on a new phone or a reinstall, with no online dependency install.
#
# Usage: 
#   dsh-snapshot                 # pack (excludes caches such as the pnpm store by default)
#   dsh-snapshot --with-store    # include the pnpm store (about 674MB); after restore it works fully offline
#   dsh-snapshot --out DIR       # set the output directory (default 备份/系统备份/)
#   dsh-snapshot --list          # list existing full snapshots
#   dsh-snapshot --verify FILE   # verify one snapshot only
#
# Restore (after installing the same Termux version; no root needed):
#   pkg install -y zstd
#   tar -I zstd -xf /sdcard/Download/dsh/备份/系统备份/dsh-full-*.tar.zst -C /
#   bash ~/.shortcuts/tasks/1_start-dsh.sh
set -u

HOME_DIR="/data/data/com.termux/files/home"
PREFIX_DIR="/data/data/com.termux/files/usr"
# 2026-09-27 change: full snapshots go into 备份/系统备份/, separate from the automatic state backups (dsh-state-*) —
#   it used to land directly in the 备份/ root next to an empty 系统备份/ subdirectory, which looked like a mistake.
DEST="${DSH_BACKUP_DEST:-$HOME_DIR/storage/downloads/dsh/备份/系统备份}"
STAMP="$(date '+%Y%m%d-%H%M%S')"
NAME="dsh-full-${STAMP}.tar.zst"
KEEP="${DSH_SNAPSHOT_KEEP:-3}"        # full snapshots are big: keep only the newest 3 by default
META_DIR="$HOME_DIR/.snapshot-meta"   # temp dir, deleted after packing (its contents go into META/ inside the archive)

WITH_STORE=0; OUT="$DEST"; VERIFY_ONLY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --with-store) WITH_STORE=1 ;;
    --out) OUT="$2"; shift ;;
    --list) ls -lh "$DEST"/dsh-full-*.tar.zst 2>/dev/null || echo "(no full snapshot yet)"; exit 0 ;;
    --verify) VERIFY_ONLY="$2"; shift ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1"; exit 2 ;;
  esac
  shift
done

ZSTD="$(command -v zstd 2>/dev/null || true)"
[ -x "$ZSTD" ] || ZSTD="$PREFIX_DIR/glibc/bin/zstd"
[ -x "$ZSTD" ] || { echo "✘ zstd not found (pkg install zstd)"; exit 1; }

T0=$(date +%s)
say() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }
human() { numfmt --to=iec "$1" 2>/dev/null || echo "$1 B"; }

# ── verify: read the whole stream (zstd has a CRC, so reading it through means the data is intact) + entry count + sha256 ──
verify() {
  local f="$1"
  [ -f "$f" ] || { echo "   ✘ file does not exist: $f"; return 1; }
  sayf "verifying %s" "$(basename "$f") ($(human "$(stat -c%s "$f")"))…"
  # zstd -t decompresses the whole stream and checks CRC/length: truncation or corruption always gives non-zero
  if ! "$ZSTD" -t "$f" >/dev/null 2>&1; then
    echo "   ✘ integrity check failed (the compressed stream is truncated or corrupt)"; return 1
  fi
  local n; n=$("$ZSTD" -dc "$f" 2>/dev/null | tar -tf - 2>/dev/null | wc -l)
  if [ "$n" -lt 1000 ]; then echo "   ✘ archive looks wrong: only $n entries"; return 1; fi
  echo "   ✔ integrity passed (zstd -t exit 0), with $n entries"
  echo "   sha256: $(sha256sum "$f" | cut -c1-32)…"
  return 0
}
if [ -n "$VERIFY_ONLY" ]; then verify "$VERIFY_ONLY"; exit $?; fi

ARCHIVE="$OUT/$NAME"
PART="${ARCHIVE}.part"
mkdir -p "$OUT" "$HOME_DIR/.smoke"

# ── first write the restore instructions + manifest into a temp dir that is packed into the archive ──
rm -rf "$META_DIR"; mkdir -p "$META_DIR/META"
{
  echo "# DSH full snapshot · restore instructions"
  echo
  echo "generated: $(date '+%F %T')"
  echo "source device: $(getprop ro.product.model 2>/dev/null) / Android $(getprop ro.build.version.release 2>/dev/null) / $(getprop ro.product.cpu.abi 2>/dev/null)"
  echo "pnpm store: $([ "$WITH_STORE" = 1 ] && echo 'included (dependencies can be reinstalled offline)' || echo 'not included (the next pnpm install needs network)')"
  echo
  echo "## Restore steps (install the same Termux version first; no root needed)"
  echo '```bash'
  echo "pkg install -y zstd"
  echo "tar -I zstd -xf <this file> -C /"
  echo "bash ~/.shortcuts/tasks/1_start-dsh.sh"
  echo '```'
  echo
  echo "## Notes"
  echo "- the archive holds only absolute /data/data/com.termux/... paths; owner is recorded as 0 and unpacks as the current Termux UID when not root."
  echo "- excluded: storage/ (your phone storage), ~/.smoke (cache), ~/.npm, ~/.cache, ~/.dsh/profiles.bak-*."
  echo "- ⚠ credentials (.credentials.yaml, bridge token) are **inside the archive** — this is a full snapshot, so treat it as a sensitive file."
} > "$META_DIR/META/RESTORE.md"
{
  echo "generated: $(date '+%F %T')"
  echo
  echo "== size of each part =="
  du -sh "$PREFIX_DIR" "$HOME_DIR/.dsh" "$HOME_DIR/.local/opt/dsh-termux-runtime" \
        "$HOME_DIR/.local/bin" "$HOME_DIR/.local/share/dsh-widgets" "$HOME_DIR/.shortcuts" 2>/dev/null
  echo
  echo "== key versions =="
  echo "node: $(node -v 2>/dev/null)"
  echo "dsh : $(dsh --version 2>/dev/null | tail -1)"
  echo "python: $(python3 -V 2>/dev/null)"
} > "$META_DIR/META/MANIFEST.txt"

EXCLUDES=(
  "--exclude=home/.npm"
  "--exclude=home/.cache"
  "--exclude=home/.dsh/cache"
  "--exclude=home/.dsh/profiles.bak-*"
  "--exclude=home/.smoke"
  "--exclude=home/storage"
  # Note: do not exclude home/.snapshot-meta — tar --exclude applies to command-line members too,
  # so it would drop the META/ we want to pack (we hit this)
  "--exclude=*/tmp/*"
  "--exclude=*.sock"
)
[ "$WITH_STORE" = 1 ] || EXCLUDES+=("--exclude=home/.local/share/pnpm")

say "① packing (zstd -T0 -3; about 3.9GB of source, a few minutes)"
sayf "   output: %s" "$ARCHIVE"
sayf "   pnpm store: %s" "$([ "$WITH_STORE" = 1 ] && echo 'included' || echo 'excluded (--with-store includes it)')"

cd / || exit 1
# record owner/group as 0: the Termux UID is assigned at install time, and recording 0 lets the current UID unpack it after a phone swap
nice -n 10 tar \
  --owner=0 --group=0 --numeric-owner \
  --warning=no-file-changed --warning=no-file-ignored \
  "${EXCLUDES[@]}" \
  -I "$ZSTD -T0 -3 -q" \
  -cf "$PART" \
  data/data/com.termux/files/usr \
  data/data/com.termux/files/home/.dsh \
  data/data/com.termux/files/home/.local/opt/dsh-termux-runtime \
  data/data/com.termux/files/home/.local/bin \
  data/data/com.termux/files/home/.local/share/dsh-widgets \
  data/data/com.termux/files/home/.shortcuts \
  data/data/com.termux/files/home/.bashrc \
  data/data/com.termux/files/home/.termux \
  data/data/com.termux/files/home/droid-bridge \
  data/data/com.termux/files/home/.clash-opt \
  data/data/com.termux/files/home/DSH运维笔记.md \
  data/data/com.termux/files/home/.snapshot-meta \
  2> "$HOME_DIR/.smoke/snapshot-warn.log"
RC=$?
rm -rf "$META_DIR"
# GNU tar: 0=fully fine, 1=a file changed while being read (DSH is writing sessions/logs, normal), ≥2=fatal
if [ "$RC" -ge 2 ]; then
  echo "✘ tar exit code $RC (fatal)"; tail -3 "$HOME_DIR/.smoke/snapshot-warn.log" 2>/dev/null
  rm -f "$PART"; exit 1
fi
[ "$RC" = 1 ] && say "   ⚠ tar reported files changed while being read (DSH is writing sessions) — the archive is still intact; see the verification step"
mv -f "$PART" "$ARCHIVE"

say "② verify (read it all back; zstd checks the CRC)"
verify "$ARCHIVE" || { echo "✘ verification failed → deleting this untrustworthy archive"; rm -f "$ARCHIVE"; exit 1; }

sayf "③ retention (full snapshots keep only the newest %s)" "$KEEP"
ls -1t "$OUT"/dsh-full-*.tar.zst 2>/dev/null | tail -n +$((KEEP+1)) | while read -r f; do
  rm -f "$f" && sayf "   deleting old snapshot %s" "$(basename "$f")"
done

SZ=$(stat -c%s "$ARCHIVE")
sayf "④ done in %ss" "$(( $(date +%s) - T0 ))"
echo
echo "   snapshot: $ARCHIVE"
echo "   size: $(human "$SZ") (about 3.9GB of source data)"
echo "   restore: tar -I zstd -xf \"$ARCHIVE\" -C /"
