#!/data/data/com.termux/files/usr/bin/bash
# DSH opener — open in the standalone DSH window installed on the home screen (WebAPK), not a browser tab
#
# Three traps are handled here:
#   ① no default browser is set: both com.vivo.browser and the DSH WebAPK can handle http://127.0.0.1:8080/,
#      a bare VIEW intent pops a chooser → the vivo browser easily takes it. → the package must be named explicitly.
#   ② when Termux launches another App as an app it **can be silently blocked** by Android background start limits
#      (it only prints "Starting: Intent …" with no result). → with adb available it always launches through adb (the shell identity has no such limit).
#      ⚠ 2026-09-28 更正：这不是铁律，而是**概率性**的。实测（那时 Termux 持着 termux-wake-lock 前台服务）
#        后台的 `am start` 成功把 WebAPK 窗口拉到了前台 —— "关闭 DSH 会跳到 WebAPK 界面"就是这么发生的；
#        同一天 `dsh web` 自己开浏览器也是从后台发出去的，页面确实出现了（用户看到的就是它）。
#        所以：别把这条当成"一定发不出去"的借口（我因此写过一句跟事实相反的日志）；
#        也别指望它一定发得出去 —— 要稳，仍然走 adb。
#   ③ a WebAPK upgrade changes the package name (with a _vN suffix) → a stale cached name is rediscovered automatically.
#
# Usage: dsh-browser-open <url> [--quiet]
URL="${1:?Usage: dsh-browser-open <url>}"
QUIET=0; [ "${2:-}" = "--quiet" ] && QUIET=1
PWAFILE="$HOME/.dsh-pwa"
say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }

SERIAL=""
if command -v adb >/dev/null 2>&1; then
  SERIAL=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1; exit}')
fi

start_activity() {   # $1 = package name (may be empty)
  local pkg="${1:-}" out
  if [ -n "$SERIAL" ]; then
    if [ -n "$pkg" ]; then out=$(timeout 25 adb -s "$SERIAL" shell am start -W -a android.intent.action.VIEW -d "$URL" -p "$pkg" 2>&1)
    else out=$(timeout 25 adb -s "$SERIAL" shell am start -W -a android.intent.action.VIEW -d "$URL" 2>&1); fi
    printf '%s' "$out" | grep -qE 'Status: ok'
  else
    if [ -n "$pkg" ]; then out=$(am start -a android.intent.action.VIEW -d "$URL" -p "$pkg" 2>&1)
    else out=$(am start -a android.intent.action.VIEW -d "$URL" 2>&1); fi
    printf '%s' "$out" | grep -qE 'Status: ok|Starting: Intent'
  fi
}

discover_pwa() {
  local d="$SERIAL" p=""
  if [ -n "$d" ]; then
    p=$(timeout 25 adb -s "$d" shell cmd package query-activities -a android.intent.action.VIEW -d "$URL" 2>/dev/null \
        | grep -oE 'packageName=org\.chromium\.webapk\.[A-Za-z0-9._-]+' | head -1 | cut -d= -f2)
    [ -z "$p" ] && p=$(timeout 25 adb -s "$d" shell pm list packages 2>/dev/null \
        | grep -oE 'org\.chromium\.webapk\.[A-Za-z0-9._-]+' | head -1)
  fi
  [ -z "$p" ] && p=$(pm list packages 2>/dev/null | sed 's/package://' | grep -E '^org\.chromium\.webapk\.' | head -1)
  [ -n "$p" ] && printf '%s\n' "$p" > "$PWAFILE"
  printf '%s' "$p"
}

try_pwa() {
  [ -z "$1" ] && return 1
  start_activity "$1" || return 1
  say "✔ opened in the standalone DSH window ($1${SERIAL:+ · via adb})"
  return 0
}

PWA=""
[ -f "$PWAFILE" ] && PWA=$(head -1 "$PWAFILE" | tr -d '[:space:]')
if try_pwa "$PWA"; then exit 0; fi
PWA="$(discover_pwa)"
if try_pwa "$PWA"; then exit 0; fi

say "⚠ could not open the standalone DSH window (PWA package missing or blocked); falling back to Chrome"
if start_activity "com.android.chrome"; then say "✔ opened in Chrome (a normal tab)"; exit 0; fi

say "⚠ Chrome is unavailable too; handing over to the system default (a chooser may pop up)"
if [ -n "$SERIAL" ]; then adb -s "$SERIAL" shell am start -a android.intent.action.VIEW -d "$URL" >/dev/null 2>&1; exit 0; fi
exec termux-open-url "$URL"
