#!/data/data/com.termux/files/usr/bin/bash
# DSH 打开器 —— 在桌面安装的「DSH」独立窗口（WebAPK）里打开，而不是浏览器标签
#
# 三个坑都在这里处理掉了：
#   ① 系统没有默认浏览器：com.vivo.browser 与 DSH 的 WebAPK 都能处理 http://127.0.0.1:8080/，
#      裸 VIEW 意图会弹选择框 → 容易被 vivo 浏览器接走。→ 必须「点名包」。
#   ② Termux 以应用身份启动别的 App 会被 Android 后台启动限制**静默拦掉**
#      （只打印 "Starting: Intent …" 却没有结果）。→ 有 adb 时一律经 adb 启动（shell 身份无此限制）。
#   ③ WebAPK 升级会改包名（带 _vN 后缀）→ 缓存的包名失效时自动重新发现。
#
# 用法：dsh-browser-open <url> [--quiet]
URL="${1:?用法: dsh-browser-open <url>}"
QUIET=0; [ "${2:-}" = "--quiet" ] && QUIET=1
PWAFILE="$HOME/.dsh-pwa"
say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }

SERIAL=""
if command -v adb >/dev/null 2>&1; then
  SERIAL=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1; exit}')
fi

start_activity() {   # $1 = 包名（可空）
  local pkg="${1:-}" out
  if [ -n "$SERIAL" ]; then
    if [ -n "$pkg" ]; then out=$(timeout 25 adb -s "$SERIAL" shell am start -W -a android.intent.action.VIEW -d "$URL" -p "$pkg" 2>&1)
    else out=$(timeout 25 adb -s "$SERIAL" shell am start -W -a android.intent.action.VIEW -d "$URL" 2>&1); fi
    printf '%s' "$out" | grep -qE 'Status: ok'
  else
    if [ -n "$pkg" ]; then out=$(am start -a android.intent.action.VIEW -d "$URL" -p "$pkg" 2>&1)
    else out=$(am start -a android.intent.action.VIEW -d "$URL" 2>&1); fi
    printf '%s' "$out" | grep -qE 'Status: ok|Starting: Intent'
  fi
}

discover_pwa() {
  local d="$SERIAL" p=""
  if [ -n "$d" ]; then
    p=$(timeout 25 adb -s "$d" shell cmd package query-activities -a android.intent.action.VIEW -d "$URL" 2>/dev/null \
        | grep -oE 'packageName=org\.chromium\.webapk\.[A-Za-z0-9._-]+' | head -1 | cut -d= -f2)
    [ -z "$p" ] && p=$(timeout 25 adb -s "$d" shell pm list packages 2>/dev/null \
        | grep -oE 'org\.chromium\.webapk\.[A-Za-z0-9._-]+' | head -1)
  fi
  [ -z "$p" ] && p=$(pm list packages 2>/dev/null | sed 's/package://' | grep -E '^org\.chromium\.webapk\.' | head -1)
  [ -n "$p" ] && printf '%s\n' "$p" > "$PWAFILE"
  printf '%s' "$p"
}

try_pwa() {
  [ -z "$1" ] && return 1
  start_activity "$1" || return 1
  say "✔ 已在 DSH 独立窗口打开（$1${SERIAL:+ · 经 adb}）"
  return 0
}

PWA=""
[ -f "$PWAFILE" ] && PWA=$(head -1 "$PWAFILE" | tr -d '[:space:]')
if try_pwa "$PWA"; then exit 0; fi
PWA="$(discover_pwa)"
if try_pwa "$PWA"; then exit 0; fi

say "⚠ 没能在 DSH 独立窗口打开（PWA 包未找到或被拦），改用 Chrome"
if start_activity "com.android.chrome"; then say "✔ 已在 Chrome 打开（普通标签页）"; exit 0; fi

say "⚠ Chrome 也不可用，交给系统默认（可能弹选择框）"
if [ -n "$SERIAL" ]; then adb -s "$SERIAL" shell am start -a android.intent.action.VIEW -d "$URL" >/dev/null 2>&1; exit 0; fi
exec termux-open-url "$URL"
