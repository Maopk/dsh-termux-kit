#!/data/data/com.termux/files/usr/bin/bash
# dsh-gh —— small tool to maintain the GitHub repo `Maopk/dsh-termux-kit` (uses the token in ~/.dsh-gh-token)
#
# Usage: 
#   dsh-gh status                     show repo/release status (public info works without a token, but the token is sent to see private data)
#   dsh-gh push [commit message]             commit local changes and push (with no message it only pushes existing commits)
#   dsh-gh release <tag> <title> <files...> [--notes-file FILE]
#                                    create a release and upload assets (**asset names must be ASCII**, see below)
#                                    --notes-file：发行说明正文（Markdown）。不写也行，但发行版页面上就只剩标题。
#   dsh-gh revoke-hint                print how to revoke the token properly (**deleting the file is not enough**)
#
# ⚠ Two traps we hit (recorded here so they are not repeated):
#   1) asset names **must be ASCII**: the GitHub assets upload API mangles Chinese names into "DSH.-v1.1.apk".
#      This script converts Chinese names to translit style (DSH控制台-v1.1.apk → dsh-console-v1.1.apk, which the caller supplies).
#   2) just `rm ~/.dsh-gh-token` does **not** invalidate the token: the GitHub authorization remains, so you must go
#      Settings → Applications → Authorized OAuth Apps → GitHub CLI → Revoke.
set -u
TOKFILE="$HOME/.dsh-gh-token"
REPO="Maopk/dsh-termux-kit"
LOCAL="$HOME/dsh-termux-kit"
API="https://api.github.com"

tok() { [ -s "$TOKFILE" ] || { printf '✘ no %s (run the device-code authorization once first)\n' "$TOKFILE" >&2; exit 3; }; cat "$TOKFILE"; }

case "${1:-status}" in
  status)
    T=""; [ -s "$TOKFILE" ] && T=$(cat "$TOKFILE")
    if [ -n "$T" ]; then
      curl -s -H "Authorization: token $T" "$API/repos/$REPO" | python3 -c "
import json,sys;d=json.load(sys.stdin)
print('repo   :',d.get('full_name'),'| public:',not d.get('private'),'| branch:',d.get('default_branch'))
print('pushed:',d.get('pushed_at'),'| size:',d.get('size'),'KB')"
      curl -s -H "Authorization: token $T" "$API/repos/$REPO/releases" | python3 -c "
import json,sys
rs=json.load(sys.stdin)
for r in (rs if isinstance(rs,list) else []):
    print('release:',r['name'],'| tag',r['tag_name'])
    for a in r['assets']: print('   ·',a['name'],'%.1f KB'%(a['size']/1024),'downloads',a['download_count'])"
    else
      curl -s "$API/repos/$REPO" | python3 -c "import json,sys;d=json.load(sys.stdin);print('repo   :',d.get('full_name'),'| public:',not d.get('private'))"
      printf '(no token, so only public info was read)\n'
    fi ;;

  push)
    T=$(tok); cd "$LOCAL" || exit 4
    MSG="${2:-}"
    if [ -n "$(git status --porcelain)" ]; then
      [ -n "$MSG" ] || { printf '✘ there are uncommitted changes; give a commit message: dsh-gh push "message"\n' >&2; exit 2; }
      git add -A && git -c core.quotepath=false commit -q -m "$MSG" || exit 5
      printf '＋ committed: %s\n' "$MSG"
    fi
    git -c credential.helper= push "https://x-access-token:$T@github.com/$REPO.git" HEAD:refs/heads/master && printf '✔ pushed\n' ;;

  release)
    T=$(tok); TAG="${2:?Usage: dsh-gh release <tag> <title> <files...> [--notes-file FILE]}"; NAME="${3:?missing title}"; shift 3
    # --notes-file 单独摘出来：正文里会有引号/换行/中文，手拼 JSON 一定出事（拼错过一次就够）
    NOTES=""; ARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --notes-file) shift; NOTES="${1:-}" ;;
        *) ARGS+=("$1") ;;
      esac
      shift
    done
    [ "${#ARGS[@]}" -gt 0 ] || { printf '✘ give at least one asset file\n' >&2; exit 2; }
    set -- "${ARGS[@]}"
    [ -z "$NOTES" ] || [ -f "$NOTES" ] || { printf '✘ --notes-file %s does not exist\n' "$NOTES" >&2; exit 2; }
    PAYLOAD=$(python3 - "$TAG" "$NAME" "$NOTES" <<'PYEOF'
import json, sys
tag, name = sys.argv[1], sys.argv[2]
body = ''
if len(sys.argv) > 3 and sys.argv[3]:
    with open(sys.argv[3], encoding='utf-8') as fh:
        body = fh.read()
print(json.dumps({'tag_name': tag, 'target_commitish': 'master', 'name': name, 'body': body},
                 ensure_ascii=False))
PYEOF
)
    RID=$(curl -s -X POST "$API/repos/$REPO/releases" -H "Authorization: token $T" \
          -H 'Accept: application/vnd.github+json' -H 'Content-Type: application/json' \
          --data-binary "$PAYLOAD" \
          | python3 -c "import json,sys;d=json.load(sys.stdin);print(d.get('id',''))")
    [ -n "$RID" ] || { printf '✘ failed to create the release\n' >&2; exit 5; }
    printf 'release created: %s/releases/tag/%s\n' "https://github.com/$REPO" "$TAG"
    for f in "$@"; do
      n=$(basename "$f")
      case "$n" in *[!\ -~]*) printf '⚠ asset name contains non-ASCII (%s) → GitHub will mangle it; rename it to ASCII first\n' "$n";; esac
      code=$(curl -s -o /dev/null -w '%{http_code}' -X POST \
        "https://uploads.github.com/repos/$REPO/releases/$RID/assets?name=$n" \
        -H "Authorization: token $T" -H 'Content-Type: application/octet-stream' --data-binary @"$f")
      printf '  %-28s → %s\n' "$n" "$code"
    done ;;

  revoke-hint)
    cat <<'EOF'
How to revoke the token properly (**deleting the file is not enough**):
  1) open https://github.com/settings/applications → Authorized OAuth Apps
  2) find GitHub CLI → Revoke
  3) then delete the local file: rm ~/.dsh-gh-token
Also: the token scope repo = read/write on **every repo you own**, not just this project — so do not copy it elsewhere or commit it.
EOF
    ;;

  *) sed -n '2,12p' "$0"; exit 2 ;;
esac
