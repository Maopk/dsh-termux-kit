#!/data/data/com.termux/files/usr/bin/python3
"""Verify a translation patch before it is merged into i18n/zh.json.

A patch written by hand (or by a helper) can fail in four quiet ways, and every one of them
reaches the user's screen as either English or a broken line:

  1. a key that does not exist in the source — the entry is dead weight and hides a typo
  2. a key that was retyped instead of copied — one changed space and the lookup never matches
  3. a lost printf placeholder (%s / %d) — the line prints with a missing value
  4. a lost variable or escape ($VAR, $(...), \n) — the line prints a literal "$VAR" or \n

Usage: verify-patch.py <patch.json> <missing-strings.json>
Exit 0 only when every check passes.
"""
import json
import re
import sys

PLACEHOLDER = re.compile(r'%[sd]|%%')
SHELLVAR = re.compile(r'\$[A-Za-z_{(]')
ESCAPE = re.compile(r'\\[ntr]')


def main():
    patch = json.load(open(sys.argv[1], encoding='utf-8'))
    allowed = set(json.load(open(sys.argv[2], encoding='utf-8')))
    problems = []

    for k, v in patch.items():
        if k not in allowed:
            problems.append(f'❌ 键不在待翻清单里（多半是重新手打导致对不上）: {k!r}')
            continue
        if not isinstance(v, str) or not v.strip():
            problems.append(f'❌ 空译文: {k!r}')
            continue
        if '\n' in v or '\t' in v:
            problems.append(f'❌ 译文里有真实换行/制表符（必须是 \\n 两字符）: {k!r}')
        for name, rx in (('%s/%d 占位符', PLACEHOLDER), ('shell 变量', SHELLVAR), ('转义 \\n 等', ESCAPE)):
            a, b = sorted(rx.findall(k)), sorted(rx.findall(v))
            if a != b:
                problems.append(f'❌ {name} 对不上: {k!r} 有 {a}，译文有 {b}')

    print(f'补丁 {len(patch)} 条；清单 {len(allowed)} 条；覆盖率 {len(patch)}/{len(allowed)}')
    if problems:
        for p in problems:
            print('  ' + p)
        print(f'\n❌ {len(problems)} 个问题，不要合并')
        return 1
    print('✅ 键完全匹配、占位符/变量/转义都保住了')
    return 0


if __name__ == '__main__':
    sys.exit(main())
