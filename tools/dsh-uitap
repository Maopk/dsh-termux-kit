#!/data/data/com.termux/files/usr/bin/python3
"""dsh-uitap —— tap widgets by text in any App through the DSH bridge, scrolling automatically when needed.

Why: the bridge ui dump gives **content coordinates**, and on long pages the target is often off screen (say y=5339
while the screen is only 2976 tall), so a direct tap hits nothing. This tool scrolls until the target is visible, then taps.

Usage: 
  dsh-uitap "Name Server"        # scroll to that text and tap it
  dsh-uitap "不修改" --nth 3      # the 3rd match (the same word often appears many times)
  dsh-uitap --list               # list only the currently visible widgets (marked on screen or not)
  dsh-uitap --set "value"           # type text into the currently focused input (use after a tap)
Options:
  --contains    match text by contains rather than exact equality
  --no-tap      report coordinates only, do not tap
"""
import os
import re
import subprocess
import sys
import time

SOCK = os.path.expanduser('~/.local/bin/droid-sock')
SCREEN_H = 2976          # height of this phone; the h from ping would work too, but a fixed value is enough and saves a call
SAFE_TOP = 420           # top of the content area: the title bar at y≈247 is often covered by a stale off-screen copy, so it must be excluded
SAFE_BOTTOM = 2500       # above the bottom gesture area


def sh(*args, timeout=45):
    return subprocess.run(list(args), capture_output=True, text=True, timeout=timeout).stdout


def dump(kw=''):
    """Return [{x,y,cls,text,desc}]; the coordinates are content coordinates."""
    out = sh(SOCK, 'ui', kw)
    nodes = []
    for line in out.splitlines():
        m = re.match(r"\s*\[(-?\d+),(-?\d+)\]\s+(\S+)\s+text=(.*?)\s+desc=(.*?)\s+id=", line)
        if m:
            nodes.append({
                'x': int(m.group(1)), 'y': int(m.group(2)), 'cls': m.group(3),
                'text': m.group(4).strip().strip("'"), 'desc': m.group(5).strip().strip("'"),
            })
    return nodes


def swipe(x1, y1, x2, y2, ms=300):
    sh(SOCK, 'swipe', str(x1), str(y1), str(x2), str(y2), str(ms), timeout=30)


def visible(y):
    return SAFE_TOP <= y <= SAFE_BOTTOM


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 2
    if args[0] == '--list':
        for n in dump():
            mark = '✔ on screen' if visible(n['y']) else '  off screen'
            print('  %s [%5d,%5d] %-16s %s' % (mark, n['x'], n['y'], n['cls'], n['text'][:48]))
        return 0
    if args[0] == '--set':
        val = args[1] if len(args) > 1 else ''
        r = sh(SOCK, 'text', val, timeout=60)
        print('wrote: %s -> %s' % (val[:40], r.strip()[:80]))
        return 0

    target = args[0]
    contains = '--contains' in args
    no_tap = '--no-tap' in args
    nth = 1
    if '--nth' in args:
        nth = int(args[args.index('--nth') + 1])

    for attempt in range(14):
        nodes = dump(target)
        # Match both text and desc: many buttons are an icon + contentDescription (such as 「新建」 or 「保存」)
        if contains:
            hits = [n for n in nodes if target in n['text'] or target in n['desc']]
        else:
            hits = [n for n in nodes if n['text'] == target or n['desc'] == target]
        if hits:
            # the accessibility tree often holds a "stale off-screen copy" at the same time (its coordinates may be negative or far down),
            # so sort by "closest to the viewport center" first, to avoid scrolling the wrong way (measured: it scrolls further and further away).
            center = (SAFE_TOP + SAFE_BOTTOM) // 2
            hits.sort(key=lambda n: abs(n['y'] - center))
            if nth <= len(hits):
                n = hits[nth - 1]
                if visible(n['y']):
                    if no_tap:
                        print('found (not tapped): %s @ [%d,%d]' % (target, n['x'], n['y']))
                        return 0
                    r = sh(SOCK, 'tap', str(n['x']), str(n['y']), timeout=30)
                    print('tapped: %s @ [%d,%d]  %s' % (target, n['x'], n['y'], r.strip()[:60]))
                    time.sleep(1.2)
                    return 0
                # the target is off screen: scroll in the matching direction
                if n['y'] > SAFE_BOTTOM:
                    swipe(720, 2300, 720, 800)      # content moves up
                else:
                    swipe(720, 800, 720, 2300)      # content moves down (back to the top)
            else:
                swipe(720, 2300, 720, 800)          # not enough matches; keep looking further down
        else:
            swipe(720, 2300, 720, 800)
        time.sleep(0.8)
    print('✘ not found or not tappable: %s' % target)
    return 1


if __name__ == '__main__':
    sys.exit(main())
