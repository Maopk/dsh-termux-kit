#!/data/data/com.termux/files/usr/bin/bash
# dsh-control —— remote-control the DSH page through the self-look plugin (dsh-selflook-local)
# Usage: 
#   dsh-control probe <keyword>             list matching elements (pierces shadow DOM)
#   dsh-control click text=<text>          tap the first visible element whose own text matches
#   dsh-control click selector=<CSS selector> tap by selector
#   dsh-control click x,y                  tap by coordinate
#   dsh-control swipe <from> <to> [steps] swipe gesture (selector / x,y / text=<text>)
#   dsh-control scroll <selector> top|bottom|by|to [value] [shot]
#   dsh-control capture                    screenshot (falls back to a text snapshot if that fails)
#   dsh-control eval '<js expression>'         evaluate in the page and return the result
#   dsh-control '<raw JSON command>'         send it straight through
# Optional env var: TIMEOUT=seconds (default 30)
set -u
CMD="$HOME/.dsh-look-cmd.json"
RES="$HOME/.dsh-look-cmd-result.json"
TIMEOUT="${TIMEOUT:-30}"

build_json() {
  python3 - "$@" <<'PY'
import json, sys, re
a = sys.argv[1:]
kind = a[0] if a else ''
rest = a[1:]

def spec(s):
    """selector / x,y coordinate / text=<text> → gesture start and end"""
    if s.startswith('text='):
        return {'text': s[5:]}
    if re.match(r'^-?\d+\s*,\s*-?\d+$', s):
        return [int(x) for x in s.split(',')]
    return s

if kind == 'probe':
    cmd = {"action": "probe", "keyword": rest[0] if rest else "", "limit": 30}
elif kind == 'click':
    spec0 = rest[0] if rest else ''
    cmd = {"action": "click", "after": True, "waitMs": 800}
    if spec0.startswith('text='):
        cmd["text"] = spec0[5:]
    elif spec0.startswith('selector='):
        cmd["selector"] = spec0[9:]
    elif spec0.startswith('title='):
        cmd["title"] = spec0[6:]
    elif ',' in spec0 and all(p.strip().lstrip('-').isdigit() for p in spec0.split(',')[:2]):
        x, y = spec0.split(',')[:2]
        cmd["x"], cmd["y"] = int(x), int(y)
    else:
        cmd["text"] = spec0
elif kind == 'swipe':
    if len(rest) < 2:
        print('Usage: dsh-control swipe <from> <to> [steps]  (selector / x,y / text=<text>)', file=sys.stderr)
        sys.exit(2)
    cmd = {"action": "swipe", "from": spec(rest[0]), "to": spec(rest[1]), "steps": int(rest[2]) if len(rest) > 2 else 16}
elif kind == 'scroll':
    cmd = {"action": "scroll", "selector": rest[0] if rest else 'window', "mode": rest[1] if len(rest) > 1 else 'bottom'}
    if len(rest) > 2 and rest[2] not in ('shot',):
        cmd["value"] = int(rest[2])
    if 'shot' in rest:
        cmd["capture"] = True
elif kind == 'capture':
    cmd = {"action": "capture"}
elif kind == 'eval':
    cmd = {"action": "eval", "code": rest[0] if rest else '1'}
elif kind.startswith('{'):
    cmd = json.loads(kind)
else:
    print('unknown usage', file=sys.stderr); sys.exit(2)
print(json.dumps(cmd, ensure_ascii=False))
PY
}

if [ $# -eq 0 ]; then sed -n '2,12p' "$0"; exit 2; fi

JSON="$(build_json "$@")" || exit 2
[ -z "$JSON" ] && { echo "failed to build the command"; exit 2; }

# remember the old result fingerprint
BEFORE="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"

# atomic command file write (write a temp file then mv, so the client never reads half a file)
printf '%s' "$JSON" > "$CMD.tmp" && mv "$CMD.tmp" "$CMD"

# wait for the result
DEADLINE=$(( $(date +%s) + TIMEOUT ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  sleep 1
  AFTER="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
  if [ -n "$AFTER" ] && [ "$AFTER" != "$BEFORE" ]; then
    echo "command: $JSON"
    echo "--- result ---"
    cat "$RES"
    exit 0
  fi
done

echo "command: $JSON"
echo "⏱ timeout ${TIMEOUT}s: the page may be closed, not refreshed to the new client, or the command was never consumed"
echo "current command file contents: $(cat "$CMD" 2>/dev/null | head -c 200)"
exit 1
