#!/data/data/com.termux/files/usr/bin/bash
# dsh-install-apk —— install an APK through the vivo installer (bridge + the stored password throughout; no adb, no hands)
#
# Why: on this phone, installing from Termux **always** has to go through
#   the 「超级守护」 screen → tap the small blue text 「…您可授权本次安装」 → the system 「安全验证」
#   → fingerprint, or 「锁屏密码验证」 + the 6-digit keypad.
# The manual step is replaced by the 6 digits in ~/.dsh-auth-pass (600, meaning "the AI may use your lockscreen password").
# **To revoke**: the 『撤销安装密码授权』 entry under 「紧急」 in the Console App / widget 9 / or rm that file.
#
# Usage: dsh-install-apk <apk path> [--verify] [--dry-run]
#   --verify after installing, open the same APK again and confirm the installer says 「已安装相同版本」 (the hardest evidence, costs ~15s more)
# Exit: 0 success; 1 failure; 3 not authorized (run dsh-auth-pass set first); 4 preconditions unmet
set -u
HOME_DIR="/data/data/com.termux/files/home"
SOCK="$HOME_DIR/.local/bin/droid-sock"
HELPER="$HOME_DIR/.local/bin/dsh-auth-pass"
# 临时副本：把源文件名净化成 ASCII 后**每个 APK 用不同的名字**。
#   ⚠ 两个坑都是实测踩出来的（2026-09-27）：
#   ① 不能以点开头：vivo 安装器对 `.dsh-install-tmp.apk` 直接弹「安装包不存在」，
#      同一份文件换成非隐藏名就能正常打开。
#   ② 不能所有 APK 共用一个固定名：安装器界面会被复用，第二次 `am start` 打开新包时
#      屏幕上仍是**上一个包**的页面（实测装完控制台再装桥，页面还写着「DSH Console（1.9）」，
#      于是桥被误判成"已安装相同版本"）。
DRY=0; VERIFY=0; APK=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --verify) VERIFY=1 ;;
    -*) printf 'unknown argument %s\n' "$1" >&2; exit 2 ;;
    *) APK="$1" ;;
  esac
  shift
done
[ -n "$APK" ] || { printf 'Usage: dsh-install-apk <apk path> [--verify] [--dry-run]\n' >&2; exit 2; }
[ -f "$APK" ] || { printf 'APK not found: %s\n' "$APK" >&2; exit 4; }

# One temp path **per APK**: the installer activity gets reused, so a shared fixed name makes
# the second run display the *previous* package (it then looks like "same version installed"
# for an APK that was never opened). The name is sanitised to ASCII because the source path
# may contain Chinese, which is the reason this copy exists at all.
safe_tmp() {
  local b; b=$(printf '%s' "$(basename "$1")" | tr -c 'A-Za-z0-9._-' '_')
  printf '/storage/emulated/0/Download/dsh-install-%s' "$b"
}
TMP_APK=$(safe_tmp "$APK")

log()  { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }

# 装包全程要屏幕亮着：中途息屏会让安装页被锁屏盖住，整轮白跑（真踩过）。所以进入时 keep、
# 退出时无论成败都 restore —— 装完之后屏幕设置必须回到你原来的样子。
SCREEN="$HOME_DIR/.local/bin/dsh-screen"
screen_keep()    { [ -x "$SCREEN" ] && "$SCREEN" keep >/dev/null 2>&1 || true; }
screen_restore() { [ -x "$SCREEN" ] && "$SCREEN" restore >/dev/null 2>&1 || true; }
if [ "$DRY" = 0 ]; then
  screen_keep
  trap screen_restore EXIT INT TERM
fi
step() { printf '\n▶ %s\n' "$*"; }
ok()   { printf '   ✔ %s\n' "$*"; }
warn() { printf '   ⚠ %s\n' "$*"; }
bad()  { printf '   ✘ %s\n' "$*"; }

ui()      { timeout 25 "$SOCK" ui 2>/dev/null; }
cur_pkg() { timeout 20 "$SOCK" cur 2>/dev/null | sed -n 's/.*"pkg": "\([^"]*\)".*/\1/p'; }
# find an element center by text or desc in the accessibility tree ($1=label $2=text|desc)
xy_of() {
  ui | awk -v w="$1" -v f="$2" '
    { key = (f=="desc" ? "desc=" : "text=") "\x27" w "\x27"
      if (index($0, key) > 0) { match($0, /\[[0-9]+,[0-9]+\]/); if (RSTART>0) { print substr($0,RSTART+1,RLENGTH-2); exit } } }'
}
tap_xy()  { timeout 25 "$SOCK" tap "${1%,*}" "${1#*,}" >/dev/null 2>&1; }
tap_txt() { local xy; xy=$(xy_of "$1" text);  [ -n "$xy" ] && { tap_xy "$xy"; return 0; }; return 1; }
tap_dsc() { local xy; xy=$(xy_of "$1" desc);  [ -n "$xy" ] && { tap_xy "$xy"; return 0; }; return 1; }
# some widgets carry their label in text, others in desc (hard-won: 『锁屏密码验证』 is text, 『本次允许使用权限』 is desc)
tap_any() { tap_txt "$1" || tap_dsc "$1"; }

# ── preconditions ──
# 上次点成功的位置（用户建议：直接点那个位置就行）—— 记下来，下次优先用它，省掉找蓝字
LAST_FILE="$HOME_DIR/.smoke/install-link-xy"
LAST_XY="$(cat "$LAST_FILE" 2>/dev/null || true)"

step "① precondition check"
DIGITS=""
if [ "$DRY" != 1 ]; then
  DIGITS=$("$HELPER" digits 2>/dev/null) || { bad "not authorized: $("$HELPER" status 2>&1)"; exit 3; }
  case "$DIGITS" in [0-9][0-9][0-9][0-9][0-9][0-9]) ok "got the authorized password (6 digits, from $("$HELPER" path))" ;;
    *) bad "bad password format (not 6 digits)"; exit 3 ;; esac
else
  # A dry run must tell the truth: with no authorization, say so — a real run will always stop here (otherwise "dry run passed" is a lie)
  if "$HELPER" status >/dev/null 2>&1; then
    ok "(dry-run) authorized: a real run can read the password"
  else
    bad "(dry-run) not authorized: $("$HELPER" status 2>&1 | head -1)"
    printf '   → a real run will stop here with exit code 3 and never touch the screen\n'
    exit 3
  fi
fi
"$SOCK" ping >/dev/null 2>&1 || { bad "the bridge is not there (run dsh-bridge wake first)"; exit 4; }
ok "the bridge answers"

# ── open the installer ──
step "② open the package (copied to an ASCII path to avoid Chinese-URI encoding problems)"
if [ "$DRY" = 1 ]; then
  printf '   · [dry] cp %s %s\n   · [dry] am start -a VIEW -d file://%s -t application/vnd.android.package-archive\n' "$APK" "$TMP_APK" "$TMP_APK"
  ok "(dry-run)"
else
  cp -f "$APK" "$TMP_APK" || { bad "copy failed"; exit 1; }
  timeout 25 am start -a android.intent.action.VIEW -d "file://$TMP_APK" \
    -t application/vnd.android.package-archive >/dev/null 2>&1
  # Wait for the installer to be **actually in front**, don't sleep a fixed 4s.
  # Why: am start returns as soon as the intent is dispatched; on this phone the installer
  # window can take ~10s to come up (measured 2026-09-27: the old `sleep 4` let every later
  # tap land on whatever was on screen before — the taps "had no reaction" and the wizard was
  # reported as unreachable, while the installer was in fact arriving normally).
  UP=0
  for i in $(seq 1 20); do
    sleep 1
    if "$SOCK" cur 2>/dev/null | grep -qE 'packageinstaller|permissioncontroller|vivo.*install'; then UP=$i; break; fi
  done
  [ "$UP" != 0 ] && ok "installer is in front (took ${UP}s)" || { bad "the installer never came to the front within 20s"; exit 4; }
fi

# ── the one and only step that needs the screen: tap the blue 「授权本次安装」 ──
#
# 用户给的配方（2026-09-27，他用得比我快，所以照他的来）：
#   等 5 秒 → 直接点那个位置 → 点「锁屏密码验证」 → 输密码 → 完事
#
# 我原来的做法是**反复转储无障碍树**去找那段话、再按颜色扫波段，一次要一两分钟，还经常找不到 ——
# 因为那行字**根本不在树里**（整段话只有一个节点），而每次 `ui` 转储都要好几秒。
# 现在改成：**只截一张图**按颜色找一次，找不到就退回到"上次成功的坐标"（存在文件里）。
# 这样正常情况下 5 秒等待 + 一次截图 + 一次点击就过去了。
step "③ already installed? then this is a no-op"
ALREADY=0
for _ in $(seq 1 10); do
  ui | grep -q '已安装相同版本' && { ALREADY=1; break; }
  sleep 1
done
if [ "$ALREADY" = 1 ]; then
  ok "already at this version — nothing to install (this is also the --verify evidence)"
  VERLINE=$(ui | grep -oE '已安装相同版本[^ ]*' | head -1)
  [ -n "$VERLINE" ] && ok "installer says: $VERLINE"
  rm -f "$TMP_APK"; exit 0
fi

step "④ tap the blue 「…您可授权本次安装」 (the user's recipe: wait 5s, tap the recorded spot)"
if [ "$DRY" = 1 ]; then
  printf '   · [dry] sleep 5 → screenshot → find blue → tap ($LAST_XY if that fails)\n'; ok "(dry-run)"
else
  sleep 5
  XY=$(timeout 60 "$HOME_DIR/.local/bin/dsh-find-blue" 2>/dev/null | grep -oE '^[0-9]+,[0-9]+' | head -1)
  if [ -n "$XY" ]; then ok "found the blue text at $XY"; else
    XY="$LAST_XY"
    [ -n "$XY" ] && warn "no blue found; falling back to the position that worked last time ($XY)"
  fi
  GOT=0
  for pt in $XY "261,1273" "277,1150" "1144,972"; do
    [ -n "$pt" ] || continue
    tap_xy "$pt"
    for _ in $(seq 1 15); do
      sleep 1
      [ "$(cur_pkg)" = "com.android.systemui" ] && { GOT=1; break; }
      ui | grep -q '安全验证' && { GOT=1; break; }
    done
    if [ "$GOT" = 1 ]; then
      ok "verification dialog appeared (tapped $pt)"
      printf '%s\n' "$pt" > "$LAST_FILE"      # remember what worked: next time it is the first try
      break
    fi
    warn "no reaction at $pt; trying the next one"
  done
  if [ "$GOT" != 1 ]; then
    ui | grep -q '已安装相同版本' && { ok "the same-version page is up → already installed"; rm -f "$TMP_APK"; exit 0; }
    bad "could not bring up 「安全验证」 (did the installer screen change?)"; rm -f "$TMP_APK"; exit 1
  fi
fi

# ── lockscreen password ──
step "⑤ go through 「锁屏密码验证」 → the digit keypad"
if [ "$DRY" = 1 ]; then printf '   · [dry] tap 「锁屏密码验证」 → press the 6 digits\n'; ok "(dry-run)"
else
  if tap_any "锁屏密码验证"; then ok "tapped 「锁屏密码验证」"; else bad "「锁屏密码验证」 not found"; exit 1; fi
  sleep 3
  i=0
  for (( n=0; n<${#DIGITS}; n++ )); do
    d="${DIGITS:$n:1}"
    xy=$(xy_of "$d" text)
    [ -n "$xy" ] || { bad "digit $d not found on the keypad"; exit 1; }
    tap_xy "$xy"; i=$((i+1)); sleep 0.7
  done
  ok "entered $i digits"
fi

# A "same version already installed" page means what we came to install is already on the device:
# that IS success (it is also exactly what --verify looks for). Stop here rather than hunting for the
# blue link — that was a real bug: the tool detected the page and then failed anyway.
if ui | grep -qE '已安装相同版本|already installed'; then
  ok "the 「same version already installed」 page is up → nothing left to install"
  tap_any "取消" || tap_any "Cancel" || true
  exit 0
fi

# ── the done page ──
step "⑥ wait for the done page and close the wizard"
if [ "$DRY" = 1 ]; then printf '   · [dry] wait for 「打开/完成」 and tap 完成\n'; ok "(dry-run)"
else
  DONE=0; VER=""
  for i in $(seq 1 30); do
    if ui | grep -qE "desc='(完成|打开)'"; then DONE=1; break; fi
    # the wizard may also **close itself** (it sometimes just exits after installing) — then the foreground is no longer the installer or the system verification
    case "$(cur_pkg)" in
      com.android.packageinstaller|com.android.systemui) ;;
      *) sleep 1; if ui | grep -qE "desc='(完成|打开)'"; then DONE=1; break; fi
         DONE=2; break ;;
    esac
    sleep 2
  done
  if [ "$DONE" = 1 ]; then
    VER=$(ui | grep -oE "版本：[0-9.]+" | head -1)
    tap_dsc "完成"; sleep 3
    ok "install complete ($VER)"
  elif [ "$DONE" = 2 ]; then
    ok "wizard closed (the installer exited) → leaving the verdict to the verification step"
  else
    bad "within 60 seconds neither the done page appeared nor the wizard closed (auth timeout? wrong password?)"; rm -f "$TMP_APK"; exit 1
  fi
fi

# ── verification (optional)──
if [ "$VERIFY" = 1 ] && [ "$DRY" != 1 ]; then
  step "⑦ verification (**this is the real verdict**): open the same APK again; it should say 「已安装相同版本」"
  # Note: after installing, this installer deletes the source APK (measured: "package does not exist") → copy it again before verifying
  cp -f "$APK" "$TMP_APK" 2>/dev/null || warn "failed to copy the temp file; verification may be inaccurate"
  timeout 25 am start -a android.intent.action.VIEW -d "file://$TMP_APK" \
    -t application/vnd.android.package-archive >/dev/null 2>&1; sleep 4
  tap_dsc "本次允许使用权限" >/dev/null 2>&1; sleep 7
  if ui | grep -q "已安装相同版本"; then
    ok "installer confirms: $(ui | grep -oE '已安装相同版本[^ ]*' | head -1)"
    tap_dsc "取消" >/dev/null 2>&1
  else
    bad "the installer did not say 「已安装相同版本」 — cannot be sure it is really installed"
    rm -f "$TMP_APK"; exit 1
  fi
fi

rm -f "$TMP_APK"
printf '\n【%s】完成：%s\n' "$(basename "$0")" "$(basename "$APK")"
printf '   Note: after an update the version shown in the App may still be the old one (the old process is alive) → cold start it once and look again.\n'
