#!/data/data/com.termux/files/usr/bin/bash
# dsh-look —— DSH self-look: screenshot the DSH Web UI (or any page) with headless Chromium
# Usage: 
#   dsh-look                    # screenshot the local DSH UI (auto-picks the token URL), saved under Download/dsh/图片/
#   dsh-look <output path>          # write to a specific file
#   dsh-look <output path> <URL>    # screenshot the given URL
# Note: the token comes from ~/.dsh-restart.log (the latest one is written on each start); when stale it falls back to a plain address.
set -u

HOME_DIR="/data/data/com.termux/files/home"
PORT="${DSH_LOOK_PORT:-8080}"
LOG="$HOME_DIR/.dsh-restart.log"
OUT="${1:-$HOME_DIR/storage/downloads/dsh/图片/dsh-ui-$(date +%Y%m%d-%H%M%S).png}"
URL="${2:-}"

if [ -z "$URL" ]; then
  TOKEN_URL="$(grep -oE "http://127\.0\.0\.1:${PORT}/\?token=[A-Za-z0-9_-]+" "$LOG" 2>/dev/null | tail -1)"
  URL="${TOKEN_URL:-http://127.0.0.1:${PORT}/}"
fi

if ! command -v chromium >/dev/null 2>&1; then
  echo "chromium is not installed: pkg install chromium" >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"
PROFILE_DIR="$HOME_DIR/.cache/chromium-look"

chromium \
  --headless=new \
  --no-sandbox \
  --disable-gpu \
  --hide-scrollbars \
  --disable-dev-shm-usage \
  --user-data-dir="$PROFILE_DIR" \
  --window-size="${DSH_LOOK_SIZE:-412,915}" \
  --virtual-time-budget="${DSH_LOOK_WAIT_MS:-15000}" \
  --screenshot="$OUT" \
  "$URL" >/dev/null 2>&1

if [ -s "$OUT" ]; then
  echo "screenshot saved: $OUT ($(du -h "$OUT" | cut -f1))"
else
  echo "screenshot failed (try: DSH_LOOK_WAIT_MS=25000 dsh-look)" >&2
  exit 1
fi
