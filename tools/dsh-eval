#!/data/data/com.termux/files/usr/bin/bash
# dsh-eval —— 在 DSH 页面里执行一段 JS 并把结果取回来
# 用法：
#   dsh-eval <js文件>          # 文件内容作为 async 函数体，最后 return 结果
#   dsh-eval -                 # 从标准输入读
# 例：echo 'return document.title' | dsh-eval -
# 可选：TIMEOUT=秒（默认 30）
set -u
CMD="$HOME/.dsh-look-cmd.json"
RES="$HOME/.dsh-look-cmd-result.json"
TIMEOUT="${TIMEOUT:-30}"

if [ "${1:-}" = "-" ]; then
  CODE="$(cat)"
elif [ -n "${1:-}" ] && [ -f "${1:-}" ]; then
  CODE="$(cat "$1")"
else
  echo "用法: dsh-eval <js文件> | dsh-eval -" >&2
  exit 2
fi
[ -z "$CODE" ] && { echo "代码为空" >&2; exit 2; }

JSON="$(python3 -c '
import json,sys
print(json.dumps({"action":"eval","code":sys.stdin.read()}, ensure_ascii=False))
' <<< "$CODE")"

BEFORE="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
printf '%s' "$JSON" > "$CMD.tmp" && mv "$CMD.tmp" "$CMD"

DEADLINE=$(( $(date +%s) + TIMEOUT ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  sleep 1
  AFTER="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
  if [ -n "$AFTER" ] && [ "$AFTER" != "$BEFORE" ]; then
    python3 -c '
import json,sys
raw=sys.stdin.read()
try:
    d=json.loads(raw)
except Exception:
    print(raw[:4000]); sys.exit()
if d.get("ok") is not True:
    print("❌ 执行失败:", d.get("error")); print(str(d.get("stack") or "")[:800]); sys.exit(1)
v=d.get("value")
print(v if isinstance(v,str) else json.dumps(v, ensure_ascii=False, indent=1))
' < "$RES"
    exit 0
  fi
done
echo "⏱ 超时 ${TIMEOUT}s：页面未响应（未打开 / 未刷新到新版客户端）" >&2
exit 1
