#!/data/data/com.termux/files/usr/bin/bash
# dsh-eval —— run a snippet of JS inside the DSH page and bring the result back
# Usage: 
#   dsh-eval <js file>          # the file body becomes an async function body; return the result at the end
#   dsh-eval -                 # read from stdin
# Example: echo 'return document.title' | dsh-eval -
# Optional: TIMEOUT=seconds (default 30)
set -u
CMD="$HOME/.dsh-look-cmd.json"
RES="$HOME/.dsh-look-cmd-result.json"
TIMEOUT="${TIMEOUT:-30}"

if [ "${1:-}" = "-" ]; then
  CODE="$(cat)"
elif [ -n "${1:-}" ] && [ -f "${1:-}" ]; then
  CODE="$(cat "$1")"
else
  echo "Usage: dsh-eval <js file> | dsh-eval -" >&2
  exit 2
fi
[ -z "$CODE" ] && { echo "empty code" >&2; exit 2; }

JSON="$(python3 -c '
import json,sys
print(json.dumps({"action":"eval","code":sys.stdin.read()}, ensure_ascii=False))
' <<< "$CODE")"

BEFORE="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
printf '%s' "$JSON" > "$CMD.tmp" && mv "$CMD.tmp" "$CMD"

DEADLINE=$(( $(date +%s) + TIMEOUT ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  sleep 1
  AFTER="$(md5sum "$RES" 2>/dev/null | cut -d' ' -f1)"
  if [ -n "$AFTER" ] && [ "$AFTER" != "$BEFORE" ]; then
    python3 -c '
import json,sys
raw=sys.stdin.read()
try:
    d=json.loads(raw)
except Exception:
    print(raw[:4000]); sys.exit()
if d.get("ok") is not True:
    print("❌ execution failed:", d.get("error")); print(str(d.get("stack") or "")[:800]); sys.exit(1)
v=d.get("value")
print(v if isinstance(v,str) else json.dumps(v, ensure_ascii=False, indent=1))
' < "$RES"
    exit 0
  fi
done
echo "⏱ timeout ${TIMEOUT}s: the page did not respond (not open / not refreshed to the new client)" >&2
exit 1
