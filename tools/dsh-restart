#!/data/data/com.termux/files/usr/bin/bash
# dsh-restart —— safe restart DSH: touches only the DSH processes, replacing pkill -9 -f node
#
# Why you should not use pkill -9 -f node any more:
#   ① it kills **every** node by name: DSH and the sandbox instances/md_cg I started go with it;
#   ② if DSH is killed with -9 while holding ~/.dsh/.credentials.yaml.lock, the lock stays behind forever
#      (the dsh-atomic-write wait limit is only 2 seconds) → every later start then fails,
#      with the error timed out waiting for the writer lock, which is hard to read.
#
# This script first decides whether the page is stuck or the service is really dead, then whether to restart.
# Usage: dsh-restart [--force] [--no-wake-lock]
HOME_DIR="/data/data/com.termux/files/home"
. "$HOME_DIR/.local/share/dsh-widgets/common.sh"
LOG="$(dsh_log)"
FORCE=0; WAKELOCK=1
for a in "$@"; do case "$a" in --force) FORCE=1 ;; --no-wake-lock) WAKELOCK=0 ;; esac; done
cd "$SHARED" 2>/dev/null || cd "$HOME_DIR"
[ -f "$HOME_DIR/.bashrc" ] && . "$HOME_DIR/.bashrc" >/dev/null 2>&1

if [ "$WAKELOCK" = 1 ] && need termux-wake-lock; then termux-wake-lock 2>/dev/null && log "wakelock held (stops the system freezing Termux)"; fi

# ── ① is the service still alive? Tell a stuck page from a dead service──
if port_open "$DSH_PORT"; then
  U=$(token_from_log "$LOG" 2>/dev/null)
  if [ -n "$U" ] && url_ready "$U"; then
    ok "DSH is alive and the auth URL is valid (HTTP 200)"
  else
    warnf "DSH is alive (%s listening), but I do not have the token for this run" "$DSH_PORT"
    printf '   (the token is random per process and never written to disk: for an instance you started by hand with dsh web, the token exists only in that terminal)\n'
  fi
  printf '\n   [Do not restart yet] that cannot-read-after-redirect is usually one of these:\n'
  printf '     ① Termux frozen by the system / the browser froze the background tab — the service is not actually dead\n'
  printf '     ② the long-lived page-to-service connection dropped — the UI stops updating\n'
  printf '   Both are fixed by **pull-to-refresh on the page**. The login cookie in the browser is signed with a persistent key,\n'
  printf '   so it stays valid after a DSH restart and normally you never need a new token URL.\n'
  if [ "$FORCE" = 0 ]; then
    printf '\n   dsh-restart --force is needed only when it still will not open after a refresh\n'
    exit 0
  fi
  warn "you passed --force; restarting anyway"
else
  warn "DSH is not running"
fi

# ── ② the real restart: end only the DSH processes ──
step "① end the DSH processes (matched only by 'bin.js web'; other node processes untouched)"
if [ -n "$(dsh_pids)" ]; then
  P=$(dsh_pids | tr '\n' ' ')
  kill_wait 'bin[.]js web' 10 TERM && okf "exited gracefully (pid %s)" "$P" \
    || { kill_wait 'bin[.]js web' 5 KILL >/dev/null; okf "force-killed (only DSH itself, pid %s)" "$P"; }
else
  ok "no DSH process (you may have killed it already)"
fi
wait_port_free "$DSH_PORT" 10 && ok "port released" || warn "port is still taken; still trying"

step "② clear the orphan credentials lock (after a -9 it makes the next start fail for sure)"
clear_orphan_cred_lock; rc=$?
case "$rc" in
  0) ok "orphan lock cleared" ;;
  1) warn "lock is held (another instance is running); left alone" ;;
  2) bad "the lock exists but cannot be deleted" ;;
  3) ok "no leftover lock" ;;
esac

step "③ keep the previous URL in .dsh-url (saved before the log is cleared)"
CUR=$(token_from_log "$LOG" 2>/dev/null)
[ -n "$CUR" ] && { printf '%s\n' "$CUR" > "$HOME_DIR/.dsh-url"; ok "archived"; } || warn "no token line in the log"

step "④ start and wait for **real readiness** (token line + following the redirect to 200)"
rotate_log "$LOG" 2
dsh_log_reset "$LOG"
if dsh_start_and_wait "$LOG" 120; then
  ok "start complete"
else
  need termux-notification && termux-notification --title "DSH restart failed" \
    --content "no usable auth URL; see $LOG" --priority high 2>/dev/null
  printf '\n  to see the log: tail -30 %s\n' "$LOG"
  exit 1
fi

printf '\n  now just refresh the browser page (the login cookie stays valid across a restart).\n'
done_
