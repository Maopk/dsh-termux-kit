#!/data/data/com.termux/files/usr/bin/bash
# dsh-restart —— 安全的「重启 DSH」：只动 DSH 自己的进程，替代 pkill -9 -f node
#
# 为什么不让你再 pkill -9 -f node：
#   ① 它按名字杀**所有** node：DSH、还有我起的沙箱实例/md_cg 一起带走；
#   ② DSH 被 -9 时如果正拿着 ~/.dsh/.credentials.yaml.lock，锁会永远留下
#      （dsh-atomic-write 的等待上限只有 2 秒）→ 之后每次启动都失败，
#      而报错是「timed out waiting for the writer lock」，很难看懂。
#
# 本脚本的顺序是：先判断「是页面卡住」还是「服务真死了」，再决定要不要重启。
# 用法：dsh-restart [--force] [--no-wake-lock]
HOME_DIR="/data/data/com.termux/files/home"
. "$HOME_DIR/.local/share/dsh-widgets/common.sh"
LOG="$(dsh_log)"
FORCE=0; WAKELOCK=1
for a in "$@"; do case "$a" in --force) FORCE=1 ;; --no-wake-lock) WAKELOCK=0 ;; esac; done
cd "$SHARED" 2>/dev/null || cd "$HOME_DIR"
[ -f "$HOME_DIR/.bashrc" ] && . "$HOME_DIR/.bashrc" >/dev/null 2>&1

if [ "$WAKELOCK" = 1 ] && need termux-wake-lock; then termux-wake-lock 2>/dev/null && log "已拿住 wakelock（防 Termux 被系统冻结）"; fi

# ── ① 服务还活着吗？先分清「页面卡住」和「服务死了」──
if port_open "$DSH_PORT"; then
  U=$(token_from_log "$LOG" 2>/dev/null)
  if [ -n "$U" ] && url_ready "$U"; then
    ok "DSH 活着，认证 URL 也有效（HTTP 200）"
  else
    warn "DSH 活着（$DSH_PORT 在听），只是我这边没有它本次的 token"
    printf '   （token 每次进程随机生成、不落盘：你在终端手动 dsh web 起的实例，token 只在那个终端里）\n'
  fi
  printf '\n   【先别重启】你说的「跳转回来无法读取」通常是这两种：\n'
  printf '     ① Termux 被系统冻结 / 浏览器把后台标签冻结 —— 服务其实没死\n'
  printf '     ② 页面与服务的长连接断了 —— 界面不再更新\n'
  printf '   两种都是**下拉刷新页面**就好。浏览器里的登录 cookie 是持久密钥签的，\n'
  printf '   重启 DSH 之后依然有效，所以正常情况下你根本不需要重新拿 token URL。\n'
  if [ "$FORCE" = 0 ]; then
    printf '\n   只有「刷新后仍然打不开」才需要：dsh-restart --force\n'
    exit 0
  fi
  warn "你加了 --force，继续重启"
else
  warn "DSH 没在跑"
fi

# ── ② 真正重启：只结束 DSH 自己的进程 ──
step "① 结束 DSH 进程（只按 'bin.js web' 匹配，不动别的 node）"
if [ -n "$(dsh_pids)" ]; then
  P=$(dsh_pids | tr '\n' ' ')
  kill_wait 'bin[.]js web' 10 TERM && ok "已优雅退出（pid $P）" \
    || { kill_wait 'bin[.]js web' 5 KILL >/dev/null; ok "已强杀（只杀了 DSH 自己，pid $P）"; }
else
  ok "没有 DSH 进程（可能已经被你 kill 了）"
fi
wait_port_free "$DSH_PORT" 10 && ok "端口已释放" || warn "端口仍被占用，继续试"

step "② 清理孤儿 credentials 锁（-9 之后它会让下次启动必然失败）"
clear_orphan_cred_lock; rc=$?
case "$rc" in
  0) ok "清掉了孤儿锁" ;;
  1) warn "锁被占用（还有实例在跑），未动" ;;
  2) bad "锁存在但删不掉" ;;
  3) ok "没有残留锁" ;;
esac

step "③ 保留上一轮的 URL 到 .dsh-url（清日志前先存）"
CUR=$(token_from_log "$LOG" 2>/dev/null)
[ -n "$CUR" ] && { printf '%s\n' "$CUR" > "$HOME_DIR/.dsh-url"; ok "已存档"; } || warn "日志里没有 token 行"

step "④ 启动并等**真就绪**（token 行 + 跟随跳转 200）"
rotate_log "$LOG" 2
dsh_log_reset "$LOG"
if dsh_start_and_wait "$LOG" 120; then
  ok "启动完成"
else
  need termux-notification && termux-notification --title "DSH 重启失败" \
    --content "没拿到可用认证 URL，见 $LOG" --priority high 2>/dev/null
  printf '\n  想看日志：tail -30 %s\n' "$LOG"
  exit 1
fi

printf '\n  现在刷新一下浏览器页面即可（浏览器里的登录 cookie 在重启后依然有效）。\n'
done_
