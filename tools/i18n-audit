import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser('~')
ROOT = os.path.expanduser(os.environ.get('DSH_KIT_REPO') or os.path.join(HOME, 'dsh-termux-kit'))
CONTROLS = os.path.join(ROOT, 'ui', 'controls.json')
THEME = os.path.join(ROOT, 'ui', 'theme.json')
ZH = os.path.join(ROOT, 'i18n', 'zh.json')
CONSOLE_SRC = os.path.join(HOME, 'dsh-console', 'src', 'io', 'dsh', 'console')
BRIDGE_SRC = os.path.join(HOME, 'droid-bridge', 'src', 'io', 'dsh', 'bridge')
CONSOLE_MANIFEST = os.path.join(HOME, 'dsh-console', 'AndroidManifest.xml')
BRIDGE_MANIFEST = os.path.join(HOME, 'droid-bridge', 'AndroidManifest.xml')
STATUS_PUB = os.path.join(ROOT, 'tools', 'dsh-status-pub')

# 术语不翻译（用户 2026-09-27 明确）：这些词出现在中文里是**故意**的
TERMS = {'adb', 'token', 'Token', 'GitHub', 'Wi-Fi', 'DSH', 'APK', 'SHA256', 'SHA', 'exit',
         'HTTP', 'HTTPS', 'PWA', 'Clash', 'Termux', 'Android', 'RUN_COMMAND', 'mode', 'v',
         'OK', 'WiFi', 'adb_wifi', 'VPN', 'DNS', 'IP', 'ID', 'AI', 'App', 'APP', 'SIGTERM',
         'kill', 'dry-run', 'JSON', 'GitHub', 'URL', 'Web', 'web', 'hive', 'Clash', 'adb'}
REPORT = []


def ok(msg):
    REPORT.append(('✔', msg))


def bad(msg):
    REPORT.append(('✘', msg))


def load_json(p):
    with io.open(p, encoding='utf-8') as f:
        return json.load(f)


# ── 1. 字面量调用：Lang.t() 的参数必须是字符串字面量 ─────────────────────────
def canon(s):
    """与 tools/i18n-table 同一套规范化：Java 源码里的 \\n 是转义，运行时是真换行。"""
    return s.replace('\\n', '\n').replace('\\t', '\t')


def strip_comments(src):
    """去掉 // 与 /* */ 注释：注释里出现的 Lang.t("…") 不是调用（本工具的说明文字里就有）。"""
    src = re.sub(r'/\*.*?\*/', lambda m: '\n' * m.group(0).count('\n'), src, flags=re.S)
    return re.sub(r'//[^\n]*', '', src)


# 允许的"非字面量"参数：全部来自生成的控件表（第 3 条已逐条核对中文）
SAFE_DYNAMIC = re.compile(
    r'^[A-Za-z_][\w.]*(?:\([^()]*\))?\.labelEn$'                        # 生成表里的控件文案
    r'|^[A-Za-z_][\w.]*(?:\([^()]*\))?\.hintEn$'
    r'|^UiControls\.(?:catEn|groupEn)\([^)]*\)$')                       # 生成表里的分类/组名


def split_top(expr, sep):
    """按不在字符串/括号里的 sep 切分（表达式里的中文字符串常带括号，不能用正则硬切）。"""
    out, buf, depth, i, instr = [], '', 0, 0, False
    while i < len(expr):
        ch = expr[i]
        if instr:
            buf += ch
            if ch == '\\':
                buf += expr[i + 1:i + 2]; i += 2; continue
            if ch == '"':
                instr = False
        else:
            if ch == '"':
                instr = True; buf += ch
            elif ch in '([':
                depth += 1; buf += ch
            elif ch in ')]':
                depth -= 1; buf += ch
            elif ch == sep and depth == 0:
                out.append(buf); buf = ''
            else:
                buf += ch
        i += 1
    out.append(buf)
    return out


def analyze_arg(expr):
    """返回 (字面量列表, 动态原因或 None)。

    规则：字面量 ✓；`cond ? A : B` 两个分支各自递归（条件里的 "port" 这类 JSON key 不算文案）；
    .labelEn/.hintEn/catEn/groupEn 是生成表里的文案（第 3 条已核对）✓；其余动态参数一律 ✗。
    """
    expr = expr.strip()
    if '?' in expr:
        parts = split_top(expr, '?')
        if len(parts) == 2:
            rest = parts
            lits, dyn = [], None
            for br in split_top(rest[1], ':'):
                l, d = analyze_arg(br)
                lits += l
                dyn = dyn or d
            return lits, dyn
    if SAFE_DYNAMIC.match(expr):
        return [], None
    if expr.startswith('"') and expr.endswith('"') and expr.count('"') == 2:
        return [canon(expr[1:-1].replace('\\"', '"').replace('\\\\', '\\'))], None
    return [], expr


def java_calls(path):
    """产出一张 (行号, Lang.t 的参数原文) 表，按括号配平切分（跳过字符串里的括号）；注释不算。"""
    src = strip_comments(io.open(path, encoding='utf-8').read())
    out = []
    for m in re.finditer(r'Lang\.t\s*\(', src):
        i = m.end()
        depth, j, instr = 1, i, False
        while j < len(src) and depth:
            ch = src[j]
            if instr:
                if ch == '\\':
                    j += 2; continue
                if ch == '"':
                    instr = False
            elif ch == '"':
                instr = True
            elif ch == '(':
                depth += 1
            elif ch == ')':
                depth -= 1
            j += 1
        out.append((src[:m.start()].count('\n') + 1, src[i:j - 1].strip()))
    return out


def audit_literals():
    dynamic = 0
    for label, d in (('console', CONSOLE_SRC), ('bridge', BRIDGE_SRC)):
        for name in sorted(os.listdir(d)):
            if not name.endswith('.java') or name == 'Lang.java':
                continue
            for line, arg in java_calls(os.path.join(d, name)):
                _, dyn = analyze_arg(arg)
                if dyn is not None:
                    bad('%s/%s:%d Lang.t() 的参数不是字面量：%s —— 这种查表永远查不到（桥的分类标题就是这么变英文的）'
                        % (label, name, line, ' '.join(arg.split())[:70]))
                    dynamic += 1
    if dynamic == 0:
        ok('Lang.t() 全部是字面量调用（没有"拼好的串再查表"这种必漏的写法）')


# ── 2. 字面量覆盖：每个 Lang.t 的 key 都要有非空中文 ────────────────────────
def audit_coverage(zh):
    calls = []
    for label, d in (('console', CONSOLE_SRC), ('bridge', BRIDGE_SRC)):
        for name in sorted(os.listdir(d)):
            if not name.endswith('.java') or name == 'Lang.java':
                continue
            for line, arg in java_calls(os.path.join(d, name)):
                for lit in analyze_arg(arg)[0]:
                    calls.append((label, name, line, lit))
    miss = [(l, n, ln, s) for (l, n, ln, s) in calls if zh.get(s, '') == '']
    for l, n, ln, s in miss:
        bad('%s/%s:%d 没有中文：%r' % (l, n, ln, s[:70]))
    if not miss:
        ok('两个 App 的 %d 处 Lang.t 字面量都有中文（%d 个去重 key）'
           % (len(calls), len(set(c[3] for c in calls))))
    return miss


# ── 3. 控件表：label/hint/分类/组 的中文必须齐 ───────────────────────────────
def audit_controls(data, zh):
    missing = 0
    for c in data['controls']:
        for field in ('label', 'hint'):
            e, z = c[field]['en'], c[field]['zh']
            if not z.strip():
                bad('控件 %s 的 %s 没有中文' % (c['id'], field)); missing += 1
            if zh.get(e, '') != z:
                bad('控件 %s 的 %s 与 i18n/zh.json 不一致（表里是 %r）' % (c['id'], field, zh.get(e))) ; missing += 1
    for c in data['cats']:
        if zh.get(c['en'], '') != c['zh']:
            bad('分类 %s 的中文与 zh.json 不一致' % c['id']); missing += 1
    for g in data.get('groups', []):
        if zh.get(g['en'], '') != g['zh']:
            bad('分组 %s 的中文与 zh.json 不一致' % g['id']); missing += 1
    if not missing:
        ok('控件表 %d 条控件的 label/hint + %d 个分类 + %d 个分组，中文与翻译表逐条一致'
           % (len(data['controls']), len(data['cats']), len(data.get('groups', []))))


# ── 4. 主题：两份 manifest 必须声明同一个（且等于 ui/theme.json 的那个）─────
def audit_theme(theme):
    want = theme['androidTheme']
    got = {}
    for label, p in (('console', CONSOLE_MANIFEST), ('bridge', BRIDGE_MANIFEST)):
        src = io.open(p, encoding='utf-8').read()
        app = re.search(r'<application\b[^>]*>', src, re.S)
        m = re.search(r'android:theme="([^"]+)"', app.group(0)) if app else None
        got[label] = m.group(1) if m else None
    if got['console'] != want or got['bridge'] != want:
        bad('AndroidManifest 主题不一致：theme.json=%s console=%s bridge=%s —— 桥正是因为没写主题才变成浅色 App 的'
            % (want, got['console'], got['bridge']))
    else:
        ok('两个 App 的 android:theme 相同：%s' % want)
    # 主题资源本身：窗口底色/状态栏/导航栏/边缘辉光/对话框都得钉在同一个色板上，
    # 否则"内容短或滚到底露出一块灰"会以另一种形式回来（那一层不属于任何 View）。
    files = [os.path.join(CONSOLE_SRC, '..', '..', '..', '..', 'res', 'values', 'dsh_theme.xml'),
             os.path.join(BRIDGE_SRC, '..', '..', '..', '..', 'res', 'values', 'dsh_theme.xml')]
    files = [os.path.normpath(f) for f in files]
    bodies = []
    for f in files:
        bodies.append(io.open(f, encoding='utf-8').read() if os.path.exists(f) else None)
    if None in bodies:
        bad('res/values/dsh_theme.xml 还没生成（跑 tools/ui-controls gen）')
    elif bodies[0] != bodies[1]:
        bad('两个 App 的 dsh_theme.xml 不一致 —— 跑 tools/ui-controls gen')
    else:
        body = bodies[0]
        bg = theme['dark']['BG'].lstrip('#').upper()
        need = {'android:windowBackground': 'dsh_bg', 'android:colorBackground': 'dsh_bg',
                'android:statusBarColor': 'dsh_bg', 'android:navigationBarColor': 'dsh_bg',
                'android:colorEdgeEffect': 'dsh_accent', 'android:alertDialogTheme': 'DshDialog'}
        miss = [k for k, v in need.items() if not re.search(r'%s">@(?:color|style)/%s<' % (re.escape(k), v), body)]
        if miss:
            bad('dsh_theme.xml 里少了/写错了：%s' % ', '.join(miss))
        elif '#%s' % bg not in body:
            bad('dsh_theme.xml 里的 dsh_bg 不是 ui/theme.json 的 BG(#%s)' % bg)
        else:
            ok('两份 dsh_theme.xml 逐字节相同，窗口底色/状态栏/导航栏/边缘辉光/对话框全部钉在 BG(#%s) 上' % bg)


# ── 5. 色板：两份 Palette.java 必须同源 ─────────────────────────────────────
def audit_palette():
    p1 = os.path.join(CONSOLE_SRC, 'Palette.java')
    p2 = os.path.join(BRIDGE_SRC, 'Palette.java')
    if not (os.path.exists(p1) and os.path.exists(p2)):
        bad('Palette.java 还没生成（跑 tools/ui-controls gen）'); return
    a = [l for l in io.open(p1, encoding='utf-8') if l.startswith('    static final int')]
    b = [l for l in io.open(p2, encoding='utf-8') if l.startswith('    static final int')]
    if a != b:
        bad('两份 Palette.java 的颜色不一致 —— 跑 tools/ui-controls gen'); return
    # 源里不许再有裸色值（除透明）
    stray = []
    for d in (CONSOLE_SRC, BRIDGE_SRC):
        for name in sorted(os.listdir(d)):
            if not name.endswith('.java') or name in ('Lang.java', 'Palette.java'):
                continue
            src = strip_comments(io.open(os.path.join(d, name), encoding='utf-8').read())
            for m in re.finditer(r'#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6})(?![0-9A-Fa-f])|0xFF[0-9A-Fa-f]{6}', src):
                stray.append('%s/%s %s' % (os.path.basename(d), name, m.group(0)))
    # res/ 下的 XML 也要查：以前 box/btn/btn_danger 里的 10 个色值是手写的，没有任何检查盯着
    # （box 是 #0F141A 而 Palette.CARD 是 #161B22 —— 同一套界面两套"卡片色"）。现在它们由
    # tools/ui-controls 从 ui/theme.json 生成，只有生成的那几个文件允许出现色值。
    # 允许自带色值的：前四个是 ui/theme.json 生成的；ic_launcher 是**图标图形**（有自己的识别色，
    # 不是界面配色，硬塞进 UI 色板只会逼着图标改色）。
    gen_ok = {'dsh_theme.xml', 'box.xml', 'btn.xml', 'btn_danger.xml', 'ic_launcher.xml'}
    for app_dir in ('dsh-console', 'droid-bridge'):
        base = os.path.join(HOME, app_dir, 'res')
        for root, _dirs, files in os.walk(base):
            for name in sorted(files):
                if not name.endswith('.xml') or name in gen_ok:
                    continue
                body = io.open(os.path.join(root, name), encoding='utf-8').read()
                for m in re.finditer(r'#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6})(?![0-9A-Fa-f])|0xFF[0-9A-Fa-f]{6}', body):
                    stray.append('%s/res/%s %s' % (app_dir, name, m.group(0)))
    # 面板（client.js）也一样：它的危险红/强调蓝以前是另一套（#e5484d / #4c8dff），
    # 现在是 ui/theme.json 生成的 UI_THEME —— 生成块外面不许再有裸色值。
    cj = io.open(os.path.join(ROOT, 'plugins', 'dsh-mobile-local', 'client.js'), encoding='utf-8').read()
    for pat in (r'// ── generated:controls.*?// ── /generated:controls ──',
                r'// ── generated:theme.*?// ── /generated:theme ──',
                r'// >>> generated by tools/i18n-table.*?// <<< generated by tools/i18n-table <<<',
                r'/\*.*?\*/', r'//[^\n]*'):
        cj = re.sub(pat, '', cj, flags=re.S)
    for m in re.finditer(r'#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6})(?![0-9A-Fa-f])', cj):
        stray.append('panel/client.js ' + m.group(0))

    if stray:
        bad('还有裸写的颜色值（必须走 Palette / ui/theme.json）：%s' % ', '.join(stray[:6]))
    else:
        ok('两份 Palette.java 完全一致（%d 个颜色），Java 与 res/ 里都没有裸色值（只有生成的主题/形状 XML 有）' % len(a))


# ── 6. 桥状态口径：python 与 java 的 state→灯色 必须逐项相同 ────────────────
def audit_state_maps():
    """状态 → 灯色 / 文字：**三处实现同一张表**（dsh-status-pub 的 python、控制台/桥的 java、面板的 js）。

    用户 2026-09-27 连着两轮问同一件事："灯色和文字是不是来自同一个数据源"。所以这里不看某一处，
    而是把**所有会自己算灯色的地方**逐项对拍：只要有一处按 ok/port 另算，就对不上。
    """
    py = io.open(STATUS_PUB, encoding='utf-8').read()
    m = re.search(r'LAMP_OF_STATE\s*=\s*\{(.*?)\}', py, re.S)
    m2 = re.search(r'DSH_LAMP\s*=\s*\{(.*?)\}', py, re.S)
    if not m or not m2:
        bad('dsh-status-pub 里找不到 LAMP_OF_STATE / DSH_LAMP'); return
    bridge_py = dict(re.findall(r"'([a-z]+)':\s*'([a-z]+)'", m.group(1)))
    dsh_py = dict(re.findall(r"'([a-z]+)':\s*'([a-z]+)'", m2.group(1)))

    def java_map(fn, js):
        k = re.search(r'private static String %s\(String state\)\s*\{(.*?)\n    \}' % fn, js, re.S)
        if not k:
            return None
        body = k.group(1)
        out = dict(re.findall(r'"([a-z]+)"\.equals\(state\)\) return "([a-z]+)"', body))
        last = re.findall(r'return "([a-z]+)";', body)
        for st in (bridge_py if fn == 'lampOf' else dsh_py):
            if st not in out:
                out[st] = last[-1] if last else None
        return out

    js_console = io.open(os.path.join(CONSOLE_SRC, 'MainActivity.java'), encoding='utf-8').read()
    js_bridge = io.open(os.path.join(BRIDGE_SRC, 'MainActivity.java'), encoding='utf-8').read()
    client = io.open(os.path.join(ROOT, 'plugins', 'dsh-mobile-local', 'client.js'), encoding='utf-8').read()

    def js_map(name):
        mm = re.search(r'%s\s*=\s*\{(.*?)\}' % name, client, re.S)
        return dict(re.findall(r'([a-z]+):\s*\'([a-z]+)\'', mm.group(1))) if mm else None

    # 桥 App 本身没有灯（它只有一行状态文字 + 一个开关，两者都读 svc.isListening()），所以这里没有它；
    # 它那一份同源检查在下面单独做。
    variants = {
        'dsh-status-pub':    (bridge_py, dsh_py),
        'console (java)':    (java_map('lampOf', js_console), java_map('lampOfDsh', js_console)),
        'panel (client.js)': (js_map('LAMP_OF_STATE'), js_map('DSH_LAMP')),
    }
    for label, (bm, dm) in variants.items():
        if bm is None or dm is None:
            bad('%s：找不到状态→灯色的映射表' % label); return
        if bm != bridge_py:
            bad('%s 的桥 state→灯色与 dsh-status-pub 不一致：%s vs %s' % (label, bm, bridge_py)); return
        if dm is not None and dm != dsh_py:
            bad('%s 的 DSH state→灯色与 dsh-status-pub 不一致：%s vs %s' % (label, dm, dsh_py)); return
    ok('状态→灯色 三处实现同一张表：桥 %s / DSH %s' % (bridge_py, dsh_py))

    # 桥 App：状态文字与开关位置必须读**同一个** listening（两处各算一次就会出现"开关关着、文字说在跑"）
    code_bridge = strip_comments(js_bridge)          # 注释里提到 isListening() 不算
    n = code_bridge.count('isListening()')
    if n != 1 or 'setChecked(listening)' not in code_bridge:
        bad('桥 App 的 listening 被算了 %d 次（应该只有 1 次，赋给 listening 后文字与开关都用它）' % n)
    else:
        ok('桥 App 的状态文字与开关位置读同一个 listening（只算一次）')

    # 面板：不许再有"按 ok/port 另算"的入口（灯色、开关位置、文字都必须读 state）
    if re.search(r"lampOf\('bridge'|lampOf\('dsh'|\.bridge\.ok\s*\?", client):
        bad('面板里又出现了按 ok/port 另算桥或 DSH 状态的写法（必须读 state）')
    else:
        ok('面板的桥/DSH 灯色、开关位置、状态文字都读同一个 state（只剩 adb 灯按 devices 算）')

def english_left(text, allow=TERMS):
    out = []
    for w in re.findall(r'[A-Za-z][A-Za-z_.\-]{1,}', text):
        if w in allow or w.rstrip('.').isdigit():
            continue
        out.append(w)
    return out


def audit_panel_i18n():
    """面板的文案必须来自 i18n/zh.json 生成的 UI_TEXT（T('English')），不许散落成字符串。

    用户 2026-09-27 的通用约束第 5 条。这条规则以前只是"中文要跟语言走"，现在收紧成"中文只能出现在
    生成块里" —— 面板里 45 处 `lang === 'zh' ? '中文' : 'English'` 已经搬进表里（同一份 i18n/zh.json，
    bash / 两个 App / 面板四个目标），改一处文案只改一个文件。
    """
    p = os.path.join(ROOT, 'plugins', 'dsh-mobile-local', 'client.js')
    src = io.open(p, encoding='utf-8').read()
    for name, pat in (('controls 块', r'// ── generated:controls.*?// ── /generated:controls ──'),
                      ('i18n 块', r'// >>> generated by tools/i18n-table.*?// <<< generated by tools/i18n-table <<<')):
        m = re.search(pat, src, re.S)
        if not m:
            bad('面板里找不到 %s 的生成标记（i18n 表没地方生成）' % name)
            return
        src = src.replace(m.group(0), '')
    src = re.sub(r'//[^\n]*', '', src)          # 注释里的中文不算文案
    # 唯一允许的例外：语言选择器里那三个"语言自称名"（系统 / 中文 / English）——
    # 中文写在中文那一项上是**对的**，翻译它反而错。
    src = src.replace("['auto', T(\"System\")], ['zh', '中文'], ['en', 'English']]", '')
    hits = [m.group(0) for m in re.finditer(r'[\u4e00-\u9fff]+', src)]
    if hits:
        # 给出上下文，方便直接定位
        ctx = []
        for m in re.finditer(r'[\u4e00-\u9fff]+', src):
            ctx.append(re.sub(r'\s+', ' ', src[max(0, m.start() - 60):m.end() + 60]).strip())
        bad('面板里有 %d 处中文不在生成表里（应改成 T(\'English\')）：%s' % (len(hits), ' | '.join(ctx[:3])))
    else:
        ok('面板里所有文案都走 T(\'English\') → i18n/zh.json 生成的 UI_TEXT（没有散落的字符串）')
    # 真的跑一遍渲染：面板"一点开就消失"这类运行时错误，语法检查与静态规则都抓不住
    # （2026-09-27 真踩：T() 写在模块作用域、却读组件里的 lang —— node --check 全过，一打开面板就 ReferenceError）
    try:
        r = subprocess.run(['node', os.path.join(ROOT, 'tools', 'panel-render-test'), p],
                           capture_output=True, text=True, timeout=180)
        if r.returncode != 0:
            tail = [l for l in r.stdout.splitlines() if l.strip().startswith('✘')]
            bad('面板渲染测试台不通过（点开就会崩）：%s' % (tail[0].strip() if tail else r.stdout.strip()[-160:]))
        else:
            last = [l for l in r.stdout.splitlines() if '渲染了' in l]
            ok('面板渲染测试台通过：%d 遍都渲染到底（%s）'
               % (len(last), last[-1].split('——')[-1].strip() if last else ''))
    except FileNotFoundError:
        pass

    # 表本身必须能被 JS 解析/求值：一个语法错就让整个面板从页面上消失（不是"显示英文"那么轻）
    try:
        r = subprocess.run(['node', '-e',
                            'const fs=require("fs");const s=fs.readFileSync(process.argv[1],"utf8");'
                            'const b=s.match(/const UI_TEXT = \\{[\\s\\S]*?\\n      \\};/);'
                            'if(!b)throw new Error("no UI_TEXT block");'
                            'const T=new Function(b[0]+"; return UI_TEXT;")();'
                            'console.log(Object.keys(T).length)',
                            p], capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            bad('面板的 UI_TEXT 生成块在 JS 里求值失败（面板会整块加载不出来）：%s'
                % (r.stderr.strip().splitlines()[-1] if r.stderr.strip() else '?'))
        else:
            ok('面板的 UI_TEXT 能在 JS 里求值（%s 条），node --check 也过' % r.stdout.strip())
    except FileNotFoundError:
        pass    # 没装 node 就跳过（这一条是加分项，不是判定前提）

    # 句式可以按语言分叉（中英形状不同时不得不如此，如"（N 项）"vs"(N)"），
    # 但**中文不许写成字面量** —— 上面那条已经保证这一点。
    if re.search(r"lang === 'zh'\s*\?\s*'[^']*[\u4e00-\u9fff]", src) or re.search(r"\{\s*zh:\s*'", src):
        bad('面板里又出现了内联的中文字面量（lang === \'zh\' ? \'中文\' / {zh:…}）—— 文案必须进 i18n 表')


def audit_orphan_views():
    """建好却从没挂到界面上的 View —— 表现是"控件凭空消失"。

    2026-09-28 真踩：控制台「语言」那一行建了 `choices` 容器、把三个按钮塞进去，**却忘了 addView**，
    界面上就只剩标题和副标题（用户截图："只有语言没有选项"）。语法检查、文案审计、APK 自检全过 ——
    只有"这个东西到底有没有交出去"才查得出来。

    判定（够窄，误报为零）：只认 View 类型；声明之后，这个名字必须**作为参数/返回值/数组元素**出现过
    一次（`addView(x)`、`setView(x)`、`layoutAll(root, …)`、`return x;`、`new View[]{x}` 都算），
    如果之后它只以 `x.方法()` 的形式出现（自己配置自己，却没人拿它），就是漏挂了。
    """
    ty = (r'(?:LinearLayout|FrameLayout|RelativeLayout|ScrollView|HorizontalScrollView|TextView|'
          r'Button|Switch|ProgressBar|EditText|ImageView|Space|View)')
    found = []
    for label, d in (('console', CONSOLE_SRC), ('bridge', BRIDGE_SRC)):
        for name in sorted(os.listdir(d)):
            if not name.endswith('.java') or name in ('Lang.java', 'UiControls.java', 'Palette.java'):
                continue
            src = strip_comments(io.open(os.path.join(d, name), encoding='utf-8').read())
            for m in re.finditer(r'(?:^|[;{(]\s*)(?:final\s+)?(?:[\w.]+\.)?(%s)\s+(\w+)\s*=\s*new\s+' % ty, src):
                var = m.group(2)
                after = src[m.end():]
                if re.search(r'(?<![\w.])%s(?![\w.])' % re.escape(var), after):
                    continue          # 作为参数/返回值交出去了 ✓
                found.append('%s/%s:%d %s' % (label, name, src[:m.start()].count(chr(10)) + 1, var))
    if found:
        bad('这些 View 建好却没挂到任何地方（界面上会凭空少东西）：%s' % ', '.join(found[:6]))
    else:
        ok('两个 App 里没有"建好却没挂上去"的 View（每个容器都真的交进了布局）')


