def _rows(data, cid, surface):
    return category_counts(data)[surface].get(cid, 0)


def category_counts(data):
    """每个分类在三个界面上**实际会渲染出几个条目**，作为 (N) 的参考答案。

    规则（三处一致）：一个控件/开关/文本 = 1 条；灯那一整块算 1 条；说明行跟着它的控件（不加）；
    分组小标题不算；面板把 bridge_state_text 吸收进"桥运行中"那一行，所以面板比控制台少 1 条。
    """
    out = {}
    for surface in ('console', 'bridge', 'panel'):
        rows = {}
        for cat in data['cats']:
            cid = cat['id']
            mine = [c for c in data['controls']
                    if c['cat'] == cid and surface in c['surfaces']
                    and (c['kind'] != 'lamp' or cid == 'statuslog')]
            n = 0
            lamps_done = False
            for c in mine:
                if c['kind'] == 'lamp':
                    if not lamps_done:
                        n += 1; lamps_done = True
                    continue
                if surface == 'panel' and c['id'] == 'bridge_state_text':
                    continue          # 面板把这一行并进"桥运行中"开关
                n += 1
            if surface == 'bridge' and cid == 'about':
                continue              # 桥的「关于本应用」是说明页，标题上不挂数字
            if n:
                rows[cid] = n
        out[surface] = rows
    return out


def audit_counts(data):
    """(N) 不许有两套数据：面板曾经用 UI_CONTROLS.filter(cat).length 另算一遍，
    于是通道报 8 项、展开只有 7 条（用户 2026-09-27 报的"对不上"）。"""
    js = io.open(os.path.join(ROOT, 'plugins', 'dsh-mobile-local', 'client.js'), encoding='utf-8').read()
    js = re.sub(r'//[^\n]*', '', js)          # 注释里引用旧写法不算（本文件的说明就引用了它）
    if re.search(r'UI_CONTROLS\.filter\([^)\n]*\)\s*\.length', js):
        bad('面板里又出现了"按控件表另算一遍"的计数（UI_CONTROLS.filter(...).length）—— '
            '标题上的数字必须数真正渲染的 body')
    else:
        ok('面板的 (N) 数的是渲染出来的 body（rowsOf(body)），没有第二套计数')
    counts = category_counts(data)
    for surface in ('console', 'bridge', 'panel'):
        rows = counts[surface]
        if rows:
            ok('%-7s 各分类条目数：%s' % (surface, ' · '.join(
                '%s=%d' % (next(c['zh'] for c in data['cats'] if c['id'] == k), v) for k, v in rows.items())))


def screen_model(zh, data):
    L = []
    L.append('【控制台】')
    L.append('  DSH Console  v1.16           ● DSH　● 桥　● adb')
    L.append('  %s' % ('运行：刷新状态　已等待 3s' if False else '（无任务时这一行不显示）'))
    for cat in data['cats']:
        ctrls = [c for c in data['controls'] if c['cat'] == cat['id'] and 'console' in c['surfaces']]
        if not ctrls:
            continue
        L.append('  ▾ %s（%d）' % (cat['zh'], _rows(data, cat['id'], 'console')))
        grp = ''
        for c in ctrls:
            if c.get('group') and c['group'] != grp:
                grp = c['group']
                L.append('     · %s' % next(g['zh'] for g in data['groups'] if g['id'] == grp))
            L.append('     [%s] %s' % (c['kind'], c['label']['zh']))
    L.append('  ───── 最近一次结果固定在窗口底部（不随分类滚动；没结果时整条不显示）─────')
    L.append('【桥】')
    L.append('  DSH 桥  v2.22')
    L.append('  无障碍：已开启 ✅ / 端口：正在监听 127.0.0.1:8788')
    for cat in data['cats']:
        ctrls = [c for c in data['controls'] if c['cat'] == cat['id'] and 'bridge' in c['surfaces']]
        if not ctrls:
            continue
        L.append('  ▾ %s（%d）' % (cat['zh'], _rows(data, cat['id'], 'bridge')))
        grp = ''
        for c in ctrls:
            if c.get('group') and c['group'] != grp:
                grp = c['group']
                L.append('     · %s' % next(g['zh'] for g in data['groups'] if g['id'] == grp))
            L.append('     [%s] %s' % (c['kind'], c['label']['zh']))
    L.append('  ▾ 关于本应用（说明页，不挂数字）')
    return L


def main():
    quiet = '--quiet' in sys.argv
    data = load_json(CONTROLS)
    theme = load_json(THEME)
    zh = load_json(ZH)
    zh = {k.replace('\\n', '\n'): v for k, v in zh.items()}

    audit_literals()
    audit_coverage(zh)
    audit_controls(data, zh)
    audit_theme(theme)
    audit_palette()
    audit_state_maps()
    audit_counts(data)
    audit_panel_i18n()
    audit_orphan_views()
    audit_titles(zh, data)

    if not quiet:
        for mark, msg in REPORT:
            print('   %s %s' % (mark, msg))
    nbad = sum(1 for m, _ in REPORT if m == '✘')
    if 'screen' in sys.argv:
        print('\n'.join(screen_model(zh, data)))
    print('\n%s' % ('✅ 文案/主题/色板/状态口径 全部通过' if nbad == 0
                    else '❌ %d 项没通过 —— 修完再出包（build.sh 会因此中止）' % nbad))
    return 0 if nbad == 0 else 1


if __name__ == '__main__':
    sys.exit(main())
