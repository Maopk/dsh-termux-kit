#!/data/data/com.termux/files/usr/bin/bash
# dsh-bridge —— operate **only** the 「DSH 桥」 (the accessibility loopback channel), fully separate from adb.
#
# Why a separate tool: the bridge and adb are two independent lifelines —
#   · bridge: accessibility App + 127.0.0.1:8788 + token, over loopback, **no network needed**;
#   · adb: wireless debugging + the wlan interface, **needs a working Wi-Fi network**.
#   The old 7_reconnect-ai mixed the two (when adb failed it also shouted at the bridge),
#   so you could not tell "the bridge is down" from "adb is not connected". Now each has its own tool.
#
# Usage: 
#   dsh-bridge status   show bridge state (port / real answer / version / paused or not)
#   dsh-bridge wake     wake (a broadcast with the token; when the service was killed it re-authorizes accessibility itself)
#   dsh-bridge stop     soft stop (closes the port and drops the notification; since v1.8 it does not come back on its own; the process stays, one second to recover)
#   dsh-bridge off      hard stop (accessibility goes off too; after that you must enable it by hand or re-authorize with wake)
set -u
HOME_DIR="/data/data/com.termux/files/home"
. "$HOME_DIR/.local/share/dsh-widgets/common.sh"
SOCK="$HOME_DIR/.local/bin/droid-sock"

# 状态记录：端口关着时"软停"和"真停"从 Termux 侧看不出区别，这里记一笔给 UI 用。
# 它只是**记录**不是真相：进程被系统回收时这条会过期 —— 所以 UI 会连"最后心跳"一起显示。

# 状态记录：端口关着时"软停"和"真停"从 Termux 侧看不出区别，这里记一笔给 UI 用。
# 它只是**记录**不是真相：进程被系统回收时这条会过期 —— 所以 UI 会连"最后心跳"一起显示。
note() { printf '%s %s\n' "$1" "$(date +%s)" > "$HOME_DIR/.dsh-bridge-state" 2>/dev/null; }

case "${1:-status}" in
  status)
    if ! port_open 8788; then
      printf 'bridge: not listening (8788 closed)\n'
      exit 2
    fi
    P=$(timeout 12 "$SOCK" ping 2>/dev/null || true)
    if printf '%s' "$P" | grep -q '"pong": true'; then
      V=$(printf '%s' "$P" | grep -oE '"ver": *"[^"]*"' | grep -oE '[0-9.]+')
      PA=$(printf '%s' "$P" | grep -oE '"paused": *(true|false)' | grep -oE '(true|false)')
      printf 'bridge: listening and answering  version v%s  paused=%s\n' "${V:-?}" "${PA:-?}"
      exit 0
    fi
    printf 'bridge: the port listens but does not answer (likely frozen by the system) → try dsh-bridge wake\n'
    exit 3
    ;;
  wake)
    if bridge_alive; then ok "the bridge was already answering; no wake needed"; exit 0; fi
    printf '→ waking the bridge (broadcast with token)…\n'
    bridge_wake
    if bridge_alive; then
      ok "bridge is awake"
      exit 0
    fi
    bridge_wake
    if bridge_alive; then ok "bridge is awake (second beat)"; exit 0; fi
    bad "the bridge did not come up: token revoked or accessibility off (设置 → 无障碍 → DSH 桥)"
    exit 1
    ;;
  # ── state note ──
  # Why: with the port closed, soft-stop and full-stop look identical from Termux, so the UIs could not
  # tell the bridge's four states apart (running / soft-stopped / fully stopped / not installed). This
  # file records which one the tools put it in. It is a *note*, not the truth: if the system reclaimed
  # the process, the note goes stale — which is exactly why the UI shows it together with a heartbeat.
  stop)
    if ! port_open 8788; then ok "the bridge was not listening anyway"; exit 0; fi
    timeout 15 "$SOCK" stop >/dev/null 2>&1 && { sleep 1; port_open 8788 && warn "still listening" || { ok "soft-stopped (the process stays; wake restores it in a second)"; note soft; }; } \
      || bad "the stop command did not succeed"
    ;;
  off)
    timeout 20 "$SOCK" sleep >/dev/null 2>&1 && { sleep 1; port_open 8788 && warn "still listening" || { ok "hard-stopped (accessibility is off too)"; note full; }; } \
      || bad "the sleep command did not succeed"
    ;;
  *) sed -n '2,20p' "$0"; exit 2 ;;
esac
