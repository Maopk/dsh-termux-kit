#!/data/data/com.termux/files/usr/bin/bash
# dsh-relink-bundles —— re-link the built-in DSH runtime bundles back into the profile node_modules
#
# Why this exists (really hit on 2026-09-26):
#   `@deepseek-ai/dsh-base` and `@deepseek-ai/dsh-web-app` are **not pnpm dependencies**
#   (they are in neither the profile package.json nor pnpm-lock.yaml); they are symlinks into the DSH runtime.
#   so one ordinary `pnpm install` in the profile dir makes pnpm prune them as "extra packages":
#     Packages: +3 -19
#   → the client bundle (those 60 built-in client modules) cannot be assembled → the page reports
#     「Failed to load plugins … client-modules: bundle script /plugins/??… failed to load」
#   (the server returns 404 for /plugins/??…, so the browser cannot load it.)
#
# Usage: dsh-relink-bundles [--check]      # --check check only, change nothing (for the self-test suite)
set -u
RT="${DSH_RUNTIME:-$HOME/.local/opt/dsh-termux-runtime/work}"
PROFILE="${DSH_PROFILE_DIR:-$HOME/.dsh/profiles/web}"
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1
PKGS="dsh-base dsh-web-app"
miss=0
for p in $PKGS; do
  src="$RT/node_modules/@deepseek-ai/$p"
  dst="$PROFILE/node_modules/@deepseek-ai/$p"
  if [ ! -d "$src" ]; then
    printf '✘ the runtime does not have %s (%s) — fix the DSH runtime first\n' "$p" "$src" >&2
    miss=$((miss+1)); continue
  fi
  if [ -e "$dst" ]; then
    printf '✔ %s is present (%s)\n' "$p" "$(readlink "$dst" 2>/dev/null || echo dir)"
  elif [ "$CHECK" = 1 ]; then
    printf '✘ %s missing: %s (run dsh-relink-bundles once to fix)\n' "$p" "$dst" >&2
    miss=$((miss+1))
  else
    mkdir -p "$(dirname "$dst")"
    ln -sfn "$src" "$dst" && printf '＋ re-linked %s → %s\n' "$dst" "$src"
  fi
done
# Also check that the other packages in the bundles list exist (a missing one is obvious at a glance)
python3 - "$PROFILE" <<'PY' 2>/dev/null || true
import json, os, sys
prof = sys.argv[1]
try:
    d = json.load(open(os.path.join(prof, 'package.json'), encoding='utf-8'))
except Exception:
    sys.exit(0)
bs = ((d.get('dsh') or {}).get('profile') or {}).get('bundles') or []
missing = [b for b in bs if not os.path.exists(os.path.join(prof, 'node_modules', b, 'package.json'))]
if missing:
    print('⚠ still missing from bundles: ' + ', '.join(missing))
else:
    print('✔ all %d entries of the bundles list are in place' % len(bs))
PY
[ "$miss" = 0 ] || exit 1
printf '\nNote: after re-linking, just **refresh the page** (no DSH restart needed — the route assembles the bundle per request).\n'
