#!/data/data/com.termux/files/usr/bin/python3
# droid-sock —— talk to the self-built 「DSH 桥」 App (127.0.0.1:8788, token auth)
# Usage (aligned with droid / droid-hub): 
#   droid-sock ping | cur | ui [keyword] | shot [path]
#   droid-sock tap X Y | longpress X Y [ms] | swipe x1 y1 x2 y2 [ms]
#   droid-sock text 'text' | key back|home|recents|notifications | start <package>
# token: write it into ~/.dsh-bridge-token first
import base64
import json
import os
import socket
import sys
import time

HOST = '127.0.0.1'
PORT = 8788
TOKEN_FILE = os.path.expanduser('~/.dsh-bridge-token')
IMG_DIR = os.path.expanduser('~/storage/downloads/dsh/图片')


def load_token():
    if os.path.exists(TOKEN_FILE):
        t = open(TOKEN_FILE, encoding='utf-8').read().strip()
        if t:
            return t
    return os.environ.get('DSH_BRIDGE_TOKEN', '').strip()


def wake_bridge(stage=1):
    """Wake the bridge: stage=1 uses an explicit broadcast (does not disturb the user); stage=2 raises the UI (it takes the foreground)

    The broadcast carries the token: since bridge v1.7 it is used for re-authorization — after a soft stop or self-kill the system unbinds accessibility,
    and only a wake with the right token may re-attach itself to accessibility (otherwise any App could raise it).
    Older bridges ignore this extra and behave as before.
    """
    import subprocess
    try:
        if stage == 1:
            cmd = ['am', 'broadcast', '-a', 'io.dsh.bridge.WAKE',
                   '-n', 'io.dsh.bridge/.WakeReceiver']
            tok = load_token()
            if tok:
                cmd += ['--es', 'token', tok]
            subprocess.run(cmd, capture_output=True, timeout=10)
            time.sleep(1.5)
        else:
            subprocess.run(['am', 'start', '-n', 'io.dsh.bridge/.MainActivity'],
                           capture_output=True, timeout=10)
            time.sleep(2.0)
    except Exception:
        return False
    return True


def _connect_once(timeout):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect((HOST, PORT))
    return s


def call(obj, timeout=40):
    tok = load_token()
    if not tok:
        print('❌ no token yet. Open the 「DSH 桥」 App on the phone and send me the token it shows,'
              'or write it into ' + TOKEN_FILE, file=sys.stderr)
        sys.exit(2)
    req = dict(obj)
    req['token'] = tok
    try:
        s = _connect_once(timeout)
    except Exception as first:
        # staged wake: ① broadcast (silent, does not disturb) → ② raise the UI (fallback)
        # ⚠ 2026-09-27 lesson: a broadcast **cannot wake an already dead App process** (Android background start limits),
        #   and stage 2 used to be blocked by DSH_BRIDGE_WAKE_UI=1 → once the bridge died it never came back and you had to tap the icon by hand.
        #   Now stage 2 runs by default (cost: the bridge UI is pulled to the foreground once); to avoid that set
        #   DSH_BRIDGE_NO_UI=1 to disable the fallback.
        s = None
        if os.environ.get('DSH_BRIDGE_NO_UI') == '1':
            stages = (1,)
        else:
            stages = (1, 2)
        for stage in stages:
            wake_bridge(stage)
            try:
                s = _connect_once(timeout)
                break
            except Exception:
                s = None
        if s is None:
            print('❌ cannot reach the DSH bridge (%s:%d): both the broadcast wake and raising the bridge UI failed\n'
                  '   check that 「DSH 桥」 is enabled in accessibility (re-enabling must be confirmed by you in system settings)'
                  % (HOST, PORT), file=sys.stderr)
            sys.exit(3)
    s.sendall((json.dumps(req, ensure_ascii=False) + '\n').encode('utf-8'))
    buf = b''
    try:
        while not buf.endswith(b'\n'):
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            buf += chunk
    finally:
        s.close()
    if not buf:
        print('❌ no response', file=sys.stderr)
        sys.exit(4)
    return json.loads(buf.decode('utf-8', 'replace'))


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__ or '')
        print('Usage: droid-sock ping|cur|ui|shot|tap|longpress|swipe|text|key|start|screen ...')
        print('      droid-sock ping --fast   # probe once, no wake (for cases like status collection that "must be fast")')
        return 2
    # --fast: a single connection that returns at once on failure, **with no wake ladder**.
    # Why: dsh-status-pub must answer the console APK inside its timeout window,
    # while the default call() uses "broadcast + UI raise" when the port listens but the service is frozen (up to 14s) → the whole call times out.
    FAST = '--fast' in a
    a = [x for x in a if x != '--fast']
    if FAST:
        global call
        def call(obj, timeout=3):
            try:
                s = _connect_once(3)
            except Exception as e:
                print('❌ bridge did not answer (--fast, no wake): %s' % e, file=sys.stderr)
                sys.exit(3)
            tok = load_token()
            if not tok:
                print('❌ no token', file=sys.stderr)
                sys.exit(2)
            req = dict(obj); req['token'] = tok
            s.sendall((json.dumps(req, ensure_ascii=False) + '\n').encode('utf-8'))
            buf = b''
            try:
                while not buf.endswith(b'\n'):
                    chunk = s.recv(1 << 16)
                    if not chunk: break
                    buf += chunk
            finally:
                s.close()
            if not buf:
                print('❌ no response', file=sys.stderr); sys.exit(4)
            return json.loads(buf.decode('utf-8', 'replace'))
    k = a[0]
    if k == 'ping':
        r = call({'action': 'ping'})
    elif k == 'cur':
        r = call({'action': 'cur'})
    elif k == 'netstate':      # Wi-Fi switch + whether the internet really works (bridge direct test)
        r = call({'action': 'netstate'}, timeout=15)
    elif k == 'adbwifi':       # toggle 「无线调试」 (needs WRITE_SECURE_SETTINGS)
        r = call({'action': 'adbwifi', 'value': int(a[1]) if len(a) > 1 else 1}, timeout=15)
    elif k == 'caps':          # list of actions the bridge supports (to tell versions apart; old ones return an error)
        r = call({'action': 'caps'}, timeout=15)
    elif k == 'sleep':         # hard stop (v1.7+): close the port + stop the foreground service + disable its own accessibility; it does not come back
        r = call({'action': 'sleep'}, timeout=20)
    elif k == 'wake':          # wake only, no data (with a token, v1.7 can re-authorize accessibility)
        wake_bridge(1)
        print('wake broadcast sent')
        return 0
    elif k == 'stop':          # soft stop: closes only the port, accessibility stays (used to verify the broadcast wake)
        r = call({'action': 'stop'})
    elif k == 'screen':        # keep the screen awake before bridge work / restore it after
        # screen keep | restore | status | set:<毫秒>
        # screen keep | restore | status | set <毫秒>   —— 桥那边认的是 'set:<毫秒>' 一个 token
        _v = 'status'
        if len(a) > 1 and a[1]:
            _v = ('set:' + a[2]) if (a[1] == 'set' and len(a) > 2) else a[1]
        r = call({'action': 'screen', 'value': _v}, timeout=15)
    elif k == 'panic':         # panic: close the port + disable accessibility
        r = call({'action': 'panic'})
    elif k == 'ui':
        r = call({'action': 'ui', 'keyword': a[1] if len(a) > 1 else '',
                  'limit': int(a[2]) if len(a) > 2 else 40})
    elif k == 'shot':
        r = call({'action': 'shot'}, timeout=60)
    elif k == 'tap':
        r = call({'action': 'tap', 'x': int(a[1]), 'y': int(a[2])})
    elif k == 'longpress':
        r = call({'action': 'longpress', 'x': int(a[1]), 'y': int(a[2]),
                  'ms': int(a[3]) if len(a) > 3 else 800})
    elif k == 'swipe':
        r = call({'action': 'swipe', 'x1': int(a[1]), 'y1': int(a[2]),
                  'x2': int(a[3]), 'y2': int(a[4]), 'ms': int(a[5]) if len(a) > 5 else 300})
    elif k == 'text':
        r = call({'action': 'text', 'value': a[1] if len(a) > 1 else ''})
    elif k == 'lang':
        # Push the language into the bridge (it cannot read ~/.dsh-lang itself).
        r = call({'action': 'lang', 'value': a[1] if len(a) > 1 else ''}, timeout=8)
    elif k == 'key':
        r = call({'action': 'key', 'value': a[1] if len(a) > 1 else 'back'})
    elif k == 'start':
        r = call({'action': 'start', 'value': a[1]})
    else:
        print('unknown usage: ' + k, file=sys.stderr)
        return 2

    if not r.get('ok'):
        print('❌ ' + str(r.get('error')), file=sys.stderr)
        return 1
    d = r.get('data') or {}

    if 'png' in d:
        os.makedirs(IMG_DIR, exist_ok=True)
        path = a[1] if len(a) > 1 else os.path.join(IMG_DIR, 'droid-%s.png' % time.strftime('%Y%m%d-%H%M%S'))
        raw = base64.b64decode(d['png'])
        open(path, 'wb').write(raw)
        print('screenshot saved: %s (%.1f KB)' % (path, len(raw) / 1024))
        return 0

    if 'nodes' in d:
        for n in d['nodes']:
            c = n.get('center') or [0, 0]
            print('  [%d,%d] %-18s text=%-42s desc=%-24s id=%s' % (
                c[0], c[1], n.get('cls', ''), repr(n.get('text', ''))[:42],
                repr(n.get('desc', ''))[:24], (n.get('id', '') or '')[-30:]))
        print('  %d nodes' % d.get('count', 0))
        return 0

    print('✅ ' + json.dumps(d, ensure_ascii=False)[:800])
    return 0


if __name__ == '__main__':
    sys.exit(main())
