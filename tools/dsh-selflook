#!/data/data/com.termux/files/usr/bin/bash
# dsh-selflook —— trigger a DSH UI self-screenshot and wait for the result
# Needs the dynamic plugin look-1 (self-look) running, with the DSH page open in a browser
# Usage: dsh-selflook [wait seconds]
set -u

HOME_DIR="/data/data/com.termux/files/home"
REQ="$HOME_DIR/.dsh-look-request"
LAST="$HOME_DIR/.dsh-look-last.txt"
WAIT="${1:-40}"

OLD="$(cat "$LAST" 2>/dev/null || echo '')"
touch "$REQ"

echo "screenshot requested, waiting for the result (up to ${WAIT}s)…"
for i in $(seq 1 "$WAIT"); do
  sleep 1
  NEW="$(cat "$LAST" 2>/dev/null || echo '')"
  if [ -n "$NEW" ] && [ "$NEW" != "$OLD" ] && [ -s "$NEW" ]; then
    echo "new screenshot: $NEW ($(du -h "$NEW" 2>/dev/null | cut -f1))"
    exit 0
  fi
done

echo "Timeout: no screenshot arrived. Check ① whether plugin look-1 is approved and running ② whether the DSH page is open in a browser" >&2
exit 1
