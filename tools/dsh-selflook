#!/data/data/com.termux/files/usr/bin/bash
# dsh-selflook —— 触发 DSH 界面自截图，并等待结果
# 依赖：动态插件 look-1（self-look）处于运行状态，且 DSH 页面在浏览器中打开
# 用法：dsh-selflook [等待秒数]
set -u

HOME_DIR="/data/data/com.termux/files/home"
REQ="$HOME_DIR/.dsh-look-request"
LAST="$HOME_DIR/.dsh-look-last.txt"
WAIT="${1:-40}"

OLD="$(cat "$LAST" 2>/dev/null || echo '')"
touch "$REQ"

echo "已触发截图请求，等待结果（最多 ${WAIT}s）…"
for i in $(seq 1 "$WAIT"); do
  sleep 1
  NEW="$(cat "$LAST" 2>/dev/null || echo '')"
  if [ -n "$NEW" ] && [ "$NEW" != "$OLD" ] && [ -s "$NEW" ]; then
    echo "新截图: $NEW ($(du -h "$NEW" 2>/dev/null | cut -f1))"
    exit 0
  fi
done

echo "超时：未收到截图。请检查 ① 插件 look-1 是否已批准运行 ② DSH 页面是否在浏览器中打开" >&2
exit 1
