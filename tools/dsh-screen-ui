#!/data/data/com.termux/files/usr/bin/bash
# dsh-screen-ui —— 在「设置 → 显示 → 自动锁屏」里改那一项。**轻划一下就够了，不整屏大滑。**
#
# 为什么在这个界面改，而不是直接写 Settings.System.SCREEN_OFF_TIMEOUT：
#   写的是同一个值，但**用户看得见的只有这个界面**。程序改完又改回去，他任何时候去看都是原值，
#   从他那侧只能得出"根本没生效"。就在这个界面改，他能亲眼看到。
#
# 用户给的原话（照做，别自作聪明）：
#   「你要么滑到最上面，要么滑到最下面了，但是那个自动锁屏的选项是在中间，所以你每次都错过」
#   「你只要轻划一下就能看」
#   → 打开这一页后**最多轻划 2 下**（每下 300px），找到就点。
#   → OCR 只认「自动锁」前缀：tesseract 把「自动锁屏」读成过「自动锁居」「自动锁愤」，认全名会漏；
#     但也不能只认「锁」——「竖屏锁定」里也有一个锁。
#
# Usage: dsh-screen-ui 永不 | 1 分钟 | 30 分钟 | 15 秒 …
#
# ⚠ 状态（2026-09-27，诚实标注）：**这条路我还没跑通过。**
#   已经修对的地方：轻划方向、双向扫描、按行合并 OCR（tesseract 把「自动锁屏」切成
#   「自动」+「锁」两个词，逐词匹配永远找不到）、"设置必须在前台"的前置检查。
#   但实测仍没稳定找到那一行 —— 而且在人正用手机时（打游戏/聊天）截图经常根本不是设置页。
#   **确定能用的是 `dsh-screen keep|restore`**（程序写同一个设置项，实测 keep 后 75 秒屏幕仍亮、
#   restore 回到 60000）。要改这一项又不想赌 UI 的话，用那个；这个脚本留给"非要用界面"的场合。
set -u
SOCK="$HOME/.local/bin/droid-sock"
IMG="$HOME/.smoke/scrui.png"

step() { printf '\n▶ %s\n' "$*"; }
ok()   { printf '   ✔ %s\n' "$*"; }
warn() { printf '   ⚠ %s\n' "$*"; }
bad()  { printf '   ✘ %s\n' "$*" >&2; }

# 截图 + OCR，返回匹配文字的**真实屏幕坐标** "x y 文字"
# （tesseract tsv 给屏幕像素；无障碍树给"内容坐标"，滚动后和屏幕对不上 —— 这正是之前点空的原因）
ocr_find() {
  timeout 12 "$SOCK" cur 2>/dev/null | grep -q "com.android.settings" || return 1
  timeout 40 "$SOCK" shot "$IMG" >/dev/null 2>&1
  [ -s "$IMG" ] || return 1
  timeout 90 tesseract "$IMG" stdout -l chi_sim tsv 2>/dev/null | python3 -c '
import sys, re
rx = re.compile(sys.argv[1])
words = []
for line in sys.stdin:
    f = line.rstrip("\n").split("\t")
    if len(f) < 12: continue
    try: conf = float(f[10])
    except Exception: continue
    t = f[11].strip()
    if conf < 20 or not t: continue
    words.append((int(f[6]), int(f[7]), int(f[8]), int(f[9]), t))
# ⚠ 必须**按行合并**再匹配：tesseract 把「自动锁屏」切成「自动」和「锁」两个词
#   （实测 conf 93/51），逐词匹配永远找不到「自动锁」。
lines = {}
for x, y, w, h, t in words:
    key = None
    for k in lines:
        if abs(k - y) <= 40: key = k; break
    if key is None: key = y; lines[key] = []
    lines[key].append((x, y, w, h, t))
best = None
for k, ws in lines.items():
    ws.sort()
    text = "".join(w[4] for w in ws)
    if not rx.search(text): continue
    x = min(w[0] for w in ws); y = min(w[1] for w in ws)
    if best is None or y < best[1]: best = (x + 60, y + 30, text)
print("%d %d %s" % best if best else "")
' "$1"
}

# ⚠ 方向：手指**从下往上**划 = 内容往下走 = 露出**下面**的条目。
#   我第一版写反了（720 1100 → 720 1400 是手指向下，内容往上走），于是越划离目标越远。
light() { timeout 20 "$SOCK" swipe 720 1400 720 1100 220 >/dev/null 2>&1; sleep 1.2; }

WANT="${1:?用法: dsh-screen-ui 永不|1 分钟|30 分钟}"

step "打开 设置 → 显示"
# 每张截图前先确认"设置真的在前台"：用户随时可能在用手机，截到聊天页就会误判成"找不到那一行"。
ensure_settings() {
  local i
  for i in 1 2 3; do
    if timeout 12 "$SOCK" cur 2>/dev/null | grep -q 'com.android.settings'; then return 0; fi
    timeout 20 am start -a android.settings.DISPLAY_SETTINGS >/dev/null 2>&1
    sleep 3
  done
  return 1
}
for _ in 1 2 3; do
  timeout 20 am start -a android.settings.DISPLAY_SETTINGS >/dev/null 2>&1
  sleep 3
  timeout 12 "$SOCK" cur 2>/dev/null | grep -q 'com.android.settings' && break
done
timeout 12 "$SOCK" cur 2>/dev/null | grep -q 'com.android.settings' \
  && ok "设置已在前台" || { bad "打不开设置（前台不是它）—— 你可能正在用手机"; exit 1; }

step "找「自动锁屏」（最多轻划 2 下）"
ROW=""
# 从页面顶部开始，目标在第 6~8 行左右 → 允许最多 5 次小步（每次 300px，找到就停，不会滑过头）
for i in 1 2 3 4 5; do
  R=$(ocr_find '自动锁' || true)
  [ -z "$R" ] && R=$(ocr_find '锁屏' || true)
  if [ -n "$R" ]; then set -- $R; ROW="$1 $2"; ok "第 $i 次看到「$3」 在 ($1,$2)"; break; fi
  warn "第 $i 次没看到，轻划一下"
  light
done
# 往下扫没找到，就**反向**往上扫：每次打开这一页的起始位置并不固定（可能停在目标下方），
# 只朝一个方向扫必然有一半情况错过 —— 这正是"你每次都错过"的根因。
if [ -z "$ROW" ]; then
  warn "往下扫没找到，改往上找"
  for i in 1 2 3 4 5 6 7 8; do
    # 反向 = 手指**从上往下**划（内容往上走，露出**上面**的条目）
    # ⚠ 第一版这里复制成了和正向一样的坐标，等于没反向。
    timeout 20 "$SOCK" swipe 720 1100 720 1400 220 >/dev/null 2>&1
    sleep 1.0
    R=$(ocr_find '自动锁' || true)
    [ -z "$R" ] && R=$(ocr_find '锁屏' || true)
    if [ -n "$R" ]; then set -- $R; ROW="$1 $2"; ok "往上第 $i 次看到「$3」 在 ($1,$2)"; break; fi
  done
fi
[ -n "$ROW" ] || { bad "上下都扫过了还是没有「自动锁屏」—— 版面可能变了"; exit 1; }

step "点开这一行"
timeout 20 "$SOCK" tap $ROW >/dev/null 2>&1
sleep 2

step "选「$WANT」"
OPT=$(ocr_find "$WANT" || true)
if [ -z "$OPT" ]; then
  bad "选项里没认出「$WANT」；屏幕上认到的候选（自己看一眼再决定）："
  ocr_find '永不|[0-9]+ *(分钟|秒)' || true
  exit 1
fi
set -- $OPT
ok "「$3」 在 ($1,$2)"
timeout 20 "$SOCK" tap "$1" "$2" >/dev/null 2>&1
sleep 2

step "复核"
V=$(ocr_find '自动锁' || true)
if [ -n "$V" ]; then
  set -- $V
  timeout 40 "$SOCK" shot "$IMG" >/dev/null 2>&1
  timeout 60 magick "$IMG" -crop "760x90+680+$(( $2 - 45 ))" +repage "$HOME/.smoke/scrval.png" 2>/dev/null
  NOW=$(timeout 60 tesseract "$HOME/.smoke/scrval.png" stdout -l chi_sim 2>/dev/null | tr -d ' \n')
  ok "「自动锁屏」现在 = ${NOW:-（读不出）}"
  case "$NOW" in *"$WANT"*) ok "与要求一致 ✅" ;; *) warn "读到的和「$WANT」不完全一样，请自己瞄一眼" ;; esac
else
  warn "复核时没看到那一行（可能弹窗还开着），请自己瞄一眼"
fi
