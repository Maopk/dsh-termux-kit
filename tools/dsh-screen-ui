#!/data/data/com.termux/files/usr/bin/bash
# dsh-screen-ui —— 在「设置 → 显示 → 自动锁屏」里改这一项（用户要的就是这个界面上的设置）
#
# 配方是用户教的，实测走通（2026-09-27）：
#   「你进入那个设置界面，然后轻滑一下，然后识屏，你就能看到那个了」
#
# 关键的两条（踩了很久才明白）：
#   ① **列表页**：无障碍树给的是"内容坐标"，页面一滚它就不等于屏幕位置 —— 照它点会点到别处。
#      所以列表页只信 **截图 + OCR（tesseract tsv 给屏幕像素）**；而且 tesseract 会把
#      「自动锁屏」切成「自动」+「锁」两个词、还读成「自动锁居/自动锁愤」→ 必须**按行合并**再匹配「自动锁」。
#   ② **弹窗**：弹窗不滚动，树里的坐标**就是准的**，而且每个选项都带文字（desc='1 分钟' 等）→
#      弹窗里直接用树，比 OCR 稳得多。
#
# 另外：用户提醒过"别滑过头" —— 所以只轻滑 1 次（300px），找不到就再轻滑 1 次，最多 3 次。
#
# Usage: dsh-screen-ui 15 秒 | 30 秒 | 1 分钟 | 2 分钟 | 5 分钟 | 10 分钟
#   ⚠ 这 ROM 的菜单**最多 10 分钟、没有「永不」**（写 1800000 系统收，但菜单里没有对应项，
#     那一行会显示成空值 —— 用户看到的"奇怪状态"就是这么来的）。要"别灭屏"请用 dsh-screen keep。
set -u
SOCK="$HOME/.local/bin/droid-sock"
IMG="$HOME/.smoke/scrui.png"

step() { printf '\n▶ %s\n' "$*"; }
ok()   { printf '   ✔ %s\n' "$*"; }
warn() { printf '   ⚠ %s\n' "$*"; }
bad()  { printf '   ✘ %s\n' "$*" >&2; }

in_settings() { timeout 12 "$SOCK" cur 2>/dev/null | grep -q 'com.android.settings'; }

# 截图 + OCR：按行合并词后匹配，返回该行的屏幕坐标 "x y"
ocr_row() {
  in_settings || return 1
  timeout 40 "$SOCK" shot "$IMG" >/dev/null 2>&1
  [ -s "$IMG" ] || return 1
  timeout 90 tesseract "$IMG" stdout -l chi_sim tsv 2>/dev/null | python3 -c '
import sys, re
rx = re.compile(sys.argv[1]); words = []
for line in sys.stdin:
    f = line.rstrip("\n").split("\t")
    if len(f) < 12: continue
    try: conf = float(f[10])
    except Exception: continue
    t = f[11].strip()
    if conf < 20 or not t: continue
    words.append((int(f[6]), int(f[7]), int(f[8]), int(f[9]), t))
lines = {}
for x, y, w, h, t in words:                      # 同一行的词并起来再匹配
    k = next((k for k in lines if abs(k - y) <= 40), None)
    if k is None: k = y; lines[k] = []
    lines[k].append((x, y, w, h, t))
best = None
for k, ws in lines.items():
    text = "".join(w[4] for w in sorted(ws))
    if not rx.search(text): continue
    y = min(w[1] for w in ws); h = max(w[3] for w in ws)
    if best is None or y < best[0]: best = (y, y + h // 2, text)
print("%d %d %s" % best if best else "")
' "$1"
}

# 弹窗里按**文字**找选项（树里每个 RadioButton 都带 desc）
tree_tap() {   # $1 = 选项文字；返回 2 = 设置已不在前台（拒绝盲点）
  in_settings || return 2
  local y
  y=$(timeout 25 "$SOCK" ui '' 80 2>/dev/null | awk -v w="$1" '
    index($0, "desc=\x27" w "\x27") > 0 {
      match($0, /\[[0-9]+,[0-9]+\]/);
      if (RSTART > 0) { split(substr($0,RSTART+1,RLENGTH-2), p, ","); print p[2]; exit } }')
  [ -n "$y" ] || return 1
  timeout 20 "$SOCK" tap 720 "$y" >/dev/null 2>&1
  return 0
}

row_value() {  # 从树里读「自动锁屏」那一行的当前值
  timeout 25 "$SOCK" ui '' 200 2>/dev/null | grep -A1 "text='自动锁屏'" | tail -1 \
    | sed -n "s/.*text='\([^']*\)'.*/\1/p"
}

WANT="${1:?用法: dsh-screen-ui 15 秒|30 秒|1 分钟|2 分钟|5 分钟|10 分钟（本 ROM 没有「永不」）}"

# ⚠ 全程保持屏幕常亮：这个流程要跑一两分钟（每步一次截图+OCR），而用户的超时是 1 分钟 ——
#   实测跑一半屏幕就灭了，截图是黑的、OCR 什么都读不到，于是"找不到那一行"。
#   这跟装包工具是同一个毛病，处理方式也一样：进来 keep，退出（含失败/中断）restore。
SCREEN="$HOME/.local/bin/dsh-screen"
PREV_PKG=$(timeout 12 "$SOCK" cur 2>/dev/null | sed -n 's/.*"pkg": *"\([^"]*\)".*/\1/p')
cleanup() {
  [ -x "$SCREEN" ] && "$SCREEN" restore >/dev/null 2>&1 || true
  # 把你原来那个 App 还给你：跑这一趟不该把你从正在看的页面踢走（用户的明确忌讳）
  # 三级兜底（桥的 start 最不可靠：桥没声明 <queries>，Android 11+ 包可见性让它对
  # Chrome/Clash 一律 getLaunchIntentForPackage=null → "App not found"）：
  #   ① 桥 start  ② am start（Termux=shell 身份，不受包可见性限制）  ③ 浏览器专用 VIEW intent
  if [ -n "$PREV_PKG" ] && [ "$PREV_PKG" != "com.android.settings" ]; then
    if timeout 25 "$SOCK" start "$PREV_PKG" >/dev/null 2>&1; then
      printf '   ↩ 前台已切回 %s（桥 start）\n' "$PREV_PKG"
    elif timeout 25 am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER \
           -p "$PREV_PKG" >/dev/null 2>&1; then
      printf '   ↩ 前台已切回 %s（am start）\n' "$PREV_PKG"
    elif printf '%s' "$PREV_PKG" | grep -qE 'chrome|firefox|browser|webview'; then
      timeout 40 "$HOME/.local/bin/dsh-browser-open" "$(cat "$HOME/.dsh-url" 2>/dev/null || echo http://127.0.0.1:8080)" --quiet >/dev/null 2>&1 || true
      printf '   ↩ 用 VIEW intent 兜底切回浏览器\n'
    else
      printf '   ⚠ 没能自动切回 %s，按一下最近任务即可\n' "$PREV_PKG"
    fi
  fi
}
[ -x "$SCREEN" ] && "$SCREEN" keep >/dev/null 2>&1 || true
trap cleanup EXIT INT TERM

step "打开 设置 → 显示"
for _ in 1 2 3; do
  timeout 20 am start -a android.settings.DISPLAY_SETTINGS >/dev/null 2>&1
  sleep 3
  in_settings && break
done
in_settings || { bad "设置没在前台（你可能正在用手机）"; exit 1; }
ok "设置在前台"

step "轻滑一下找「自动锁屏」（最多 3 次，每次 300px）"
ROW_Y=""
for i in 1 2 3; do
  R=$(ocr_row '自动锁' || true)
  [ -z "$R" ] && R=$(ocr_row '锁屏' || true)
  if [ -n "$R" ]; then set -- $R; ROW_Y="$2"; ok "第 $i 次看到「$3」 → 点 (720,$2)"; break; fi
  warn "第 $i 次没看到，轻滑一下"
  timeout 20 "$SOCK" swipe 720 1400 720 1100 240 >/dev/null 2>&1
  sleep 1.3
done
# 往下没找到就**反向**找：每次进这一页的起始滚动位置并不固定（可能停在目标下方），
# 只朝一个方向扫必然有一半情况错过 —— 这正是"你每次都错过"的根因。
if [ -z "$ROW_Y" ]; then
  warn "往下没找到，改往上找"
  for i in 1 2 3 4 5 6; do
    # 反向 = 手指**从上往下**划（内容往上走，露出上面的条目）
    timeout 20 "$SOCK" swipe 720 1100 720 1400 240 >/dev/null 2>&1
    sleep 1.2
    R=$(ocr_row '自动锁' || true)
    [ -z "$R" ] && R=$(ocr_row '锁屏' || true)
    if [ -n "$R" ]; then set -- $R; ROW_Y="$2"; ok "往上第 $i 次看到「$3」 → 点 (720,$2)"; break; fi
  done
fi
[ -n "$ROW_Y" ] || { bad "上下都扫过了还是没有那一行"; exit 1; }

step "点开它"
in_settings || { bad "设置已经不在前台了（你可能接管了手机）—— 不点，直接停手"; exit 1; }
timeout 20 "$SOCK" tap 720 "$ROW_Y" >/dev/null 2>&1
sleep 2

step "在弹窗里选「$WANT」（弹窗用无障碍树，坐标是准的）"
tree_tap "$WANT"; RC=$?
if [ "$RC" = 0 ]; then ok "已点「$WANT」"
elif [ "$RC" = 2 ]; then bad "设置已经不在前台了 —— 不点，直接停手"; exit 1
else
  bad "弹窗里没有「$WANT」；树里认到的选项："
  timeout 25 "$SOCK" ui '' 80 2>/dev/null | sed -n "s/.*desc='\([^']*\)'.*/   \1/p" | grep -E '秒|分钟|取消' | head -8
  exit 1
fi
sleep 2

step "复核（读树里那一行的值）"
V=$(row_value)
if [ -n "$V" ]; then
  ok "「自动锁屏」现在 = $V"
  case "$V" in *"$WANT"*) ok "与要求一致 ✅" ;; *) warn "读到的和「$WANT」不一样，请自己瞄一眼" ;; esac
else
  warn "复核时没读到那一行（可能弹窗还开着）"
fi
