#!/data/data/com.termux/files/usr/bin/bash
# clash-doctor —— one-page self-check for Clash Meta for Android (the nastiest traps on this phone)
#
# Why it exists: one night on 2026-09-27 "Clash could not open even GitHub", and the root cause was
#   **the provider node domain was eaten by the Clash fake-ip** (resolved to 198.18.x.x),
#   mihomo refuses to use a FakeIP to reach a proxy server → every node request got a 502,
#   the Clash log said: `dial <group name> ... error: connect error: dns resolve failed: couldn't find ip`.
#   direct domestic links (Baidu/WeChat) were fine, so it looked like "the provider was down", but it was not.
#
# Usage: clash-doctor [node domain]        # with no domain, one is picked from ~/.clash-opt/*.yaml
# Exit codes: 0 all good; 1 a clear fault (with a next step)
set -u
SOCKS_PORT=7890
PROXY="http://127.0.0.1:${SOCKS_PORT}"
ok()   { printf '   ✔ %s\n' "$*"; }
warn() { printf '   ⚠ %s\n' "$*"; }
bad()  { printf '   ✘ %s\n' "$*"; }
step() { printf '\n▶ %s\n' "$*"; }
port_open() { (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null && exec 3<&- 3>&-; }

FAIL=0

step "① is the Clash core there (mixed port ${SOCKS_PORT})"
if port_open "$SOCKS_PORT"; then ok "port is listening — core is running"
else bad "port is not listening — turn on the Clash main switch (Running)"; exit 1; fi

step "② direct domestic link and DNS hijack are healthy"
C=$(curl -s -o /dev/null -m 8 -w '%{http_code}' https://www.baidu.com 2>/dev/null)
[ "$C" = 200 ] && ok "baidu 200 (direct link + DNS hijack fine)" || { bad "baidu $C — the phone itself has no network?"; FAIL=1; }

step "③ can traffic go through a node (proxy)"
C1=$(curl -s -o /dev/null -m 12 -w '%{http_code}' -x "$PROXY" http://www.gstatic.com/generate_204 2>/dev/null)
C2=$(curl -s -o /dev/null -m 18 -w '%{http_code}' -x "$PROXY" https://github.com 2>/dev/null)
printf '   gstatic204=%s   github=%s\n' "$C1" "$C2"
if [ "$C1" = 204 ] || [ "$C2" = 200 ]; then ok "proxy path is fine"
else bad "proxy is dead (502/000) — see step ④"; FAIL=1; fi

step "④ was the node domain eaten by fake-ip (the nastiest one: direct works, all proxies 502)"
DOM="${1:-}"
if [ -z "$DOM" ]; then
  # pick a node domain from the optimized config I generated (reads only the server field, no keys)
  for f in "$HOME"/.clash-opt/*.yaml; do
    [ -f "$f" ] || continue
    DOM=$(grep -oE 'server: *"?[a-z0-9.-]+\.[a-z]{2,}"?' "$f" 2>/dev/null | sed 's/server: *"\?//; s/"$//' \
          | grep -vE '^[0-9.]+$' | sort | uniq -c | sort -rn | head -1 | awk '{print $2}')
    [ -n "$DOM" ] && break
  done
fi
if [ -z "$DOM" ]; then warn "no node domain found (pass one with clash-doctor <domain>)"
else
  IP=$(getent hosts "$DOM" 2>/dev/null | awk '{print $1}' | head -1)
  printf '   %s → %s\n' "$DOM" "${IP:-unresolvable}"
  case "$IP" in
    198.18.*|198.19.*)
      bad "eaten by fake-ip! mihomo will not use a FakeIP to reach a proxy server → all node traffic will fail"
      printf '   Fix (both steps are required):\n'
      printf '     1) Clash → 设置 → 覆写 → DNS → FakeIP 过滤器, add **the whole provider domain**, e.g.:\n'
      printf '          +.%s\n' "${DOM#*.}"
      printf '          (use ~/.local/share/dsh-widgets/clash-override.py list "FakeIP 过滤器" <existing entries...> +.xxx.com)\n'
      printf '     2) **regenerate the config and restart the core**: 配置页 → 点档位 → 更新; then fully exit the App and reopen\n'
      printf '        (tapping 更新 alone does nothing; measured: the core must actually restart)\n'
      FAIL=1 ;;
    "") warn "unresolvable (maybe excluded by the filter → mihomo resolves it internally, which is usually **normal**)" ;;
    *)  ok "resolved to a real IP ($IP), not fake-ip" ;;
  esac
fi

step "⑤ Verdict"
if [ "$FAIL" = 0 ]; then printf '   all good ✅\n'; else
  printf '   fault found ❌ — the step marked ✘ above is the cause\n'
  printf '   How to capture evidence: Clash → 日志 → 「Clash 日志捕捉工具」→ 点此启动 (info level) → reproduce it once more,\n'
  printf '             the log will state it directly: `error: ... dns resolve failed: couldn'"'"'t find ip` — that kind of cause\n'
fi
exit "$FAIL"
