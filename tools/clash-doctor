#!/data/data/com.termux/files/usr/bin/bash
# clash-doctor —— 一页纸自检 Clash Meta for Android（手机上最坑的那几条）
#
# 为什么写它：2026-09-27 半夜出过一次"Clash 连 GitHub 都打不开"，根因是
#   **机场的节点域名被 Clash 自己的 fake-ip 吃掉**（解析成 198.18.x.x），
#   而 mihomo 拒绝拿 FakeIP 去连代理服务器 → 所有走节点的请求 502，
#   Clash 日志原文：`dial <组名> ... error: connect error: dns resolve failed: couldn't find ip`。
#   而国内直连（百度/微信）一切正常，所以很像"机场挂了"，其实不是。
#
# 用法：clash-doctor [节点域名]        # 不给域名就自动从 ~/.clash-opt/*.yaml 里挑一个
# 退出码：0 一切正常；1 有明确故障（并给出下一步）
set -u
SOCKS_PORT=7890
PROXY="http://127.0.0.1:${SOCKS_PORT}"
ok()   { printf '   ✔ %s\n' "$*"; }
warn() { printf '   ⚠ %s\n' "$*"; }
bad()  { printf '   ✘ %s\n' "$*"; }
step() { printf '\n▶ %s\n' "$*"; }
port_open() { (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null && exec 3<&- 3>&-; }

FAIL=0

step "① Clash 核心在不在（混合端口 ${SOCKS_PORT}）"
if port_open "$SOCKS_PORT"; then ok "端口在听 —— 核心运行中"
else bad "端口没在听 —— 先打开 Clash 的主开关（运行中）"; exit 1; fi

step "② 直连（国内）与 DNS 劫持是否正常"
C=$(curl -s -o /dev/null -m 8 -w '%{http_code}' https://www.baidu.com 2>/dev/null)
[ "$C" = 200 ] && ok "baidu 200（直连链路 + DNS 劫持正常）" || { bad "baidu $C —— 手机本身没网？"; FAIL=1; }

step "③ 走节点（代理）通不通"
C1=$(curl -s -o /dev/null -m 12 -w '%{http_code}' -x "$PROXY" http://www.gstatic.com/generate_204 2>/dev/null)
C2=$(curl -s -o /dev/null -m 18 -w '%{http_code}' -x "$PROXY" https://github.com 2>/dev/null)
printf '   gstatic204=%s   github=%s\n' "$C1" "$C2"
if [ "$C1" = 204 ] || [ "$C2" = 200 ]; then ok "代理链路正常"
else bad "代理不通（502/000）—— 见第④步"; FAIL=1; fi

step "④ 节点域名有没有被 fake-ip 吃掉（这条最坑：直连正常、代理全 502）"
DOM="${1:-}"
if [ -z "$DOM" ]; then
  # 从我自己生成的优化配置里挑一个节点域名（只看 server 字段，不碰任何密钥）
  for f in "$HOME"/.clash-opt/*.yaml; do
    [ -f "$f" ] || continue
    DOM=$(grep -oE 'server: *"?[a-z0-9.-]+\.[a-z]{2,}"?' "$f" 2>/dev/null | sed 's/server: *"\?//; s/"$//' \
          | grep -vE '^[0-9.]+$' | sort | uniq -c | sort -rn | head -1 | awk '{print $2}')
    [ -n "$DOM" ] && break
  done
fi
if [ -z "$DOM" ]; then warn "没找到节点域名（可用 clash-doctor <域名> 指定）"
else
  IP=$(getent hosts "$DOM" 2>/dev/null | awk '{print $1}' | head -1)
  printf '   %s → %s\n' "$DOM" "${IP:-（解析不到）}"
  case "$IP" in
    198.18.*|198.19.*)
      bad "被 fake-ip 吃了！mihomo 不会拿 FakeIP 去连代理服务器 → 所有走节点的请求必挂"
      printf '   修法（两步，缺一不可）：\n'
      printf '     1) Clash → 设置 → 覆写 → DNS → FakeIP 过滤器，把 **整个机场域名** 加进去，例如:\n'
      printf '          +.%s\n' "${DOM#*.}"
      printf '          （用 ~/.local/share/dsh-widgets/clash-override.py list "FakeIP 过滤器" <原有条目...> +.xxx.com）\n'
      printf '     2) **让配置重新生成并重启核心**：配置页 → 点档位 → 更新；然后彻底退出 App 重进\n'
      printf '        （只点「更新」不生效，实测必须让核心重启过）\n'
      FAIL=1 ;;
    "") warn "解析不到（可能已被过滤器排除 → 由 mihomo 内部解析，这通常是**正常**的）" ;;
    *)  ok "解析到真实 IP（$IP），不是 fake-ip" ;;
  esac
fi

step "⑤ 结论"
if [ "$FAIL" = 0 ]; then printf '   一切正常 ✅\n'; else
  printf '   有故障 ❌ —— 上面带 ✘ 的那一步就是原因\n'
  printf '   取证办法：Clash → 日志 → 「Clash 日志捕捉工具」→ 点此启动（info 级）→ 再复现一次，\n'
  printf '             日志里会直接写 `error: ... dns resolve failed: couldn'"'"'t find ip` 这类原因\n'
fi
exit "$FAIL"
