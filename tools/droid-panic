#!/data/data/com.termux/files/usr/bin/bash
# droid-panic —— emergency stop: revoke every way the AI can control this phone in one shot
# No screen and no DSH page needed; the Termux home-screen widget 0_emergency-stop calls it.
#
# What it does (top to bottom, and it keeps going even if a step fails):
#   ① make the 「DSH 桥」 kill itself: close port 127.0.0.1:8788 + shut down its own accessibility service
#   ② revoke the token (delete ~/.dsh-bridge-token) — even a listening bridge can no longer send valid commands
#   ③ clear the AutoX bridge command file (the shared-directory channel goes quiet)
#   ④ kill any waiting/looping processes still hanging on my side
#   ⑤ open the system accessibility settings so you can confirm at a glance that 「DSH 桥」 is off
set -u
BRIDGE_TOKEN="$HOME/.dsh-bridge-token"
SHARED="$HOME/storage/shared/dsh-droid"
LOG="$HOME/.droid-panic.log"

note() { printf '%s\n' "$*"; printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

{
  echo "==================== EMERGENCY STOP $(date '+%F %T') ===================="
  note "① telling the DSH bridge to kill itself"
  if [ -x "$HOME/.local/bin/droid-sock" ]; then
    if timeout 8 "$HOME/.local/bin/droid-sock" panic >/dev/null 2>&1; then
      note "   ✔ bridge received panic: port closed + accessibility shut itself down"
    else
      note "   · bridge did not respond (it probably was not running)"
    fi
  fi

  note "② revoking the token"
  if [ -f "$BRIDGE_TOKEN" ]; then
    mv -f "$BRIDGE_TOKEN" "$BRIDGE_TOKEN.revoked-$(date +%s)" 2>/dev/null && note "   ✔ revoked (the old token is renamed and kept for reference)"
  else
    note "   · no token file (it was never authorized)"
  fi

  note "③ clearing the shared-directory command channel (AutoX bridge)"
  if [ -d "$SHARED" ]; then
    : > "$SHARED/cmd.json" 2>/dev/null && note "   ✔ cmd.json cleared"
    echo '{"ok":false,"error":"emergency stop engaged"}' > "$SHARED/res.json" 2>/dev/null
  fi

  note "④ ending waiting/looping processes on my side"
  KILLED=0
  for pat in "auto-look.sh" "droid-hub" "dsh-control" "dsh-eval" "watch-look.sh" "relaunch-watch.sh"; do
    for pid in $(ps -ef 2>/dev/null | grep "[${pat:0:1}]${pat:1}" | awk '{print $2}'); do
      kill "$pid" 2>/dev/null && KILLED=$((KILLED+1))
    done
  done
  note "   ✔ ended $KILLED related processes"

  note "⑤ opening the accessibility settings page"
  if [ "${PANIC_NO_UI:-0}" = "1" ]; then
    note "   · skipped (PANIC_NO_UI=1, self-test only)"
  else
    am start -a android.settings.ACCESSIBILITY_SETTINGS >/dev/null 2>&1 && note "   ✔ opened (verify that 「DSH 桥」 is off)"
  fi

  cat <<'TIP'

──────────────────────────────────────────────
 Emergency stop engaged. Every AI control channel to this phone is cut:
   · port 127.0.0.1:8788 closed
   · the DSH bridge accessibility service shut itself down
   · token revoked
   · shared-directory command channel cleared

 If the phone is still moving on its own, go through these in order:
   A. hold volume + and volume − together for 3 seconds (built-in rescue gesture in the App)
   B. the notification 「DSH 桥正在运行」 → emergency stop
   C. reboot the phone (this App does not autostart, so the automation resets to zero)
   D. Safe mode: long-press power → long-press 「关机」 → choose safe mode
      (all third-party Apps are disabled and you fully regain control)
   E. last resort: uninstall the suspicious App / factory reset (run widget 3_backup-dsh first)
──────────────────────────────────────────────
TIP
} 2>&1 | tee -a "$LOG"
