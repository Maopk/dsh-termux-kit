#!/data/data/com.termux/files/usr/bin/bash
# droid —— drive the whole Android phone over ADB (wireless debugging): screen, tap, swipe, type, install, read the UI tree
# Needs wireless debugging paired and connected (droid conn). Works without root, since it goes through adb shell (shell user rights).
#
# Usage: 
#   droid conn [pair PORT CODE | PORT]   connect/reconnect (with no args, uses the port recorded in ~/.droid.conf)
#   droid devices                        currently connected devices
#   droid shot [output path]                full screen → default Download/dsh/图片/droid-<timestamp>.png
#   droid tap X Y                        tap
#   droid swipe X1 Y1 X2 Y2 [ms]       swipe (default 300ms)
#   droid text 'text to type'            type text (auto-escaped)
#   droid key KEYCODE_BACK|HOME|ENTER|...send a keyevent
#   droid ui [keyword]                    export the UI tree (xml), optionally filtering elements and coordinates by keyword
#   droid find 'text' [--tap]            find elements containing that text in the UI tree (optionally tap it)
#   droid apps [keyword]                  list third-party app package names
#   droid install <apk path>              install/reinstall an APK (no need to tap the install dialog)
#   droid start <package|package/Activity>     launch an app
#   droid cur                            current foreground app
#   droid shell '<command>'                 run adb shell directly
set -u
CONF="$HOME/.droid.conf"
# With several devices or stale offline entries, it locks onto the only device in state device
pick_serial() {
  local s
  s=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1; exit}')
  [ -n "$s" ] && export DROID_SERIAL="$s"
}
pick_serial
IMG_DIR="$HOME/storage/downloads/dsh/图片"
mkdir -p "$IMG_DIR" 2>/dev/null
[ -f "$CONF" ] && . "$CONF"          # provides DROID_PORT / DROID_PAIR_PORT / DROID_PAIR_CODE

save_conf() {
  { echo "DROID_PORT=${DROID_PORT:-}"
    echo "DROID_PAIR_PORT=${DROID_PAIR_PORT:-}"
    echo "DROID_PAIR_CODE=${DROID_PAIR_CODE:-}"; } > "$CONF"
  chmod 600 "$CONF"
}

need_device() {
  local n
  n=$(adb devices | awk 'NR>1 && $2=="device"' | wc -l)
  if [ "$n" -eq 0 ]; then
    echo "❌ no connected device. Run first: droid conn <port> (or droid conn pair <port> <code>)" >&2
    return 1
  fi
  return 0
}

cmd_conn() {
  local mode="${1:-auto}"
  if [ "$mode" = "pair" ]; then
    DROID_PAIR_PORT="${2:?pairing port}"; DROID_PAIR_CODE="${3:?pairing code}"
    echo "→ adb pair 127.0.0.1:$DROID_PAIR_PORT (code $DROID_PAIR_CODE)"
    adb pair "127.0.0.1:$DROID_PAIR_PORT" "$DROID_PAIR_CODE" 2>&1 | tail -3
    save_conf
    echo "Note: after pairing you still need to connect the port (the 『IP 地址和端口』 entry on the wireless debugging screen) → droid conn <port>"
    return 0
  fi
  [ -n "${1:-}" ] && { DROID_PORT="$1"; save_conf; }
  [ -z "${DROID_PORT:-}" ] && { echo "❌ no connect port on record. Usage: droid conn <port>" >&2; return 2; }
  adb connect "127.0.0.1:$DROID_PORT" 2>&1 | tail -2
  sleep 1
  adb devices | tail -n +2
  need_device
}

# With no adb device it degrades in order: ① the self-built 「DSH 桥」 App (loopback socket, preferred) ② the AutoX.js bridge (shared directory)
if [ $# -gt 0 ]; then
  case "$1" in
    conn|devices|discover|scan|help) ;;
    *)
      if ! adb devices 2>/dev/null | awk 'NR>1 && $2=="device"' | grep -q .; then
        if [ -x "$HOME/.local/bin/droid-sock" ] && timeout 4 "$HOME/.local/bin/droid-sock" cur >/dev/null 2>&1; then
          exec "$HOME/.local/bin/droid-sock" "$@"
        fi
        if [ -x "$HOME/.local/bin/droid-hub" ]; then
          exec "$HOME/.local/bin/droid-hub" "$@"
        fi
      fi ;;
  esac
fi

pick_serial
case "${1:-help}" in
  conn)    shift; cmd_conn "$@" ;;
  devices) adb devices -l ;;
  shot)
    OUT="${2:-$IMG_DIR/droid-$(date +%Y%m%d-%H%M%S).png}"
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} exec-out screencap -p > "$OUT" 2>/dev/null
    if [ -s "$OUT" ]; then echo "screenshot saved: $OUT ($(wc -c < "$OUT") bytes)"; else echo "❌ screenshot failed" >&2; exit 1; fi ;;
  tap)
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell input tap "${2:?X}" "${3:?Y}" && echo "tapped (${2},${3})" ;;
  swipe)
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell input swipe "${2:?x1}" "${3:?y1}" "${4:?x2}" "${5:?y2}" "${6:-300}" && echo "swiped" ;;
  text)
    need_device || exit 1
    S="${2:-}"
    E=$(printf '%s' "$S" | sed "s/ /%s/g; s/'/\\\\'/g")
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell input text "$E" && echo "typed: $S" ;;
  key)
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell input keyevent "${2:?KEYCODE}" && echo "sent ${2}" ;;
  ui)
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell uiautomator dump /sdcard/droid-ui.xml >/dev/null 2>&1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} exec-out cat /sdcard/droid-ui.xml > "$HOME/.droid-ui.xml" 2>/dev/null
    [ -s "$HOME/.droid-ui.xml" ] || { echo "❌ UI tree export failed" >&2; exit 1; }
    if [ -n "${2:-}" ]; then
      python3 - "$HOME/.droid-ui.xml" "$2" <<'PY'
import re, sys, xml.etree.ElementTree as ET
path, kw = sys.argv[1], sys.argv[2]
root = ET.parse(path).getroot()
hits = 0
for n in root.iter('node'):
    blob = ' '.join(filter(None, [n.get('text'), n.get('content-desc'), n.get('resource-id'), n.get('class')]))
    if kw.lower() in blob.lower():
        b = n.get('bounds') or ''
        m = re.match(r'\[(\d+),(\d+)\]\[(\d+),(\d+)\]', b)
        cx = cy = '?'
        if m:
            x1, y1, x2, y2 = map(int, m.groups()); cx, cy = (x1 + x2) // 2, (y1 + y2) // 2
        print(f"  [{cx},{cy}] {n.get('class','').split('.')[-1]:<14} text={n.get('text','')[:40]!r} desc={n.get('content-desc','')[:30]!r} id={n.get('resource-id','')[-28:]}")
        hits += 1
        if hits >= 25: break
print(f'{hits} matches (the coordinates are the tap center)')
PY
    else
      echo "UI tree saved: $HOME/.droid-ui.xml ($(wc -c < "$HOME/.droid-ui.xml") bytes)"; fi ;;
  find)
    need_device || exit 1
    KW="${2:?keyword}"; shift 2 || true
    TAP=""
    for a in "$@"; do [ "$a" = "--tap" ] && TAP=1; done
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell uiautomator dump /sdcard/droid-ui.xml >/dev/null 2>&1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} exec-out cat /sdcard/droid-ui.xml > "$HOME/.droid-ui.xml" 2>/dev/null
    COORD=$(python3 - "$HOME/.droid-ui.xml" "$KW" <<'PY'
import re, sys, xml.etree.ElementTree as ET
path, kw = sys.argv[1], sys.argv[2]
try: root = ET.parse(path).getroot()
except Exception: sys.exit(1)
for n in root.iter('node'):
    blob = ' '.join(filter(None, [n.get('text'), n.get('content-desc')]))
    if kw.lower() in blob.lower():
        m = re.match(r'\[(\d+),(\d+)\]\[(\d+),(\d+)\]', n.get('bounds') or '')
        if m:
            x1, y1, x2, y2 = map(int, m.groups())
            print(f"{(x1+x2)//2} {(y1+y2)//2} {n.get('text','')[:30]}"); break
PY
)
    if [ -z "$COORD" ]; then echo "no element containing $KW"; exit 1; fi
    echo "found: $COORD"
    if [ -n "$TAP" ]; then set -- $COORD; adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell input tap "$1" "$2" && echo "tapped ($1,$2)"; fi ;;
  apps)
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell pm list packages -3 | sed 's/package://' | { [ -n "${2:-}" ] && grep -i "$2" || cat; } ;;
  install)
    need_device || exit 1
    APK="${2:?apk path}"
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} install -r -d "$APK" 2>&1 | tail -4 ;;
  start)
    need_device || exit 1
    T="${2:?package}"
    case "$T" in
      */*) adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell am start -n "$T" 2>&1 | tail -3 ;;
      *)   adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell monkey -p "$T" -c android.intent.category.LAUNCHER 1 2>&1 | tail -3 ;;
    esac ;;
  cur)
    need_device || exit 1
    adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell dumpsys window 2>/dev/null | grep -m1 mCurrentFocus || adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell dumpsys activity activities 2>/dev/null | grep -m1 ResumedActivity ;;
  shell)
    need_device || exit 1
    shift; adb ${DROID_SERIAL:+-s $DROID_SERIAL} shell "$@" ;;
  discover)
    # mDNS auto-discovery of the wireless debugging port (wireless debugging must be on)
    python3 - <<'PY'
import socket, time
try:
    from zeroconf import Zeroconf, ServiceBrowser, ServiceListener
except Exception:
    print('zeroconf unavailable: pip install zeroconf'); raise SystemExit(1)
found = {}
class L(ServiceListener):
    def add_service(self, zc, type_, name):
        info = zc.get_service_info(type_, name, timeout=2500)
        if info:
            found[name] = (type_.split('.')[0], info.port, [socket.inet_ntoa(a) for a in info.addresses])
    def update_service(self, *a): pass
    def remove_service(self, *a): pass
zc = Zeroconf(); ServiceBrowser(zc, ['_adb-tls-pairing._tcp.local.', '_adb-tls-connect._tcp.local.'], L())
time.sleep(7); zc.close()
for n, (t, port, addrs) in found.items():
    print(f'  {t:<21} port={port} addr={addrs}')
print(f'found {len(found)} (pairing=pairing port, connect=connect port)')
PY
    ;;
  scan)
    # fallback: scan local listening ports 30000-50000 and fingerprint which one is adb
    python3 - <<'PY'
import socket, concurrent.futures
open_ports = []
def probe(p):
    s = socket.socket(); s.settimeout(0.2)
    try:
        return p if s.connect_ex(('127.0.0.1', p)) == 0 else None
    finally:
        s.close()
with concurrent.futures.ThreadPoolExecutor(max_workers=400) as ex:
    for r in ex.map(probe, range(30000, 50001)):
        if r: open_ports.append(r)
print('listening ports:', open_ports or '(none)')
hello = b'CNXN\x00\x00\x00\x01\x00\x10\x00\x00\x07\x00\x00\x00\x32\x02\x00\x00\xbc\xb1\xa7\xb1host::\x00'
for p in open_ports:
    s = socket.socket(); s.settimeout(1.2)
    try:
        s.connect(('127.0.0.1', p)); s.sendall(hello); data = s.recv(24)
        kind = data[:4].decode('latin1', 'replace')
        tag = 'ADB (connect port)' if kind in ('CNXN', 'AUTH', 'STLS') else ('TLS (pairing port)' if data[:1] == b'\x16' else 'other')
        print(f'  {p}: {tag} {data[:8]!r}')
    except Exception as e:
        print(f'  {p}: no response ({e.__class__.__name__})')
    finally:
        s.close()
PY
    ;;
  help|*)
    sed -n '2,26p' "$0" ;;
esac
