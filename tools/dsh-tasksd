#!/data/data/com.termux/files/usr/bin/python3
"""dsh-tasksd —— task runner for the web UI (loopback only, whitelist, token required).

Why: the DSH UI on the phone wants "one-click run" buttons for components, but a web page cannot run shell directly.
This starts a small service bound to 127.0.0.1 only, accepting **the 9 whitelisted component scripts**,
and requires a token on each request (the token lives in a 600 file that the page reads through filepanel readText).

Security boundary (stated honestly):
  · binds 127.0.0.1 only — the LAN and the outside cannot reach it;
  · CORS allows any loopback origin (the DSH port is chosen at startup, so it is never pinned);
  · a correct token is required — another App on the phone may reach loopback, but without the token it cannot execute anything;
  · only whitelisted script names can run, **no arbitrary commands and no arguments** (only an added --dry-run);
  · no credentials are stored; the token is generated outside.

Usage: 
  dsh-tasksd                 # run in the foreground
  dsh-tasksd --check         # self-check: is the token there, can the port be bound
End to end:
  curl -s 'http://127.0.0.1:8787/status?token=XXX'
  curl -s 'http://127.0.0.1:8787/run?token=XXX&task=3_backup-dsh'
  curl -s 'http://127.0.0.1:8787/auth?token=XXX'                 # password usage right: reports status only
  curl -s -X POST -H 'content-type: application/json' -d '{"token":"XXX"}' \
       'http://127.0.0.1:8787/auth/revoke'                        # revoke (deletes the 600 file)
"""
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

HOME = os.path.expanduser('~')
TASK_DIR = os.path.join(HOME, '.shortcuts', 'tasks')
TOKEN_FILE = os.path.join(HOME, '.dsh-tasks-token')
LOG = os.path.join(HOME, '.smoke', 'tasksd.log')
PORT = 8787
# Which page origins may call us. This used to be a hard-coded
# {'http://127.0.0.1:8080', 'http://localhost:8080'} — and when DSH came up on 8099 instead, the
# browser blocked every request and the panel showed only "读状态失败：Failed to fetch"
# (measured 2026-09-27). The port is not ours to pin down: DSH picks it at startup and the
# sandbox instance uses a different one. Any **loopback** origin is accepted instead; a page
# served from a real hostname still fails the check even if it resolves to 127.0.0.1
# (DNS rebinding), and the token remains the actual authorisation.
LOOPBACK_HOSTS = {'127.0.0.1', 'localhost', '::1', '[::1]'}


def origin_ok(origin):
    if not origin:
        return False
    try:
        u = urlparse(origin)
    except Exception:
        return False
    return u.scheme == 'http' and u.hostname in LOOPBACK_HOSTS



# Whitelist: only these script names; everything else is refused (no paths, no arbitrary commands)
ALLOWED = {
    '0_emergency-stop', '10_net-fix', '1_start-dsh', '2_shutdown-dsh', '3_backup-dsh', '4_soft-restart-dsh',
    '5_cleanup-dsh', '6_hard-restart-dsh', '7_reconnect-ai', '8_enable-wireless-adb',
    '9_revoke-pin',
}
# Virtual tasks: not scripts in .shortcuts/tasks but a command with an **absolute path** (same id set as the console App).
# The bridge (accessibility loopback) and adb (wireless debugging) are two independent channels → separate in the UI, and separate here.
VIRTUAL = {
    'bridge_wake':   [os.path.join(HOME, '.local/bin/dsh-bridge'), 'wake'],
    'bridge_status': [os.path.join(HOME, '.local/bin/dsh-bridge'), 'status'],
}
AUTH_HELPER = os.path.join(HOME, '.local/bin/dsh-auth-pass')
# These change the running state (they drop the current session), so the frontend must confirm first
DANGEROUS = {'2_shutdown-dsh', '4_soft-restart-dsh', '6_hard-restart-dsh', '0_emergency-stop'}


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, 'a', encoding='utf-8') as f:
            f.write('%s %s\n' % (time.strftime('%F %T'), msg))
    except Exception:
        pass


def ensure_token():
    if not os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE, 'w', encoding='utf-8') as f:
            f.write(secrets.token_hex(16))
        os.chmod(TOKEN_FILE, 0o600)
    return open(TOKEN_FILE, encoding='utf-8').read().strip()


def token_ok(given):
    try:
        real = open(TOKEN_FILE, encoding='utf-8').read().strip()
    except Exception:
        return False
    return bool(real) and bool(given) and secrets.compare_digest(real, given)


def port_open(p, host='127.0.0.1', timeout=1.5):
    s = socket.socket()
    s.settimeout(timeout)
    try:
        s.connect((host, int(p)))
        return True
    except Exception:
        return False
    finally:
        try:
            s.close()
        except Exception:
            pass


sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import dsh_common  # noqa: E402   (never guess the DSH port — see tools/dsh_common.py)


def status():
    st = {}
    # DSH Web
    _dsh_port = dsh_common.dsh_port()
    st['dsh'] = {'port': port_open(_dsh_port)}
    try:
        out = subprocess.run(['curl', '-s', '-o', '/dev/null', '-w', '%{http_code}',
                              '--max-time', '4', 'http://127.0.0.1:%d/' % _dsh_port],
                             capture_output=True, text=True, timeout=8).stdout.strip()
        st['dsh']['http'] = out
    except Exception:
        st['dsh']['http'] = '?'
    # bridge
    st['bridge'] = {'port': port_open(8788)}
    try:
        # --fast: one connection, return at once when the bridge is stopped or frozen.
        # ⚠ Without it, droid-sock runs its wake ladder, whose **second stage launches the
        #   Bridge's MainActivity** (am start -n io.dsh.bridge/.MainActivity) — so merely
        #   reading the status yanked the Bridge app to the foreground. The user sees exactly
        #   that as "opening DSH jumps me into the Bridge, twice" (measured 2026-09-27: one
        #   jump per failing read, and both the panel and the console read on open).
        #   Reading status must never take over the screen; waking the bridge is an explicit
        #   action (the "Wake bridge" task), not a side effect of a lamp refresh.
        r = subprocess.run([os.path.join(HOME, '.local/bin/droid-sock'), 'ping', '--fast'],
                           capture_output=True, text=True, timeout=12).stdout
        m = re.search(r'"ver":\s*"([^"]+)"', r)
        st['bridge']['ver'] = m.group(1) if m else None
        st['bridge']['ok'] = '"pong": true' in r
    except Exception:
        st['bridge']['ok'] = False
    # adb
    try:
        out = subprocess.run(['adb', 'devices'], capture_output=True, text=True, timeout=10).stdout
        devs = [l.split('\t')[0] for l in out.splitlines()[1:] if '\tdevice' in l]
        st['adb'] = {'devices': devs}
    except Exception:
        st['adb'] = {'devices': []}
    # the last result in the component log (to show "did the last run succeed")
    st['tasks'] = {}
    for name in sorted(ALLOWED):
        p = os.path.join(HOME, '.smoke', 'widget-%s.log' % name)
        if os.path.exists(p):
            try:
                tail = subprocess.run(['tail', '-c', '400', p], capture_output=True,
                                      text=True, timeout=5).stdout
                m = _TERM = re.compile(r'(?:\[(?P<n1>[^\]]{1,60})\]\s*(?P<s1>done|failed|skipped|not executed)\b|【(?P<n2>[^】]{1,60})】\s*(?P<s2>完成|失败|未执行))')
                _NORM = {'完成': 'done', '失败': 'failed', '未执行': 'skipped', 'not executed': 'skipped'}
                res = [_NORM.get(m.group('s2') or m.group('s1'), m.group('s1')) for m in _TERM.finditer(tail)]
                t = re.findall(r'^===== ([\d\-]+ [\d:]+)', tail, re.M)
                st['tasks'][name] = {'last': m[-1] if m else None,
                                     'at': t[-1] if t else None}
            except Exception:
                pass
    return st


def run_task(name, dry):
    if name in VIRTUAL:
        cmd = list(VIRTUAL[name]) + (['--dry-run'] if dry else [])
    elif name in ALLOWED:
        script = os.path.join(TASK_DIR, name + '.sh')
        if not os.path.isfile(script):
            return 404, {'ok': False, 'error': 'script does not exist: %s' % name}
        cmd = ['bash', script] + (['--dry-run'] if dry else [])
    else:
        return 400, {'ok': False, 'error': 'not in the whitelist: %s' % name}
    log('run %s dry=%s' % (name, dry))
    t0 = time.time()
    try:
        # Detach with setsid: when running close/restart components this service must not be taken down with them
        p = subprocess.run(['setsid'] + cmd, capture_output=True, text=True, timeout=300,
                           cwd=HOME, env={**os.environ, 'DSH_WIDGET_LOG': '1'})
        out = (p.stdout or '') + (p.stderr or '')
    except subprocess.TimeoutExpired:
        out, p = '(timeout 300s)', None
    dur = round(time.time() - t0, 1)
    tail = '\n'.join(out.strip().splitlines()[-40:])
    log('done %s rc=%s %.1fs' % (name, getattr(p, 'returncode', '?'), dur))
    return 200, {'ok': True, 'task': name, 'dry': dry, 'seconds': dur,
                 'exit': getattr(p, 'returncode', None), 'output': tail}


def auth_status():
    """Report only whether authorization exists (helper status never echoes the password)."""
    try:
        p = subprocess.run([AUTH_HELPER, 'status'], capture_output=True, text=True, timeout=15)
        return {'authorized': p.returncode == 0, 'detail': (p.stdout or p.stderr).strip()}
    except Exception as e:
        return {'authorized': False, 'detail': 'cannot read the authorization state: %s' % e}


def auth_revoke():
    try:
        p = subprocess.run([AUTH_HELPER, 'revoke'], capture_output=True, text=True, timeout=30)
        log('auth revoke rc=%s' % p.returncode)
        return 200, {'ok': True, 'exit': p.returncode,
                     'output': ((p.stdout or '') + (p.stderr or '')).strip()}
    except Exception as e:
        return 500, {'ok': False, 'error': 'revoke failed: %s' % e}


def auth_set(digits):
    """Write the 6 digits. **Note: no logging, no echo, no field in any response.**"""
    if not re.fullmatch(r'[0-9]{6}', digits or ''):
        return 400, {'ok': False, 'error': 'only 6 digits are accepted'}
    try:
        p = subprocess.run([AUTH_HELPER, 'set'], input=digits, capture_output=True, text=True, timeout=30)
        log('auth set rc=%s (the value never enters the log)' % p.returncode)   # ← this is the only line, and it holds no value
        return 200, {'ok': p.returncode == 0, 'exit': p.returncode,
                     'output': ((p.stdout or '') + (p.stderr or '')).strip()}
    except Exception as e:
        return 500, {'ok': False, 'error': 'write failed: %s' % e}


class H(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, *a):
        pass

    def _cors(self):
        origin = self.headers.get('Origin', '')
        if origin_ok(origin):
            self.send_header('Access-Control-Allow-Origin', origin)
            self.send_header('Access-Control-Allow-Headers', 'content-type')
            self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
            self.send_header('Vary', 'Origin')

    def _json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode('utf-8')
        self.send_response(code)
        self.send_header('content-type', 'application/json; charset=utf-8')
        self.send_header('cache-control', 'no-store')
        self.send_header('content-length', str(len(body)))
        self._cors()
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.send_header('content-length', '0')
        self.end_headers()

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        tok = (q.get('token') or [self.headers.get('x-dsh-token', '')])[0]
        if not token_ok(tok):
            return self._json(401, {'ok': False, 'error': 'token is wrong or missing'})
        if u.path == '/status':
            return self._json(200, {'ok': True, 'status': status()})
        if u.path == '/tasks':
            return self._json(200, {'ok': True, 'allowed': sorted(ALLOWED) + sorted(VIRTUAL),
                                    'dangerous': sorted(DANGEROUS)})
        if u.path == '/auth':
            a = auth_status()
            return self._json(200, {'ok': True, 'auth': a})
        if u.path == '/run':
            name = (q.get('task') or [''])[0]
            dry = (q.get('dry') or ['0'])[0] in ('1', 'true', 'yes')
            code, obj = run_task(name, dry)
            return self._json(code, obj)
        return self._json(404, {'ok': False, 'error': 'unknown path'})

    def do_POST(self):
        n = int(self.headers.get('content-length') or 0)
        if n > 65536:
            return self._json(413, {'ok': False, 'error': 'body too large'})
        raw = self.rfile.read(n) if n else b'{}'
        try:
            body = json.loads(raw.decode('utf-8') or '{}')
        except Exception:
            return self._json(400, {'ok': False, 'error': 'body is not JSON'})
        if not token_ok(body.get('token') or self.headers.get('x-dsh-token', '')):
            return self._json(401, {'ok': False, 'error': 'token is wrong or missing'})
        path = urlparse(self.path).path
        if path == '/run':
            code, obj = run_task(body.get('task', ''), bool(body.get('dry')))
            return self._json(code, obj)
        if path == '/auth/revoke':
            code, obj = auth_revoke()
            return self._json(code, obj)
        if path == '/auth/set':
            code, obj = auth_set((body.get('pass') or '').strip())
            return self._json(code, obj)
        return self._json(404, {'ok': False, 'error': 'unknown path'})


def main():
    if '--check' in sys.argv:
        t = ensure_token()
        print('token file: %s (%s…)' % (TOKEN_FILE, t[:6]))
        try:
            s = socket.socket()
            s.bind(('127.0.0.1', PORT))
            s.close()
            print('port %d can be bound ✔' % PORT)
        except Exception as e:
            print('port %d failed to bind: %s' % (PORT, e))
        print('%d whitelisted components ✔' % len(ALLOWED))
        return 0
    ensure_token()
    srv = ThreadingHTTPServer(('127.0.0.1', PORT), H)
    log('tasksd started, listening on 127.0.0.1:%d' % PORT)
    print('dsh-tasksd listening on 127.0.0.1:%d (token: %s)' % (PORT, TOKEN_FILE))
    srv.serve_forever()


if __name__ == '__main__':
    sys.exit(main())
