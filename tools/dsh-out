#!/data/data/com.termux/files/usr/bin/bash
# Copy artifacts into Download/dsh/<category>/ by extension (the one drop point for DSH output)
BASE="/data/data/com.termux/files/home/storage/downloads/dsh"
f="$1"
[ -f "$f" ] || { echo "Usage: dsh-out <file path>"; exit 1; }
ext="${f##*.}"; ext="$(echo "$ext" | tr 'A-Z' 'a-z')"
case "$ext" in
  md|txt|pdf|docx|doc|rtf)          c="文档" ;;
  xlsx|xls|csv|tsv|ods)             c="表格" ;;
  pptx|ppt|odp)                     c="演示" ;;
  sh|bash|py|js|mjs|cjs|ts)         c="脚本" ;;
  yaml|yml|json|toml|ini|conf)      c="配置" ;;
  zip|tar|gz|7z)                    c="归档" ;;
  png|jpg|jpeg|webp|svg|gif)        c="图片" ;;
  apk|apks|xapk|apkm|aab)           c="应用" ;;
  *)                                c="其他" ;;
esac
mkdir -p "$BASE/$c"
if [ "$(realpath "$f")" = "$(realpath "$BASE/$c/$(basename "$f")" 2>/dev/null)" ]; then
  echo "already there: Download/dsh/$c/$(basename "$f")"; exit 0
fi
cp -f "$f" "$BASE/$c/" && echo "delivered: Download/dsh/$c/$(basename "$f")"
