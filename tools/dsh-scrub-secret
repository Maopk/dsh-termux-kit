#!/data/data/com.termux/files/usr/bin/bash
# dsh-scrub-secret —— 把一个敏感值从**我这边的记忆/笔记/产物**里抹掉（不碰 DSH 会话存档，原因见下）
#
# 用法（值从 stdin 读，不进 shell 历史）：
#   printf '%s' '要清的值' | dsh-scrub-secret            # 默认只处理 ~/.dsh 下的记忆库
#   printf '%s' '要清的值' | dsh-scrub-secret --dry-run  # 只看会动哪些文件
#   printf '%s' '要清的值' | dsh-scrub-secret --all      # 连会话存档一起扫（慎用，见警告）
#
# ⚠ 为什么默认不碰 ~/.dsh/storages/session_projcache/**：那是 DSH 的**对话存档**。
#   当前会话只要还在用，它每轮都会被重新写回 → 在会话内改它等于白改（下一轮又回来）。
#   想彻底清：① 结束/删除这个会话（侧边栏里删掉它就等于删掉存档）；② 再跑一次本工具 --all。
set -u
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
MEM="$HOME_DIR/.dsh/.dsh-memory"
SESS="$HOME_DIR/.dsh/storages/session_projcache/sessions"
DRY=0; ALL=0
for a in "$@"; do case "$a" in --dry-run) DRY=1 ;; --all) ALL=1 ;; esac; done

VALUE=$(cat)
[ -n "$VALUE" ] || { printf '没读到要清理的值（stdin 为空）\n' >&2; exit 2; }

python3 - "$VALUE" "$MEM" "$SESS" "$DRY" "$ALL" <<'PYEOF'
import os, re, sys
value, mem, sess, dry, all_ = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == '1', sys.argv[5] == '1'
pat = re.compile(r'(?<![0-9])' + re.escape(value) + r'(?![0-9])')
PLACE = '«已清除»'
roots = [mem] + ([sess, os.path.join(os.path.dirname(sess), '..')] if all_ else [])
targets = []
for root in roots:
    root = os.path.abspath(root)
    if not os.path.isdir(root):
        continue
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in ('node_modules', '.git')]
        for fn in filenames:
            p = os.path.join(dirpath, fn)
            if os.path.getsize(p) > 40 * 1024 * 1024:
                continue
            try:
                with open(p, 'r', encoding='utf-8', errors='ignore') as f:
                    txt = f.read()
            except Exception:
                continue
            n = len(pat.findall(txt))
            if n:
                targets.append((p, n, txt))
print('命中 %d 个文件：' % len(targets))
total = 0
for p, n, txt in targets:
    print('  %s（%d 处）%s' % (p.replace(mem, '…/.dsh-memory').replace(sess, '…/sessions'), n, '  [dry-run 未改]' if dry else ''))
    total += n
    if not dry:
        with open(p, 'w', encoding='utf-8') as f:
            f.write(pat.sub(PLACE, txt))
print('共 %d 处' % total + ('（dry-run，未改动）' if dry else ' 已替换为 ' + PLACE))
if not all_:
    print('提示：未扫描会话存档。当前会话仍在写回 → 要在会话结束后再跑一次 --all 才彻底。')
PYEOF
