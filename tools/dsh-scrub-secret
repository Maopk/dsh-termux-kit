#!/data/data/com.termux/files/usr/bin/bash
# dsh-scrub-secret —— scrub a secret value from **my own memory, notes and artifacts** (DSH session archives are left alone; see below)
#
# Usage (the value comes from stdin, so it never enters shell history):
#   printf '%s' 'value to scrub' | dsh-scrub-secret            # by default only the memory store under ~/.dsh is processed
#   printf '%s' 'value to scrub' | dsh-scrub-secret --dry-run  # only show which files would change
#   printf '%s' 'value to scrub' | dsh-scrub-secret --all      # also scan session archives (use with care; see the warning)
#
# ⚠ Why ~/.dsh/storages/session_projcache/** is skipped by default: that is the DSH **conversation archive**.
#   While the current session is in use it is rewritten every turn → editing it inside the session is pointless (it comes back next turn).
#   To scrub it completely: ① end/delete this session (removing it from the sidebar deletes the archive); ② run this tool with --all again.
set -u
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
MEM="$HOME_DIR/.dsh/.dsh-memory"
SESS="$HOME_DIR/.dsh/storages/session_projcache/sessions"
DRY=0; ALL=0
for a in "$@"; do case "$a" in --dry-run) DRY=1 ;; --all) ALL=1 ;; esac; done

VALUE=$(cat)
[ -n "$VALUE" ] || { printf 'no value to scrub was read (stdin is empty)\n' >&2; exit 2; }

python3 - "$VALUE" "$MEM" "$SESS" "$DRY" "$ALL" <<'PYEOF'
import os, re, sys
value, mem, sess, dry, all_ = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == '1', sys.argv[5] == '1'
pat = re.compile(r'(?<![0-9])' + re.escape(value) + r'(?![0-9])')
PLACE = '«已清除»'
roots = [mem] + ([sess, os.path.join(os.path.dirname(sess), '..')] if all_ else [])
targets = []
for root in roots:
    root = os.path.abspath(root)
    if not os.path.isdir(root):
        continue
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in ('node_modules', '.git')]
        for fn in filenames:
            p = os.path.join(dirpath, fn)
            if os.path.getsize(p) > 40 * 1024 * 1024:
                continue
            try:
                with open(p, 'r', encoding='utf-8', errors='ignore') as f:
                    txt = f.read()
            except Exception:
                continue
            n = len(pat.findall(txt))
            if n:
                targets.append((p, n, txt))
print('hit %d files:' % len(targets))
total = 0
for p, n, txt in targets:
    print('  %s (%d hits)%s' % (p.replace(mem, '…/.dsh-memory').replace(sess, '…/sessions'), n, '  [dry-run, unchanged]' if dry else ''))
    total += n
    if not dry:
        with open(p, 'w', encoding='utf-8') as f:
            f.write(pat.sub(PLACE, txt))
print('%d hits in total' % total + (' (dry-run, nothing changed)' if dry else ' replaced with ' + PLACE))
if not all_:
    print('Note: session archives were not scanned. The current session is still writing back → run --all again after the session ends for a complete scrub.')
PYEOF
