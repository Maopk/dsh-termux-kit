#!/data/data/com.termux/files/usr/bin/bash
# Automatic DSH state backup
#   · runs on every DSH exit (triggered by ~/.shortcuts/tasks/2_shutdown-dsh.sh)
#   · named by timestamp: dsh-state-YYYYMMDD-HHMMSS.tar.gz
#   · keeps the newest 5 only; older ones are deleted automatically
#   · Contents: ~/.dsh (minus node_modules/cache/old profiles backups/credential files), ~/.shortcuts,
#     ~/.plugin-src, the ops journal, a sanitized .bashrc, a plugin list snapshot
set -u

HOME_DIR="/data/data/com.termux/files/home"
DEST="${DSH_BACKUP_DEST:-$HOME_DIR/storage/downloads/dsh/备份}"
DOCS="$HOME_DIR/storage/downloads/dsh/文档"
# Retention policy (overridable by env var, for easy tuning/testing):
#   keep the last KEEP_DAYS days, plus a hard cap of MAX_FILES files to stop runaway growth
KEEP_DAYS="${DSH_BACKUP_KEEP_DAYS:-30}"
MAX_FILES="${DSH_BACKUP_MAX_FILES:-200}"
STAMP="$(date '+%Y%m%d-%H%M%S')"
NAME="dsh-state-${STAMP}.tar.gz"

mkdir -p "$DEST" "$DOCS"

# 1) plugin list snapshot (also refreshes an always-readable latest copy into 文档/)
LIST="$HOME_DIR/.dsh-plugin-list.tmp"
{
  echo "# DSH plugin list snapshot"
  echo "generated: $(date '+%Y-%m-%d %H:%M:%S')"
  echo
  echo "## installed plugins (profile: web)"
  (cd "$HOME_DIR/.dsh/profiles/web" && timeout 60 dsh plugin --profile web list --depth 0 2>&1) || echo "(fetch failed)"
  echo
  echo "## package.json"
  cat "$HOME_DIR/.dsh/profiles/web/package.json" 2>/dev/null
} > "$LIST" 2>&1
cp -f "$LIST" "$DOCS/插件清单.txt"

# 2) stage _meta (sanitized .bashrc + plugin list)
STAGE="$(mktemp -d)"
mkdir -p "$STAGE/_meta"
cp -f "$LIST" "$STAGE/_meta/插件清单.txt"
sed 's|^\(export DEEPSEEK_API_KEY=\).*|\1"<redacted: fill it in after restore>"|' "$HOME_DIR/.bashrc" > "$STAGE/_meta/bashrc.sanitized"

# 3) pack in one pass (two -C sources: HOME and the staging dir)
tar czf "$DEST/$NAME" \
  --exclude='node_modules' \
  --exclude='cache' \
  --exclude='profiles.bak-*' \
  --exclude='.credentials.yaml' \
  --exclude='*.tmp' \
  -C "$HOME_DIR" .dsh .shortcuts .plugin-src DSH运维笔记.md \
  -C "$STAGE" _meta 2>/dev/null
STATUS=$?
rm -rf "$STAGE"

SIZE="$(du -h "$DEST/$NAME" 2>/dev/null | cut -f1)"

# 4) retention: ① delete anything older than KEEP_DAYS days ② when over MAX_FILES, delete the oldest
DELETED=0
while IFS= read -r oldfile; do
  [ -n "$oldfile" ] || continue
  rm -f "$oldfile" && DELETED=$((DELETED + 1))
done < <(find "$DEST" -maxdepth 1 -name 'dsh-state-*.tar.gz' -mtime +"$KEEP_DAYS" 2>/dev/null)

COUNT=$(ls -1t "$DEST"/dsh-state-*.tar.gz 2>/dev/null | wc -l)
if [ "$COUNT" -gt "$MAX_FILES" ]; then
  for oldfile in $(ls -1t "$DEST"/dsh-state-*.tar.gz 2>/dev/null | tail -n +"$((MAX_FILES + 1))"); do
    rm -f "$oldfile" && DELETED=$((DELETED + 1))
  done
fi
KEPT=$(ls -1t "$DEST"/dsh-state-*.tar.gz 2>/dev/null | wc -l)
TOTAL_SIZE=$(du -sh "$DEST" 2>/dev/null | cut -f1)

# 5) write the log
{
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] backed up $NAME (${SIZE:-?}, status=$STATUS), removed $DELETED old backups, now $KEPT files / ${TOTAL_SIZE:-?} total (keeping ${KEEP_DAYS} days, cap ${MAX_FILES} files)"
} >> "$DEST/备份日志.txt"

rm -f "$LIST"
echo "backup done: $NAME ${SIZE:-}"
