#!/data/data/com.termux/files/usr/bin/bash
# install: runtime   （把 ~/dsh-console、~/droid-bridge 镜像进仓库 apps/）
# sync-apps —— 把真正被编译的两份 App 源码镜像进仓库 apps/（ui/controls.json 的说明里一直提到它，
# 但脚本本身此前并不存在，是手工 cp 的 —— 手工就会漂移，2026-09-27 这次就漂了：仓库里的
# UiControls.java / Lang.java 还是旧的，而手机装的是另一份）。
#
# 规则：真源码住 $HOME（build.sh 只认那里），仓库 apps/ 是**只读镜像**，方向永远是
#       $HOME → 仓库，绝不反向。ks.jks / build/ 不镜像（签名密钥与产物不进仓库）。
set -eu
ROOT="$HOME/dsh-termux-kit"
sync_one() {
  local name="$1" src="$2"
  [ -d "$src" ] || { echo "✘ 没有 $src"; return 1; }
  mkdir -p "$ROOT/apps/$name"
  for f in AndroidManifest.xml build.sh res src; do
    [ -e "$src/$f" ] || continue
    rm -rf "$ROOT/apps/$name/$f"
    cp -r "$src/$f" "$ROOT/apps/$name/$f"
  done
  echo "   ✔ apps/$name ← $src"
}
echo "把真源码镜像进仓库（$ROOT/apps/）："
sync_one console "$HOME/dsh-console"
sync_one bridge  "$HOME/droid-bridge"
echo "完成。核对：git -C $ROOT status --short apps/"
