<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH Bridge — a self-built minimal accessibility bridge app (all source readable, no third-party SDK)
  Only three permissions, each with a clear purpose:
    · INTERNET                 listens on 127.0.0.1:8788 only (local loopback); there is no second network touchpoint in the code
    · BIND_ACCESSIBILITY_SERVICE  required by the system for an accessibility service
    · POST_NOTIFICATIONS       the persistent "running + emergency stop" notification (safety visibility)
  None of: SMS / contacts / location / camera / microphone / app-list reading / overlay / install-packages permissions.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.dsh.bridge"
    android:versionCode="32"
    android:versionName="2.22">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Single purpose: read/write the wireless-debugging switch (Settings.Global.adb_wifi_enabled) and Wi-Fi state.
         It is a development-level permission that the user must grant explicitly with adb (pm grant); it is never automatic. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Foreground service: keeps the bridge process from being frozen by system/vendor battery savers (once frozen it cannot even receive the wake broadcast) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Normal-level, granted at install, no user prompt, no new data access: without it a background
         app may start an app that is not running, but **cannot bring an app that already has a task
         to the front**. Measured 2026-09-27 on V2463A with 2.18:
           · bridge start com.android.settings (no live task) → came to the front ✅
           · bridge start com.android.chrome / clash.meta (live background task) → accepted, no window ⚠
           · am start (shell identity) for those very same packages → both came to the front ✅
         That split is exactly the task-reorder restriction. This permission does not widen what the
         bridge can read; it only lets the `start` action actually raise the window it asked for. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Package visibility (Android 11+). Without this block **every** getLaunchIntentForPackage()
         returns null, so the `start` action answered "App not found" for every app — including Chrome
         and Clash, which obviously have launcher icons. Measured 2026-09-27:
           · bridge  `droid-sock start com.android.chrome`            → ❌ App not found
           · adb      am start -a MAIN -c LAUNCHER -p com.android.chrome → works (shell identity is
             not subject to package visibility)
         This block makes exactly the launcher-visible apps visible — deliberately NOT the broad
         QUERY_ALL_PACKAGES permission, which would expose the whole installed-app list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Dark theme, the SAME one the console declares (ui/theme.json → androidTheme; tools/i18n-audit
         checks that the two manifests agree). Why it matters: with no android:theme this app fell back
         to the platform LIGHT theme, so it had a white window and a light ActionBar showing the app
         label — which the user saw as "the console is dark, the bridge is a light app" plus a duplicate
         title ("DSH Bridge" in the bar, "DSH 桥 v2.21" underneath), reported 2026-09-27. -->
    <application
        android:label="DSH Bridge"
        android:allowBackup="false"
        android:debuggable="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:label="DSH Bridge"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BridgeService"
            android:label="DSH Bridge"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name=".BridgeForeground"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the accessibility bridge resident so vendor battery savers cannot freeze it and lose contact" />
        </service>

        <!-- Wake receiver: the Termux side can make the bridge listen again with a plain am broadcast (exported, because other apps must be able to send it).
             While the service is alive: any app may wake it, but the port still requires the token before commands can be issued.
             Once the service is shut down (sleep / panic / unbound by the system): the broadcast must carry the right token (extra named token)
             before it may write itself back into the system accessibility list; otherwise any app could pull up an accessibility service the user switched off. -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.dsh.bridge.WAKE" />
            </intent-filter>
        </receiver>

        <!-- Receiver for the notification's "emergency stop" button; not exported, only this app can send it -->
        <receiver
            android:name=".PanicReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.dsh.bridge.PANIC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
