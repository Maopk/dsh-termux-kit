<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH Console — a "remote control" for this Termux setup.
  Exactly **one** permission: com.termux.permission.RUN_COMMAND (defined by Termux so another app can ask it to run commands).
  None of: storage, network, accessibility, overlay, app-list reading, boot autostart.
  Status and execution both go through Termux's RUN_COMMAND channel, so no Termux private file is ever read.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.dsh.console"
    android:versionCode="33"
    android:versionName="1.20">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+ package visibility: without this declaration Termux is invisible (the Bridge app hit this bug) -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!-- Dark theme: the UI is dark anyway, so the dialogs (run confirmation / log) stay dark too;
         otherwise Android's default light dialog shows up as a jarring white block on a dark page -->
    <application
        android:label="DSH Console"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/DshTheme"
        android:allowBackup="false"
        android:debuggable="false">

        <activity
            android:name=".MainActivity"
            android:label="DSH Console"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: three status lamps + common task buttons -->
        <receiver
            android:name=".DshWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Receives the execution result sent back by Termux (triggered by a PendingIntent we create ourselves; not exported) -->
        <receiver
            android:name=".TaskResultReceiver"
            android:exported="false" />

        <!-- Widget button tap → RUN_COMMAND is sent from here (the widget itself cannot send a service intent) -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
