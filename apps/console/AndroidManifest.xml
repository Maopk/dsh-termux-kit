<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH 控制台 —— 给这套 Termux 环境配的"遥控器"。
  权限只有**一个**：com.termux.permission.RUN_COMMAND（由 Termux 定义，用来让别的 App 请它执行命令）。
  没有：存储访问、网络、无障碍、悬浮窗、读应用列表、后台自启。
  状态与执行全部走 Termux 的 RUN_COMMAND 通道，所以不需要读任何 Termux 的私有文件。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.dsh.console"
    android:versionCode="14"
    android:versionName="1.1">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+ 的包可见性：不声明就看不到 Termux（桥那个 App 就踩过这个坑） -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!-- 深色主题：界面本来就是深色，对话框（确认执行 / 日志）跟着一起深色，
         否则 Android 默认亮色对话框会在深色页面上突兀地白一块 -->
    <application
        android:label="DSH 控制台"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false"
        android:debuggable="false">

        <activity
            android:name=".MainActivity"
            android:label="DSH 控制台"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小部件：三灯 + 常用任务按钮 -->
        <receiver
            android:name=".DshWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 接收 Termux 回传的执行结果（由我们自己创建的 PendingIntent 触发，不导出） -->
        <receiver
            android:name=".TaskResultReceiver"
            android:exported="false" />

        <!-- 小部件按钮点击 → 在这里发 RUN_COMMAND（小部件本身不能直接发服务意图） -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
