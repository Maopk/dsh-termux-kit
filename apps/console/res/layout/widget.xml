<?xml version="1.0" encoding="utf-8"?>
<!-- id naming rule: w_lamp_* = status lamps, w_btn_* = buttons. They must **never repeat**,
     or RemoteViews' setOnClickPendingIntent attaches to the same-named lamp (that was the w_adb bug in v0.1~v0.3). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/dsh_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="DSH Console" android:textColor="@color/dsh_fg"
            android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_lamp_dsh" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="● DSH" android:textColor="@color/dsh_dim" android:textSize="12sp" android:paddingEnd="6dp" />
        <TextView android:id="@+id/w_lamp_bridge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="● Bridge" android:textColor="@color/dsh_dim" android:textSize="12sp" android:paddingEnd="6dp" />
        <TextView android:id="@+id/w_lamp_adb" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="● adb" android:textColor="@color/dsh_dim" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tap Refresh to read status" android:textColor="@color/dsh_dim" android:textSize="11sp"
        android:paddingTop="2dp" android:paddingBottom="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/w_btn_start" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Start" android:textSize="12sp" />
        <Button android:id="@+id/w_btn_adb" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Connect" android:textSize="12sp" />
        <Button android:id="@+id/w_btn_bridge" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Wake" android:textSize="12sp" />
        <Button android:id="@+id/w_btn_refresh" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Refresh" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
